{%- comment -%}
  Renders the edition badge derived from the product title.
  Expects titles in the format "<Game> Pinball Machine - <Edition Name>".
  The edition name is everything after the last " - ".
  Products with no " - " in the title render no badge.
  Usage: {% render 'fnop-edition-badge' %}
{%- endcomment -%}

{%- liquid
  assign _parts = product.title | split: ' - '
  assign _badge_text = ''
  if _parts.size > 1
    assign _badge_text = _parts | last | strip
  endif
-%}

{%- if _badge_text != blank -%}
<span class="fnop-edition-badge">{{ _badge_text }}</span>
<style>
  .fnop-edition-badge {
    display: inline-block;
    padding: 4px 12px;
    font-size: var(--font-size--xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-logo-red, #FF0000);
    color: #fff;
    border-radius: 4px;
    line-height: 1.4;
  }
</style>
{%- endif -%}
