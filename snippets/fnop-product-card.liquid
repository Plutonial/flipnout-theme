{%- comment -%}
  Shared product card — used by game-editions-grid and brand-subcollections.

  Arguments:
    product_card_product  — the product object (required)
    product_card_title    — display title (caller decides: edition-only vs full title)
    product_card_link     — whether the title is rendered as a link (true/false)
    product_card_badge    — optional badge text (e.g. edition tier)
{%- endcomment -%}

{%- liquid
  assign pc_product = product_card_product
  assign pc_title   = product_card_title | default: pc_product.title
  assign pc_link    = product_card_link | default: false
  assign pc_badge   = product_card_badge | default: blank

  assign pc_image = pc_product.metafields.custom.backglass
  unless pc_image
    assign pc_image = pc_product.featured_image
  endunless

  assign pc_sold_out = false
  if pc_product.tags contains 'sold-out'
    assign pc_sold_out = true
  endif
-%}

<div class="fnop-product-card">
  {%- if pc_image -%}
    <div class="fnop-product-card__art">
      {{ pc_image | image_url: width: 800 | image_tag:
        loading: 'lazy',
        class: 'fnop-product-card__img',
        sizes: '(min-width: 750px) 25vw, 100vw',
        widths: '400,600,800'
      }}
    </div>
  {%- endif -%}

  <div class="fnop-product-card__info">
    {%- if pc_badge != blank -%}
      <span class="fnop-product-card__badge">{{ pc_badge }}</span>
    {%- endif -%}
    {%- if pc_title != blank -%}
      <h3 class="fnop-product-card__title">
        {%- if pc_link -%}
          <a href="{{ pc_product.url }}" class="fnop-product-card__title-link">{{ pc_title }}</a>
        {%- else -%}
          {{ pc_title }}
        {%- endif -%}
      </h3>
    {%- endif -%}
    <span class="fnop-product-card__price">{{ pc_product.price | money }}</span>
    {%- if pc_sold_out -%}
      <span class="fnop-product-card__btn fnop-product-card__btn--sold-out" aria-disabled="true">Sold Out</span>
    {%- else -%}
      <a href="{{ pc_product.url }}" class="fnop-product-card__btn">Shop Now</a>
    {%- endif -%}
  </div>
</div>
