{% comment %}
  UIkit Component Layer — loads full JS + curated CSS subset (Slider + Lightbox only).
  The full UIkit CSS is deliberately NOT loaded because it isn't scope-gated and would
  override Horizon's global styles. Only component-specific CSS is included.
  
  Currently loaded on all product pages. V2 may scope further if needed.
{% endcomment %}

{% if template.name == 'product' %}
  {{ 'fnop-uikit-components.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'fnop-uikit.min.js' | asset_url }}" defer></script>
  <script src="{{ 'fnop-uikit-icons.min.js' | asset_url }}" defer></script>
  <script>
    {% comment %} Re-init UIkit components after Shopify editor section reload {% endcomment %}
    document.addEventListener('shopify:section:load', function() {
      if (window.UIkit) {
        UIkit.update();
      }
    });
  </script>
{% endif %}
