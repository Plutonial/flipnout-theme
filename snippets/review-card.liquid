{%- liquid
  assign r_id = 'review-' | append: block.id | default: section.id
  assign rating = block.settings.rating | default: 5
  assign text = block.settings.text | default: 'Excellent machine and flawless buying experience.'
  assign reviewer = block.settings.reviewer | default: 'Happy Buyer'
  assign machine = block.settings.machine | default: 'Stern Pinball Machine'
-%}

<article class="review-card" id="{{ r_id }}" {{ block.shopify_attributes }}>
  <div class="review-card__stars" aria-label="{{ rating }} out of 5 stars">
    {%- for i in (1..5) -%}
      <span class="review-card__star" aria-hidden="true">{% if i <= rating %}★{% else %}☆{% endif %}</span>
    {%- endfor -%}
  </div>
  <blockquote class="review-card__text">"{{ text }}"</blockquote>
  <p class="review-card__reviewer">— {{ reviewer }}</p>
  {%- if machine != blank -%}
    <p class="review-card__machine">{{ machine }}</p>
  {%- endif -%}
</article>

{% style %}
  .review-card {
    background: white;
    border-radius: 12px;
    padding: clamp(32px, 5vw, 64px);
    box-shadow: 0 8px 32px rgb(0 0 0 / 0.08);
    text-align: center;
    max-width: 700px;
    margin-inline: auto;
  }

  .review-card__stars {
    color: #F6C343;
    letter-spacing: 4px;
    margin-bottom: 20px;
    font-size: 20px;
  }

  .review-card__text {
    margin: 0 0 24px;
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.6;
    font-style: italic;
    max-width: 600px;
    margin-inline: auto;
    border: none;
    padding: 0;
  }

  .review-card__reviewer {
    margin: 0 0 4px;
    font-size: 15px;
    font-weight: 600;
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  .review-card__machine {
    margin: 0;
    font-size: 13px;
    color: rgb(var(--color-foreground-rgb) / 0.5);
  }
{% endstyle %}
