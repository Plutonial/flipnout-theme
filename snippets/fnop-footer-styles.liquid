{% comment %}
  Footer layout corrections (P28 fix-3).
  Rendered from layout/theme.liquid.

  1. base.css applies `summary { padding-block: var(--padding-sm) }` globally, which
     pushes the `menu` block headings ("Shop", "Explore") 11.2px lower than the
     `text` block headings ("Brands", "Join our email list"). On desktop the footer
     accordion is disabled (`data-disable-on-desktop`), so the summary needs no tap
     padding there and we remove it to put all four headings on one baseline.
     Mobile is untouched — the accordion tap target stays.

  2. The footer grid uses equal `1fr` tracks, so short columns leave large ragged
     gaps. `auto` tracks + `space-between` size each track to its content and spread
     the leftover space evenly between the columns.
{% endcomment %}

<style>
  /* Defect 1 (fix-4) + tablet: blocks/menu.liquid forces .menu { width: 100% }, which
     splits the two manufacturer sub-columns 50/50 and wraps "Chicago Gaming Company"
     (192.1px intrinsic). They need 192.1 + 16 + 167.7 = 375.8px and the column is
     375.8px at desktop / 393.9px at tablet, so both fit. Below 750px the row group
     flips to a column and must keep the upstream full-width behaviour. */
  @media screen and (min-width: 750px) {
    .footer-content .layout-panel-flex--row > .menu {
      width: auto;
    }
  }

  @media screen and (min-width: 990px) {
    .section > .footer-content {
      grid-template-columns: repeat(4, auto);
      justify-content: space-between;
    }

    /* fix-3: base.css puts padding-block on every <summary>, which drops the two
       menu-block headings 11.2px below the text-block headings. */
    .footer-content .menu__heading {
      padding-block: 0;
    }

    /* Centre the logo group horizontally in column 4.
       The logo group has width: fit, so it is narrower than the column and needs
       margin-inline: auto. The width-fit class comes from the group block's setting. */
    .footer-content > *:last-child > .group-block-content > .group-block--width-fit {
      margin-inline: auto;
    }

    /* Column 4 reads as one centred unit: the logo is already centred by the
       margin-inline: auto rule above, so centre the heading and paragraph to match.
       `> *:last-child` is column 4 only — columns 1-3 stay left-aligned.
       The email form already spans the full column width and needs nothing. */
    .footer-content > *:last-child .text-block,
    .footer-content > *:last-child .text-block > * {
      text-align: center;
    }
  }

  /* Defect 4: the integrated button inherits the primary-button radius (14px) inside a
     100px pill field. --border-radius on the button already carries the field's radius. */
  .footer-content .email-signup__button--integrated {
    border-radius: var(--border-radius);
  }

  /* Defects 5 + 6: centre the stacked footer and separate the form from the logo.
     Every declaration sets the real property, not the inline custom property. */
  @media screen and (max-width: 749px) {
    .footer-content {
      text-align: center;
    }

    .footer-content .text-block {
      text-align: center;
    }

    /* The theme re-applies the block's own alignment to the wrapper's children via
       `.text-block > * { text-align: var(--text-align) }`, so centring only the wrapper
       is not enough — inheritance loses to a rule that targets the child directly. */
    .footer-content .text-block > * {
      text-align: center;
    }

    .footer-content .layout-panel-flex--column {
      align-items: center;
    }

    .footer-content .layout-panel-flex--row {
      justify-content: center;
    }

    .footer-content .menu__heading {
      justify-content: center;
    }


    /* The form spans the full stacked column (629px at innerWidth 673), which is 1.7x
       the longest text line beside it. Cap it between the text line and the logo.
       On narrower phones the column is under 364px and the cap simply does not bind. */
    .footer-content .email-signup-block {
      max-width: var(--max-width--body-narrow);
      margin-inline: auto;
    }
  }

  /* Social icons: muted red glyphs on the footer fill; white on hover/focus. */
  .footer-content .social-icons__wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-xs);
    margin-block-start: var(--margin-xl);
  }

  .footer-content .social-icons__wrapper .social-icons__icon-wrapper {
    width: var(--minimum-touch-target);
    height: var(--minimum-touch-target);
  }

  .footer-content .social-icons__wrapper .social-icons__icon-wrapper a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: rgb(255 0 0 / 0.8);
    transition: color 0.18s ease;
  }

  .footer-content .social-icons__wrapper .social-icons__icon-wrapper a:hover,
  .footer-content .social-icons__wrapper .social-icons__icon-wrapper a:focus-visible {
    color: var(--color-foreground);
  }

  .footer-content .social-icons__icon {
    width: var(--icon-size-lg);
    height: var(--icon-size-lg);
  }

  /* SVG paths have no fill="currentColor" — force inheritance from the anchor's color. */
  .footer-content .social-icons__icon path {
    fill: currentColor;
  }

  /* Breathing room between the email form and the logo group.
     var(--margin-3xl) = 28px + the column's own 6px row-gap = 34px optical gap. */
  .footer-content > *:last-child > .group-block-content > .group-block {
    margin-block-start: var(--margin-3xl);
  }

  /* Centre the social row in column 4, matching the logo's margin-inline: auto. */
  .footer-content > *:last-child .social-icons__wrapper {
    margin-inline: auto;
  }
</style>
