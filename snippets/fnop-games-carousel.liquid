{%- comment -%}
  Shared games carousel — full-bleed, fit-vs-overflow, no labels.
  Used by game-you-may-also-like and brand-games-strip.

  Input:
    fnop_carousel_id      — unique section ID for CSS scoping
    fnop_carousel_heading — heading text (HTML-safe)
    fnop_carousel_heading_tag — 'h2' or 'h3' (default: 'h2')
    fnop_carousel_handles — pipe-delimited sorted game handles
{%- endcomment -%}

{%- liquid
  assign _handles = fnop_carousel_handles | split: '|'
  assign _count = _handles.size
-%}

{%- comment -%}
  L — Pre-rotate the handles so floor(n/2) is at DOM position 0.
  UIkit center:true centres index 0 on init — no show() needed,
  so the first paint is already the final position.
{%- endcomment -%}
{%- liquid
  assign _gc_start = _count | divided_by: 2
-%}

{%- if _count > 0 -%}
  <section id="{{ fnop_carousel_id }}" class="fnop-gc fnop-gc--carousel" data-gc-count="{{ _count }}">
    {%- liquid
      assign _heading_tag = fnop_carousel_heading_tag | default: 'h2'
    -%}
    <{{ _heading_tag }} class="fnop-gc__heading game-section-heading">{{ fnop_carousel_heading }}</{{ _heading_tag }}>

    <div class="fnop-gc__slider" uk-slider="finite: false; autoplay: false; center: true" data-gc-slider-opts="finite: false; autoplay: false; center: true">
      <div class="uk-position-relative">
        <div class="uk-slider-container fnop-gc__container">
          <ul class="uk-slider-items fnop-gc__list">
            {% comment %} Rotated: render [start..end] then [0..start-1] {% endcomment %}
            {%- for handle in _handles offset: _gc_start -%}
              {%- assign game_col = collections[handle] -%}
              {%- if game_col == blank -%}{%- continue -%}{%- endif -%}

              <li class="fnop-gc__item">
                {%- render 'fnop-game-card',
                  fnop_game_col: game_col,
                  fnop_card_class: 'fnop-gc__card',
                  fnop_img_class: 'fnop-gc__img',
                  fnop_hide_label: true
                -%}
              </li>
            {%- endfor -%}
            {%- if _gc_start > 0 -%}
              {%- for handle in _handles limit: _gc_start -%}
                {%- assign game_col = collections[handle] -%}
                {%- if game_col == blank -%}{%- continue -%}{%- endif -%}

                <li class="fnop-gc__item">
                  {%- render 'fnop-game-card',
                    fnop_game_col: game_col,
                    fnop_card_class: 'fnop-gc__card',
                    fnop_img_class: 'fnop-gc__img',
                    fnop_hide_label: true
                  -%}
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>

        <a class="fnop-gc__nav fnop-gc__nav--prev" href uk-slidenav-previous uk-slider-item="previous"></a>
        <a class="fnop-gc__nav fnop-gc__nav--next" href uk-slidenav-next uk-slider-item="next"></a>
      </div>
    </div>
  </section>

  <script>
    (function() {
      var sectionId = '{{ fnop_carousel_id }}';

      function updateMode() {
        try {
          var section = document.getElementById(sectionId);
          if (!section) return;

          var sliderEl = section.querySelector('.fnop-gc__slider');
          if (!sliderEl) return;

          var list = section.querySelector('.fnop-gc__list');
          if (!list) return;

          var items = list.querySelectorAll('.fnop-gc__item');
          if (!items.length) return;

          var item = items[0];
          var listStyle = getComputedStyle(list);
          var gapVal = parseFloat(listStyle.columnGap) || parseFloat(listStyle.gap) || 0;
          var itemW = item.offsetWidth + gapVal;
          if (!isFinite(itemW) || itemW <= 0) return;

          var setW = itemW * items.length;
          var containerW = section.querySelector('.fnop-gc__container').offsetWidth;
          var overflows = setW > containerW;

          /* Toggle mode class — JS only toggles state, never rebuilds markup */
          section.classList.toggle('fnop-gc--centred', !overflows);
          section.classList.toggle('fnop-gc--carousel', overflows);

          /* Hide/show arrows */
          section.querySelectorAll('.fnop-gc__nav').forEach(function(nav) {
            if (overflows) { nav.removeAttribute('hidden'); } else { nav.setAttribute('hidden', ''); }
          });

          /* In fits mode: remove uk-slider so no transform is applied.
             In overflow mode: restore it so the carousel works with center + loop. */
          var initSlider = function () {
            if (!window.UIkit) return false;

            if (overflows) {
              if (!sliderEl.hasAttribute('uk-slider')) {
                sliderEl.setAttribute('uk-slider', sliderEl.getAttribute('data-gc-slider-opts'));
                UIkit.slider(sliderEl, { finite: false, autoplay: false, center: true });
              }
              /* L: no show() — items are pre-rotated in Liquid so index 0
                 is already the centre card. Zero post-paint movement. */
            } else {
              var slider = UIkit.slider(sliderEl);
              if (slider) {
                slider.$destroy();
              }
              sliderEl.removeAttribute('uk-slider');
              /* Clear any leftover transform */
              list.style.transform = 'none';
            }
            return true;
          };

          /* Fix 2: if UIkit is not loaded yet, retry instead of silently skipping */
          if (!initSlider()) {
            var uikitRetries = 0;
            var waitForUIkit = setInterval(function () {
              uikitRetries++;
              if (initSlider() || uikitRetries >= 20) clearInterval(waitForUIkit);
            }, 150);
          }
        } catch (e) {
          /* Fail toward visible: leave server markup untouched */
        }
      }

      /* Run after layout */
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() { setTimeout(updateMode, 100); });
      } else {
        setTimeout(updateMode, 100);
      }

      /* Recompute on resize (debounced) */
      var resizeTimer;
      window.addEventListener('resize', function() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(updateMode, 200);
      });

      /* Theme editor support */
      document.addEventListener('shopify:section:load', function() { setTimeout(updateMode, 200); });
    })();
  </script>

  {% style %}
    #{{ fnop_carousel_id }} {
      --_gc-card-gap: 24px;
      --_gc-card-w: 280px;
      --_gc-arrow-size: calc(var(--font-size--4xl) * 1.6);
      --_gc-arrow-inset: clamp(8px, 2vw, 24px);

      padding: clamp(40px, 6vw, 80px) 0;
    }

    #{{ fnop_carousel_id }} .fnop-gc__heading {
      max-width: var(--page-content-width, 1200px);
      margin-inline: auto;
      padding-inline: var(--page-margin, 16px);
      margin-bottom: 32px;
    }

    #{{ fnop_carousel_id }} .fnop-gc__container {
      min-width: 0;
    }

    /* Fix 1 (L-fix-2): centre offset via transform on the track.
       fnop-gc is full-bleed so track width = 100vw. */
    #{{ fnop_carousel_id }} .fnop-gc__list {
      transform: translateX(calc((100vw - var(--_gc-card-w)) / 2));
      list-style: none;
      margin: 0;
      padding: 0;
      gap: var(--_gc-card-gap);
    }

    #{{ fnop_carousel_id }} .fnop-gc__item {
      width: var(--_gc-card-w);
      flex-shrink: 0;
    }

    #{{ fnop_carousel_id }} .fnop-gc__card {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    #{{ fnop_carousel_id }} .fnop-gc__img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      border-radius: var(--radius-sm, 8px);
    }

    /* Centred mode — static row, no slider behaviour, no arrows */
    #{{ fnop_carousel_id }}.fnop-gc--centred .fnop-gc__list {
      justify-content: center;
    }

    #{{ fnop_carousel_id }}.fnop-gc--centred .fnop-gc__nav {
      display: none;
    }

    /* Overlay arrows — translucent dark circle + white chevron (carousel mode) */
    #{{ fnop_carousel_id }} .fnop-gc__nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: center;
      width: var(--_gc-arrow-size);
      height: var(--_gc-arrow-size);
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.45);
      color: #fff;
      padding: 0;
      text-decoration: none;
    }

    #{{ fnop_carousel_id }} .fnop-gc__nav:hover {
      background: rgba(0, 0, 0, 0.65);
    }

    #{{ fnop_carousel_id }} .fnop-gc__nav svg {
      width: calc(var(--_gc-arrow-size) * 0.45);
      height: calc(var(--_gc-arrow-size) * 0.45);
      color: inherit;
    }

    #{{ fnop_carousel_id }} .fnop-gc__nav--prev {
      left: var(--_gc-arrow-inset);
    }

    #{{ fnop_carousel_id }} .fnop-gc__nav--next {
      right: var(--_gc-arrow-inset);
    }

    /* Mobile: larger cards, hide arrows (J-B) */
    @media (max-width: 749px) {
      #{{ fnop_carousel_id }} {
        --_gc-card-w: 60vw;
      }

      #{{ fnop_carousel_id }} .fnop-gc__nav {
        display: none;
      }
    }
  {% endstyle %}
{%- endif -%}
