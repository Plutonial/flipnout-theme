{%- comment -%}
  Episode article styles. Rendered once from layout/theme.liquid.
  Namespaced fnop-ap__* per §6.
{%- endcomment -%}

<style>
  /* ── Layout ── */
  .fnop-ap__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 32px;
  }

  @media (min-width: 900px) {
    .fnop-ap__layout {
      grid-template-columns: minmax(0, 1fr) 400px;
      column-gap: 72px;
    }

    .fnop-ap__layout--single {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ── Player — inside column 1 (P75 TASK 1) ── */
  .fnop-ap__player {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px;
    background: #000;
  }

  .fnop-ap__poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fnop-ap__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border: none;
    background: none;
    padding: 0;
    cursor: pointer;
    z-index: 1;
  }

  .fnop-ap__play:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
    border-radius: 4px;
  }

  .fnop-ap__play-icon {
    display: block;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.4));
    transition: transform 0.2s ease;
  }

  .fnop-ap__play:hover .fnop-ap__play-icon {
    transform: scale(1.1);
  }

  .fnop-ap__player iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ── H1 — 44px at desktop, fluid below (P74 TASK 5).
     No token at 44; 5xl = 48 is too big, 4xl = 40 collides with body h2. ── */
  .fnop-ap__title {
    font-size: clamp(32px, 5vw, 44px);
    line-height: 48px;
    margin-block-start: 48px;
    margin-block-end: 0;
    text-transform: uppercase;
  }

  /* ── Post meta ── */
  .fnop-ap__meta {
    margin-top: 8px;
  }

  /* P74 TASK 4 — date grows to body-copy scale */
  .fnop-ap__date {
    font-size: var(--font-size--xl);
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.81);
  }

  /* ── Top breathing room — matches Horizon's blog index (48px) ── */
  .fnop-ap__wrapper {
    padding-top: 48px;
    padding-block-end: 48px;
  }

  /* ── Article body RTE ── */
  .fnop-ap__main .blog-post-content {
    margin-top: 32px;
    margin-inline: 0;
    max-width: none;
  }

  /* ── Branded body subheads ──
     Visual match of .sab__heading (P22 TASK 3, Shop All). Replicated here
     to avoid coupling two sections. Reconcile if the source changes. */
  .fnop-ap__main .blog-post-content h2 {
    font-size: var(--font-size--4xl);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.4px;
    text-transform: uppercase;
    position: relative;
    padding-block-end: 12px;
    margin-block-start: 48px;
    margin-block-end: 12px;
  }

  .fnop-ap__main .blog-post-content h2::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 56px;
    height: 4px;
    background: rgba(255, 0, 0, 0.9);
  }

  .fnop-ap__main .blog-post-content h2:first-child {
    margin-block-start: 0;
  }

  .fnop-ap__main .blog-post-content p {
    font-size: var(--font-size--xl);
    line-height: 1.7;
    margin-block-start: 0;
    margin-block-end: 1em;
  }

  .fnop-ap__main .blog-post-content ul {
    list-style-type: disc;
    padding-inline-start: 1.5em;
    margin-block-start: 0.5em;
    margin-block-end: 1em;
  }

  .fnop-ap__main .blog-post-content li {
    font-size: var(--font-size--xl);
    line-height: 1.7;
    margin-block-end: 0.4em;
  }

  /* ── Rail ── */
  .fnop-ap__rail {
    display: flex;
    flex-direction: column;
    gap: 24px;
    background: var(--color-surface-cream, #F7F2EA);
    padding: 16px;
    border-radius: 8px;
  }

  @media (min-width: 900px) {
    /* P74 TASK 1 — sticky rail */
    .fnop-ap__rail {
      align-self: start;
      position: sticky;
      top: 24px;
    }

    /* P74 TASK 2 — vertical separator on the layout, not the rail,
       so it spans the full band height and doesn't scroll with sticky. */
    .fnop-ap__layout {
      position: relative;
    }

    .fnop-ap__layout::after {
      content: "";
      position: absolute;
      inset-block: 0;
      /* Gutter centre: main ends at col-1 edge, rule at half of 72px gap */
      inset-inline-end: calc(400px + 36px);
      width: 1px;
      background: rgb(51, 51, 51);
    }

    /* P76 TASK 3 — no rail, no divider */
    .fnop-ap__layout--single::after {
      content: none;
    }
  }

  /* ── Rail group headings ──
     Smaller than body h2: 24/28.8, no red rule. */
  .fnop-ap__rail-heading {
    font-size: var(--font-size--2xl);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.4px;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  /* ── Rail slider (UIkit) ── */
  .fnop-ap__rail-slider-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fnop-ap__rail-slide {
    width: 100%;
  }

  .fnop-ap__rail-dotnav {
    justify-content: center;
    margin-top: 12px;
  }

  /* Hide dotnav when only one item — no navigation needed */
  [data-gc-count="1"] .fnop-ap__rail-dotnav {
    display: none;
  }

  /* ── Horizontal separator between groups ── */
  /* P74 TASK 3 — charcoal, matching the vertical rule */
  .fnop-ap__rail-hr {
    border: none;
    border-top: 1px solid rgb(51, 51, 51);
    margin: 0;
  }

  /* ── In This Episode block in the rail (P75 TASK 3) ──
     Branded h2 with red ornament, same as body h2. */
  .fnop-ap__rail-ite h2 {
    font-size: var(--font-size--4xl);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.4px;
    text-transform: uppercase;
    position: relative;
    padding-block-end: 12px;
    margin-block-start: 0;
    margin-block-end: 12px;
  }

  .fnop-ap__rail-ite h2::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 56px;
    height: 4px;
    background: rgba(255, 0, 0, 0.9);
  }

  .fnop-ap__rail-ite p {
    font-size: var(--font-size--sm);
    line-height: 1.5;
    margin-block-start: 0;
    margin-block-end: 0.5em;
  }

  .fnop-ap__rail-ite ul {
    list-style-type: disc;
    padding-inline-start: 1.5em;
    margin-block-start: 0.5em;
    margin-block-end: 0;
  }

  .fnop-ap__rail-ite li {
    font-size: var(--font-size--sm);
    line-height: 1.5;
    margin-block-end: 0.3em;
  }

  /* ── Featured Games group — no longer its own panel;
     the whole rail is cream (TASK 1, P72). ── */

  /* ── Game card ── */
  .fnop-ap__game-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .fnop-ap__game-card-img {
    display: block;
    width: 100%;
    border-radius: 4px;
  }

  .fnop-ap__game-card-body {
    margin-top: 8px;
  }

  .fnop-ap__game-card-name {
    font-size: var(--font-size--md);
    font-weight: 600;
    margin: 0;
  }

  .fnop-ap__game-card-mfr {
    font-size: var(--font-size--sm);
    margin: 4px 0 0;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .fnop-ap__game-card-date {
    font-size: var(--font-size--sm);
    margin: 4px 0 0;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  /* ── Machine card ── */
  .fnop-ap__machine-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .fnop-ap__machine-card-img {
    display: block;
    width: 100%;
    border-radius: 4px;
  }

  .fnop-ap__machine-card-body {
    margin-top: 8px;
  }

  .fnop-ap__machine-card-title {
    font-size: var(--font-size--md);
    font-weight: 600;
    margin: 0;
  }

  /* Price — replicated from .bmc__price: Archivo 20/32 w500, rgba(0,0,0,0.8) */
  .fnop-ap__machine-card-price {
    font-size: var(--font-size--xl);
    line-height: 1.6;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.8);
    margin: 4px 0 0;
  }

  /* ── Rail buttons ──
     Geometry replicated from .editions-grid__btn — not coupled. */
  .fnop-ap__rail-btn {
    display: inline-block;
    margin-top: 8px;
    padding: 12px 24px;
    font-size: var(--font-size--xl);
    font-weight: 600;
    letter-spacing: 0.4px;
    text-decoration: none;
    text-align: center;
    border-radius: 8px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    width: 100%;
    box-sizing: border-box;
  }

  .fnop-ap__rail-btn:hover {
    transform: scale(1.03);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.15);
  }

  /* Shop Now — red, matches .editions-grid__btn */
  .fnop-ap__rail-btn--shop {
    background: rgb(255, 0, 0);
    color: rgb(255, 255, 255);
  }

  /* Sold Out — mirrors .editions-grid__btn--sold-out */
  .fnop-ap__rail-btn--sold-out {
    background: #999;
    color: rgb(255, 255, 255);
    cursor: not-allowed;
    pointer-events: none;
  }

  /* Explore! — dark */
  .fnop-ap__rail-btn--explore {
    background: rgb(51, 51, 51);
    color: rgb(255, 255, 255);
  }
</style>
