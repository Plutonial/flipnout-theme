{% comment %}
  Header overrides. Rendered from layout/theme.liquid.

  assets/styles.css pins the top-level menu link to var(--font-size--lg) at >= 990px,
  which caps it at 18px and makes the header block's type_font_primary_size setting
  inert at desktop. styles.css is upstream, so the bump lives here.
  --font-size--2xl was tested and wraps the menu to two rows at 1111px.
{% endcomment %}

<style>
  @media screen and (min-width: 990px) {
    .menu-list__link {
      font-size: var(--font-size--xl);
    }
  }

  /* The mega-menu panel is a 3-track grid whose tiles are a fixed 280px each and never
     yield, so below the width at which the page reaches its full 1440px content box
     (1440 + 2 x 40px page margin = 1520px) the two link columns lose width and their
     text spills underneath the tiles — 11 brand links are unclickable at 990px.
     Drop the tiles below that width and give the space back to the links. */
  @media screen and (max-width: 1519px) {
    .mega-menu-tiles {
      display: none;
    }
  }

  /* P93 — Pin each tile to 280px so the tiles track never grows beyond what P33 verified.
     Without this, flex:1 inside the auto-sized grid track lets tiles expand and steal
     width from the brand column, making brand links unclickable under the tiles. */
  @media screen and (min-width: 990px) {
    .mega-menu-tile {
      width: 280px;
      flex: 0 0 280px;
    }
  }

  /* P94 TASK 1 — Prevent the grid from compressing link columns below their content width.
     The mega-menu-inner grid uses repeat(N, auto) tracks. When the total max-content of
     all tracks exceeds available space, CSS grid shrinks the most compressible track —
     the brands column, because its balanced sub-columns can reflow. Setting min-width
     on link columns ensures they keep their full content width; the tiles track (which
     is hidden below 1520px anyway) absorbs any overflow instead.
     .mega-menu-sections and .mega-menu__grid both have display:contents at desktop,
     so .mega-menu__column is a grid item of .mega-menu-inner despite the DOM nesting. */
  @media screen and (min-width: 990px) {
    .mega-menu__column {
      min-width: max-content;
    }
  }

  /* P94 TASK 3 — Tile heading: allow wrapping so line-clamp works.
     The existing -webkit-line-clamp: 2 in _header-menu.liquid requires the text to
     wrap, but white-space or flex sizing can prevent it. Ensure the heading can wrap
     and clamp to 2 lines with an ellipsis instead of cutting mid-word. */
  @media screen and (min-width: 990px) {
    .mega-menu-tile__heading {
      word-break: break-word;
      overflow-wrap: break-word;
    }
  }


  /* P69 — Taller mobile header so the logo has vertical breathing room.
     The header row sizes itself from the logo (no explicit height), so the logo
     touches both edges. Adding vertical padding to the top row only gives the logo
     clearance above and below. Applied below 750px only; desktop is untouched.
     Uses the header's own row element; sections/header.liquid is not modified. */
  @media screen and (max-width: 749px) {
    header-component .header__row--top {
      padding-top: var(--padding-sm);
      padding-bottom: var(--padding-sm);
    }

    /* P70 — Collapse the empty navigation-bar row on mobile.
       This row carries the desktop nav; on mobile it renders with zero content height
       but inherits the same vertical padding from the .header__row rule above.
       Zeroing its padding here keeps the row in the DOM (so desktop is unaffected)
       while removing the 22px empty band below the logo row. Keyed on the row's
       own class — if it ever gains mobile content, give it its own padding rule. */
    header-component .header__navigation-bar-row {
      padding-top: 0;
      padding-bottom: 0;
    }
  }
</style>
