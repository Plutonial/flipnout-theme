{%- comment -%}
  Brand machine card — renders a product card for the brand machines grid.

  Params:
    product    — the product object
    sizes      — (optional) sizes attribute override
{%- endcomment -%}

{%- liquid
  assign is_sold_out = false
  if product.tags contains 'sold-out'
    assign is_sold_out = true
  endif
  assign display_title = product.title | remove_first: ' Pinball Machine'
  unless sizes
    assign sizes = '(min-width: 1520px) 435px, (min-width: 900px) calc((100vw - 216px) / 3), (min-width: 750px) calc(100vw - 104px), calc(100vw - 56px)'
  endunless
-%}

<a class="bmc" href="{{ product.url }}" aria-label="{{ product.title }}">
  <div class="bmc__poster">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 1600 | image_tag:
        loading: 'lazy',
        class: 'bmc__img',
        sizes: sizes,
        widths: '220,300,440,600,880,1200,1600',
        alt: product.title
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'bmc__img bmc__img--placeholder' }}
    {%- endif -%}
    {%- if is_sold_out -%}
      <span class="bmc__badge">Sold Out</span>
    {%- endif -%}
  </div>
  <h3 class="bmc__title">{{ display_title }}</h3>
  <span class="bmc__price">{{ product.price | money }}</span>
</a>
