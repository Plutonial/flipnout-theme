{% comment %}
  Vlog grid styles. Rendered once from layout/theme.liquid.
  Namespaced fnop-vg__* per §6.
{% endcomment %}

<style>
  /* ── Top breathing room — matches Horizon's blog index (48px) ── */
  .fnop-vg__page-title {
    padding-top: 48px;
  }

  .fnop-vg__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: 1fr;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
    padding-block-end: 48px;
  }

  @media (min-width: 750px) {
    .fnop-vg__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px;
    }
  }

  @media (min-width: 1400px) {
    .fnop-vg__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .fnop-vg__card {
    background: var(--color-surface-cream, #F7F2EA);
    padding: 12px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .fnop-vg__media {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
  }

  /* P79 TASK 1 — eyebrow always present, reserves 1 line */
  .fnop-vg__eyebrow {
    font-size: var(--font-size--md);
    line-height: 1.5;
    min-height: calc(var(--font-size--md) * 1.5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-foreground-secondary, #888);
    margin-top: 8px;
    margin-bottom: 0;
  }

  /* P80 TASK 2 — title reserves 3 lines, no truncation */
  .fnop-vg__title {
    font-family: var(--font-heading--family);
    font-size: var(--font-size--lg);
    line-height: calc(24 / 18);
    font-weight: 600;
    min-height: calc(var(--font-size--lg) * (24 / 18) * 3);
    margin-top: 6px;
    margin-bottom: 0;
  }

  /* P80 TASK 3 — excerpt reserves 4 lines for narrowest card width */
  .fnop-vg__excerpt {
    font-size: var(--font-size--md);
    line-height: calc(26 / 16);
    font-weight: 400;
    color: rgb(var(--color-foreground-rgb) / 0.7);
    margin: 6px 0 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    -webkit-line-clamp: 4;
    min-height: calc(var(--font-size--md) * (26 / 16) * 4);
  }

  /* P79 TASK 4 — date matches fnop-ap__date: 20/32 */
  .fnop-vg__date {
    font-size: var(--font-size--xl);
    line-height: calc(32 / 20);
    color: var(--color-foreground-secondary, #888);
    margin-top: auto;
  }
</style>
