{% comment %}
  Vlog grid styles. Rendered once from layout/theme.liquid.
  Namespaced fnop-vg__* per §6.
{% endcomment %}

<style>
  /* ── Top breathing room — matches Horizon's blog index (48px) ── */
  .fnop-vg__page-title {
    padding-top: 48px;
  }

  .fnop-vg__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: 1fr;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
    padding-block-end: 48px;
  }

  @media (min-width: 750px) {
    .fnop-vg__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px;
    }
  }

  @media (min-width: 1400px) {
    .fnop-vg__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .fnop-vg__card {
    background: var(--color-surface-cream, #F7F2EA);
    padding: 12px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .fnop-vg__media {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
  }

  /* P79 TASK 1 — eyebrow always present, reserves 1 line */
  .fnop-vg__eyebrow {
    font-size: var(--font-size--md);
    line-height: 1.5;
    min-height: calc(var(--font-size--md) * 1.5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-foreground-secondary, #888);
    margin-top: 8px;
    margin-bottom: 0;
  }

  /* P84 TASK 2 — title reserves 2 lines, clamped with ellipsis */
  .fnop-vg__title {
    font-family: var(--font-heading--family);
    font-size: var(--font-size--lg);
    line-height: calc(24 / 18);
    font-weight: 600;
    min-height: calc(var(--font-size--lg) * (24 / 18) * 2);
    margin-top: 6px;
    margin-bottom: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  /* P80 TASK 3 — excerpt reserves 4 lines for narrowest card width */
  .fnop-vg__excerpt {
    font-size: var(--font-size--md);
    line-height: calc(26 / 16);
    font-weight: 400;
    color: rgb(var(--color-foreground-rgb) / 0.7);
    margin: 6px 0 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    -webkit-line-clamp: 4;
    min-height: calc(var(--font-size--md) * (26 / 16) * 4);
  }


  /* ══════════════════════════════════════════════
     P81 — Featured hero above the grid
     ══════════════════════════════════════════════ */

  .fnop-vg__hero {
    margin-block-end: 0;
  }

  /* ── P83: Hero band uses the grid's own tracks ── */
  .fnop-vg__hero-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 32px;
  }

  @media (min-width: 750px) {
    .fnop-vg__hero-band {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      column-gap: 32px;
    }

    .fnop-vg__hero-band--no-rail {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ── P83: Column 1 wrapper — poster + meta stacked ── */
  .fnop-vg__hero-col1 {
    display: flex;
    flex-direction: column;
  }

  /* ── Poster — link wrapping image + play glyph ── */
  .fnop-vg__hero-poster {
    display: block;
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px;
    background: #000;
  }

  .fnop-vg__hero-poster-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fnop-vg__hero-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.4));
    transition: transform 0.2s ease;
    z-index: 1;
  }

  .fnop-vg__hero-poster:hover .fnop-vg__hero-play {
    transform: translate(-50%, -50%) scale(1.1);
  }

  .fnop-vg__hero-poster:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* ── P83: Meta block inside column 1, tight under the poster ── */
  .fnop-vg__hero-meta {
    margin-top: 16px;
  }

  .fnop-vg__hero-title {
    font-family: var(--font-heading--family);
    font-size: var(--font-size--2xl);
    line-height: calc(32 / 24);
    font-weight: 600;
    text-transform: uppercase;
    margin: 0;
  }

  .fnop-vg__hero-date {
    display: block;
    font-size: var(--font-size--xl);
    line-height: calc(32 / 20);
    color: var(--color-foreground-secondary, #888);
    margin-top: 8px;
  }

  .fnop-vg__hero-excerpt {
    font-size: var(--font-size--md);
    line-height: calc(26 / 16);
    font-weight: 400;
    color: rgb(var(--color-foreground-rgb) / 0.7);
    margin: 12px 0 0;
  }

  .fnop-vg__hero-more {
    display: inline-block;
    margin-top: 16px;
    padding: 12px 24px;
    font-size: var(--font-size--xl);
    line-height: calc(32 / 20);
    font-weight: 600;
    letter-spacing: 0.4px;
    text-decoration: none;
    text-align: center;
    border-radius: 8px;
    background: rgb(51, 51, 51);
    color: rgb(255, 255, 255);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .fnop-vg__hero-more:hover {
    transform: scale(1.03);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.15);
  }

  .fnop-vg__hero-more:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  /* ── P83 TASK 3: rule between hero and grid ── */
  .fnop-vg__hero-hr {
    border: none;
    border-top: 1px solid rgb(51, 51, 51);
    margin: 24px 0;
  }

  /* ── Mobile: stack poster → title → date → excerpt → More → rail ── */
  @media (max-width: 749px) {
    .fnop-vg__hero-band {
      display: contents;
    }

    .fnop-vg__hero-col1 {
      display: contents;
    }

    .fnop-vg__hero {
      display: flex;
      flex-direction: column;
    }

    .fnop-vg__hero-poster {
      order: 1;
    }

    .fnop-vg__hero-meta {
      order: 2;
    }

    .fnop-vg__hero .fnop-ap__rail {
      order: 4;
      margin-top: 32px;
    }

    .fnop-vg__hero-hr {
      order: 5;
    }
  }
</style>
