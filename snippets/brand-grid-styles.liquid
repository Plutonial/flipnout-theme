{% comment %}
  Shared styles for brand machine cards (.bmc) and brand section layout.
  Rendered once from layout/theme.liquid.
{% endcomment %}

<style>
  .brand-section__container {
    max-width: var(--page-width, 1520px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 16px);
  }

  .brand-section__heading {
    text-align: center;
    font-size: var(--font-size--4xl);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 clamp(32px, 4vw, 56px);
  }

  .bmc {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--color-surface-cream, #F7F2EA);
    border-radius: 0;
    border-top-left-radius: var(--bmc-corner);
    padding: 0 0 12px;
    overflow: hidden;
  }

  .bmc__poster {
    position: relative;
    aspect-ratio: var(--bmc-ratio);
    border-radius: 0;
    overflow: hidden;
    background: transparent;
  }

  .bmc--square .bmc__poster {
    aspect-ratio: 1 / 1;
  }

  .bmc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bmc__badge {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 4px 10px;
    border-radius: 4px;
    background: rgb(255 0 0 / 0.7);
    color: rgb(var(--color-background-rgb));
    font-size: var(--font-size--2xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .bmc__title {
    margin: 10px 0 0;
    font-size: var(--font-size--xl);
    font-weight: 600;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: var(--bmc-title-lines);
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(var(--bmc-title-lines) * 1.3em);
  }

  .bmg {
    --bmc-title-lines: 2;
  }

  .bacc {
    --bmc-title-lines: 3;
  }

  .bmc__title,
  .bmc__price {
    padding-inline: 12px;
  }

  .bmc__price {
    margin-top: 4px;
    font-size: var(--font-size--xl);
    font-weight: 500;
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  .bmc--sold-out {
    cursor: default;
  }

  @media (max-width: 749px) {
    .bmg,
    .bacc {
      --bmc-title-lines: 3;
    }

    .bmc__title {
      font-size: var(--font-size--md);
    }

    .bmc__price {
      font-size: var(--font-size--md);
    }
  }
</style>
