{%- doc -%}
  Renders a flat mobile drawer menu — all leaf links in one list, no accordions.

  @param {object} linklist - The linklist to render
  @param {string} [class] - Additional classes to add to the drawer
  @param {string} [data_header_drawer_type] - The type of header drawer to render
  @param {object} [block] - The block that can be used to provide settings
  @param {object} [section] - The section that can be used to provide settings
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign image_border_radius = block_settings.image_border_radius
%}

<script
  src="{{ 'header-drawer.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<header-drawer
  class="header-drawer {{ class }}"
  style="--menu-image-border-radius: {{ image_border_radius }}px; --resource-card-corner-radius: {{ image_border_radius }}px;"
>
  <details
    id="Details-menu-drawer-container"
    data-skip-node-update="true"
    class="menu-drawer-container"
    ref="details"
    scroll-lock
  >
    <summary
      class="header__icon header__icon--menu header__icon--summary"
      aria-label="{{ 'accessibility.menu' | t }}"
      on:click="/toggle"
    >
      <span class="svg-wrapper header-drawer-icon header-drawer-icon--open">
        {{- 'icon-menu.svg' | inline_asset_content -}}
      </span>
      <span class="svg-wrapper header-drawer-icon header-drawer-icon--close">
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div
      ref="menuDrawer"
      class="
        menu-drawer
        color-{{ block_settings.color_scheme }}
      "
    >
      <button
        class="button close-button menu-drawer__close-button"
        type="button"
        aria-label="{{ 'actions.close' | t }}"
        on:click="/close"
      >
        <span class="svg-wrapper header-drawer-icon header-drawer-icon--close">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>
      <nav
        class="menu-drawer__navigation"
        style="
          {%- render 'menu-font-styles', settings: block_settings, menu_type: 'drawer' %}
          {%- render 'submenu-font-styles', settings: block_settings %}
        "
        aria-label="{{ 'accessibility.header_navigation_label' | t }}"
      >
        {%- comment -%} Logo above the menu list {%- endcomment -%}
        {%- assign logo_height = settings.logo_height_mobile | default: 40 -%}
        <a href="{{ routes.root_url }}" class="fnop-drawer-logo"
           style="--fnop-drawer-logo-height: {{ logo_height }}px;">
          {%- if settings.logo != blank -%}
            {%- assign logo_height_2x = logo_height | times: 2 -%}
            {{
              settings.logo
              | image_url: height: logo_height_2x
              | image_tag:
                alt: shop.name,
                loading: 'eager'
            }}
          {%- else -%}
            {{ shop.name }}
          {%- endif -%}
        </a>

        <ul
          class="menu-drawer__menu"
          role="list"
        >
          {%- comment -%}
            Flatten the menu tree: emit only leaf links (those with no children).
            Emit a divider when the current leaf's parent differs from the previous leaf's parent.
          {%- endcomment -%}
          {%- liquid
            assign prev_parent_title = '__none__'
            assign item_index = 0
          -%}

          {%- for top_link in linklist.links -%}
            {%- if top_link.links == blank -%}
              {%- comment -%} Top-level leaf {%- endcomment -%}
              {%- liquid
                assign current_parent = 'root'
              -%}
              {%- if prev_parent_title != '__none__' and prev_parent_title != current_parent -%}
                {%- assign item_index = item_index | plus: 1 -%}
                <li class="menu-drawer__list-item menu-drawer__list-item--divider-flat" aria-hidden="true"></li>
              {%- endif -%}
              {%- liquid
                assign prev_parent_title = current_parent
                assign item_index = item_index | plus: 1
              -%}
              <li class="menu-drawer__list-item menu-drawer__list-item--flat" style="--menu-drawer-animation-index: {{ item_index }};">
                <a class="menu-drawer__menu-item menu-drawer__menu-item--child focus-inset{% if top_link.current %} menu-drawer__menu-item--active{% endif %}"
                   href="{{ top_link.url }}">
                  <span class="menu-drawer__menu-item-text wrap-text">{{ top_link.title | escape }}</span>
                </a>
              </li>
            {%- else -%}
              {%- comment -%} Has children — recurse into them {%- endcomment -%}
              {%- for child_link in top_link.links -%}
                {%- if child_link.links == blank -%}
                  {%- assign current_parent = top_link.title -%}
                  {%- if prev_parent_title != '__none__' and prev_parent_title != current_parent -%}
                    {%- assign item_index = item_index | plus: 1 -%}
                    <li class="menu-drawer__list-item menu-drawer__list-item--divider-flat" aria-hidden="true"></li>
                  {%- endif -%}
                  {%- liquid
                    assign prev_parent_title = current_parent
                    assign item_index = item_index | plus: 1
                  -%}
                  <li class="menu-drawer__list-item menu-drawer__list-item--flat" style="--menu-drawer-animation-index: {{ item_index }};">
                    <a class="menu-drawer__menu-item menu-drawer__menu-item--child focus-inset{% if child_link.current %} menu-drawer__menu-item--active{% endif %}"
                       href="{{ child_link.url }}">
                      <span class="menu-drawer__menu-item-text wrap-text">{{ child_link.title | escape }}</span>
                    </a>
                  </li>
                {%- else -%}
                  {%- comment -%} Grandchildren — walk one more level {%- endcomment -%}
                  {%- for grandchild_link in child_link.links -%}
                    {%- if grandchild_link.links == blank -%}
                      {%- assign current_parent = child_link.title -%}
                      {%- if prev_parent_title != '__none__' and prev_parent_title != current_parent -%}
                        {%- assign item_index = item_index | plus: 1 -%}
                        <li class="menu-drawer__list-item menu-drawer__list-item--divider-flat" aria-hidden="true"></li>
                      {%- endif -%}
                      {%- liquid
                        assign prev_parent_title = current_parent
                        assign item_index = item_index | plus: 1
                      -%}
                      <li class="menu-drawer__list-item menu-drawer__list-item--flat" style="--menu-drawer-animation-index: {{ item_index }};">
                        <a class="menu-drawer__menu-item menu-drawer__menu-item--child focus-inset{% if grandchild_link.current %} menu-drawer__menu-item--active{% endif %}"
                           href="{{ grandchild_link.url }}">
                          <span class="menu-drawer__menu-item-text wrap-text">{{ grandchild_link.title | escape }}</span>
                        </a>
                      </li>
                    {%- else -%}
                      {%- comment -%} Depth 4+ — continue walking {%- endcomment -%}
                      {%- for deep_link in grandchild_link.links -%}
                        {%- if deep_link.links == blank -%}
                          {%- assign current_parent = grandchild_link.title -%}
                          {%- if prev_parent_title != '__none__' and prev_parent_title != current_parent -%}
                            {%- assign item_index = item_index | plus: 1 -%}
                            <li class="menu-drawer__list-item menu-drawer__list-item--divider-flat" aria-hidden="true"></li>
                          {%- endif -%}
                          {%- liquid
                            assign prev_parent_title = current_parent
                            assign item_index = item_index | plus: 1
                          -%}
                          <li class="menu-drawer__list-item menu-drawer__list-item--flat" style="--menu-drawer-animation-index: {{ item_index }};">
                            <a class="menu-drawer__menu-item menu-drawer__menu-item--child focus-inset{% if deep_link.current %} menu-drawer__menu-item--active{% endif %}"
                               href="{{ deep_link.url }}">
                              <span class="menu-drawer__menu-item-text wrap-text">{{ deep_link.title | escape }}</span>
                            </a>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
    </div>
  </details>
</header-drawer>

{% stylesheet %}
  .fnop-drawer-logo img {
    width: auto;
    height: var(--fnop-drawer-logo-height, 40px);
    max-width: 100%;
    object-fit: contain;
  }
{% endstylesheet %}
