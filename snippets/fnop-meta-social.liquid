{%- comment -%}
  Emits twitter:image and og:image:alt tags that the upstream meta-tags
  snippet does not include. Rendered from theme.liquid, inside <head>.
  Uses the same page_image source as og:image — no second lookup.
{%- endcomment -%}

{%- if page_image -%}
  <meta
    name="twitter:image"
    content="https:{{ page_image | image_url }}"
  >
  {%- if page_image.alt != blank -%}
    <meta
      property="og:image:alt"
      content="{{ page_image.alt | escape }}"
    >
  {%- endif -%}
{%- endif -%}
