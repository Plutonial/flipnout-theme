{% comment %}
  Mobile side gutter for the default collection / search product grid.
  Rendered from layout/theme.liquid.

  Horizon's main-collection grid carries no inline padding at any level, so on mobile
  the cards run flush to the screen edge. At desktop the grid is held in by
  --page-width, which is why this only shows below 750px. The full_width_on_mobile
  setting is not the lever — its class has no effect here (see the P30 brief).

  main-collection.liquid is upstream and must not be edited, so the gutter is applied
  from here.
{% endcomment %}

<style>
  @media screen and (max-width: 749px) {
    .main-collection-grid {
      padding-inline: var(--page-margin);
    }
  }

  {% comment %} ── Product-grid column overrides for category, default-collection and search ── {% endcomment %}
  [data-template="collection.category"] .product-grid,
  [data-template="collection"] .product-grid,
  [data-template="search"] .product-grid {
    gap: 20px;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 749px) {
    [data-template="collection.category"] .product-grid[product-grid-view='mobile-single'],
    [data-template="collection"] .product-grid[product-grid-view='mobile-single'],
    [data-template="search"] .product-grid[product-grid-view='mobile-single'] {
      grid-template-columns: repeat(1, 1fr);
    }
  }

  @media (min-width: 750px) {
    [data-template="collection.category"] .product-grid,
    [data-template="collection"] .product-grid,
    [data-template="search"] .product-grid {
      gap: 32px;
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 900px) {
    [data-template="collection.category"] .product-grid,
    [data-template="collection"] .product-grid,
    [data-template="search"] .product-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  {% comment %} ── Zoom-out: denser grid with title, price and badge still visible ── {% endcomment %}
  [data-template="collection.category"] .product-grid[product-grid-view='zoom-out'],
  [data-template="collection"] .product-grid[product-grid-view='zoom-out'],
  [data-template="search"] .product-grid[product-grid-view='zoom-out'] {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (min-width: 750px) {
    [data-template="collection.category"] .product-grid[product-grid-view='zoom-out'],
    [data-template="collection"] .product-grid[product-grid-view='zoom-out'],
    [data-template="search"] .product-grid[product-grid-view='zoom-out'] {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 900px) {
    [data-template="collection.category"] .product-grid[product-grid-view='zoom-out'],
    [data-template="collection"] .product-grid[product-grid-view='zoom-out'],
    [data-template="search"] .product-grid[product-grid-view='zoom-out'] {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  @media (min-width: 1200px) {
    [data-template="collection.category"] .product-grid[product-grid-view='zoom-out'],
    [data-template="collection"] .product-grid[product-grid-view='zoom-out'],
    [data-template="search"] .product-grid[product-grid-view='zoom-out'] {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  {% comment %} ── Keep title, price and badge visible in zoom-out (out-specify base.css) ── {% endcomment %}
  [data-template="collection.category"] ul[product-grid-view='zoom-out'] .product-grid__card > *,
  [data-template="collection"] ul[product-grid-view='zoom-out'] .product-grid__card > *,
  [data-template="search"] ul[product-grid-view='zoom-out'] .product-grid__card > * {
    display: revert;
  }

  {% comment %} ── Hide Horizon's compact zoom-out block (duplicates the normal title) ── {% endcomment %}
  [data-template="collection.category"] ul[product-grid-view='zoom-out'] .product-grid-view-zoom-out--details,
  [data-template="collection"] ul[product-grid-view='zoom-out'] .product-grid-view-zoom-out--details,
  [data-template="search"] ul[product-grid-view='zoom-out'] .product-grid-view-zoom-out--details {
    display: none;
  }

  [data-template="collection.category"] [product-grid-view='zoom-out'] .card-gallery > .product-badges,
  [data-template="collection"] [product-grid-view='zoom-out'] .card-gallery > .product-badges,
  [data-template="search"] [product-grid-view='zoom-out'] .card-gallery > .product-badges {
    display: revert;
  }

  {% comment %} ── Card styling: cream card, rounded corners, price & title treatment ── {% endcomment %}
  [data-template="collection.category"],
  [data-template="collection"],
  [data-template="search"] {
    --cat-title-lines: 3;
  }

  [data-template="collection.category"] .product-card,
  [data-template="collection"] .product-card,
  [data-template="search"] .product-card,
  [data-template="collection.category"] .product-card__content,
  [data-template="collection"] .product-card__content,
  [data-template="search"] .product-card__content {
    height: 100%;
  }

  [data-template="collection.category"] .product-card__content,
  [data-template="collection"] .product-card__content,
  [data-template="search"] .product-card__content {
    background: var(--color-surface-cream, #F7F2EA);
    border-radius: 0;
    border-top-left-radius: var(--bmc-corner);
    padding: 0 0 12px;
    overflow: hidden;
  }

  [data-template="collection.category"] .card-gallery,
  [data-template="collection"] .card-gallery,
  [data-template="search"] .card-gallery {
    border-radius: 0;
    overflow: hidden;
    background: transparent;
  }

  [data-template="collection.category"] .product-card__content > a.contents > .text-block p,
  [data-template="collection"] .product-card__content > a.contents > .text-block p,
  [data-template="search"] .product-card__content > a.contents > .text-block p {
    display: -webkit-box;
    -webkit-line-clamp: var(--cat-title-lines);
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  [data-template="collection.category"] product-price,
  [data-template="collection"] product-price,
  [data-template="search"] product-price {
    margin-top: auto;
  }

  [data-template="collection.category"] .product-card h3.h4,
  [data-template="collection"] .product-card h3.h4,
  [data-template="search"] .product-card h3.h4 {
    font-family: var(--font-accent--family, var(--font-h1--family));
    font-size: var(--font-size--xl);
  }

  [data-template="collection.category"] .product-card .price,
  [data-template="collection"] .product-card .price,
  [data-template="search"] .product-card .price {
    font-family: var(--font-body--family);
    font-size: var(--font-size--xl);
    font-weight: 500;
  }

  {% comment %} ── Sold-out badge: match .bmc__badge appearance ── {% endcomment %}
  [data-template="collection.category"] .product-card__content > a.contents > *,
  [data-template="collection"] .product-card__content > a.contents > *,
  [data-template="search"] .product-card__content > a.contents > *,
  [data-template="collection.category"] .product-card__content > product-price,
  [data-template="collection"] .product-card__content > product-price,
  [data-template="search"] .product-card__content > product-price {
    padding-inline: 12px;
  }

  [data-template="collection.category"] .product-badges__badge,
  [data-template="collection"] .product-badges__badge,
  [data-template="search"] .product-badges__badge {
    font-size: var(--font-size--2xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1;
    padding: 4px 10px;
  }
</style>
