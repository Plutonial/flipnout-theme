{%- comment -%}
  Collection Grid — reusable grid section for any collection.
  Generalised from fnop-new-arrivals (P85). The fnop-na__ class prefix
  is retained to keep the diff reviewable; classes are already scoped
  by #{{ section_id }}.

  Schema settings:
    heading      — text, blank = no <h2>
    collection   — collection picker; blank = page's collection object
    filter_by    — vendor | type | none
    show_oos_switch — checkbox (reserved, not yet wired)
    rows         — number of rows before "Show more"
{%- endcomment -%}

{%- liquid
  assign section_id = 'fnop-na-' | append: section.id
  assign na_card_sizes = '(min-width: 1520px) 435px, (min-width: 900px) calc((100vw - 216px) / 3), (min-width: 750px) calc(50vw - 74px), calc(50vw - 50px)'

  comment
    ── Resolve collection: setting > page collection ──
  endcomment
  assign grid_col = section.settings.collection | default: collection

  assign filter_by = section.settings.filter_by | default: 'vendor'
  assign heading = section.settings.heading
  assign rows = section.settings.rows | default: 2
-%}

{%- liquid
  comment
    ── Build unique filter-value list from the current page of products ──
  endcomment

  assign na_filters = ''
  assign na_filter_count = 0
  assign na_total = 0

  for p in grid_col.products
    assign na_total = na_total | plus: 1

    if filter_by == 'vendor'
      assign pval = p.vendor
    elsif filter_by == 'type'
      assign pval = p.type
    else
      assign pval = ''
    endif

    if pval != blank
      assign already = false
      if na_filters != ''
        assign _nf_arr = na_filters | split: '|'
        for _nf in _nf_arr
          if _nf == pval
            assign already = true
            break
          endif
        endfor
      endif
      unless already
        if na_filters == ''
          assign na_filters = pval
        else
          assign na_filters = na_filters | append: '|' | append: pval
        endif
        assign na_filter_count = na_filter_count | plus: 1
      endunless
    endif
  endfor

  assign na_f_arr = na_filters | split: '|'
-%}

<fnop-new-arrivals id="{{ section_id }}" class="fnop-na" data-rows="{{ rows }}">
  <div class="brand-section__container">
    {%- if na_total == 0 -%}
      <p class="fnop-na__empty">No products at this time.</p>
    {%- else -%}

      {%- if heading != blank -%}
        <h2 class="brand-section__heading">{{ heading }}</h2>
      {%- endif -%}

      <div class="bmg__toolbar fnop-na__toolbar">
        {%- if filter_by != 'none' and na_filter_count > 1 -%}
          {%- liquid
            if filter_by == 'vendor'
              assign filter_label = 'manufacturer'
            else
              assign filter_label = filter_by
            endif
          -%}
          <select class="bmg__select fnop-na__filter-select" aria-label="Filter by {{ filter_label }}">
            <option value="all">All {{ filter_label }}s ({{ na_filter_count }})</option>
            {%- for v in na_f_arr -%}
              <option value="{{ v | handleize }}">{{ v }}</option>
            {%- endfor -%}
          </select>
        {%- endif -%}
        {%- render 'grid-cols-toggle', mobile_cols: 2 -%}
      </div>

      <ul class="fnop-na__grid fnop-na--precut" role="list" data-cols="{{ settings.grid_columns_desktop | default: '3' }}">
        {%- for p in grid_col.products -%}
          {%- liquid
            if filter_by == 'vendor'
              assign _filter_val = p.vendor | handleize
            elsif filter_by == 'type'
              assign _filter_val = p.type | handleize
            else
              assign _filter_val = ''
            endif
          -%}
          <li class="fnop-na__item" data-filter="{{ _filter_val }}">
            {%- render 'brand-machine-card', product: p, sizes: na_card_sizes -%}
          </li>
        {%- endfor -%}
      </ul>

      <div class="fnop-na__controls">
        <button class="fnop-na__show-more" type="button" hidden>Show more</button>
      </div>

    {%- endif -%}
  </div>
</fnop-new-arrivals>

{% style %}
  {%- render 'brand-toolbar-styles' -%}

  #{{ section_id }} {
    display: block;
    padding-top: clamp(32px, 6vw, 56px);
    padding-bottom: clamp(48px, 8vw, 120px);
  }

  #{{ section_id }} .fnop-na__grid {
    display: grid;
    grid-template-columns: repeat(var(--fnop-na-mobile-cols, 2), 1fr);
    column-gap: 20px;
    row-gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 900px) {
    #{{ section_id }} .fnop-na__grid {
      grid-template-columns: repeat(var(--fnop-na-desktop-cols, {{ settings.grid_columns_desktop | default: '3' }}), 1fr);
      column-gap: 32px;
      row-gap: 32px;
    }
  }

  #{{ section_id }} .fnop-na__item {
    min-width: 0;
  }

  {% comment %} Pre-cut: rows × cols. 2 cols = 4 items, 1 col = 2, 3 cols = 6, 4 cols = 8 {% endcomment %}
  #{{ section_id }} .fnop-na--precut .fnop-na__item:nth-child(n + 5) { display: none; }

  @media (max-width: 899px) {
    #{{ section_id }} .fnop-na__grid[data-mcols="1"].fnop-na--precut .fnop-na__item:nth-child(n + 3) { display: none; }
  }

  @media (min-width: 900px) {
    #{{ section_id }} .fnop-na--precut .fnop-na__item:nth-child(n + 5) { display: list-item; }
    #{{ section_id }} .fnop-na--precut .fnop-na__item:nth-child(n + 7) { display: none; }

    #{{ section_id }} .fnop-na__grid[data-cols="4"].fnop-na--precut .fnop-na__item:nth-child(n + 7) { display: list-item; }
    #{{ section_id }} .fnop-na__grid[data-cols="4"].fnop-na--precut .fnop-na__item:nth-child(n + 9) { display: none; }
  }

  #{{ section_id }} .fnop-na__item--offfilter { display: none; }


  #{{ section_id }} .fnop-na__controls {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  #{{ section_id }} .fnop-na__show-more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 12px 28px;
    border: 2px solid rgb(var(--color-foreground-rgb) / 0.81);
    border-radius: var(--radius-sm, 8px);
    font-size: var(--font-size--sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: rgb(var(--color-foreground-rgb) / 0.81);
    background-color: transparent;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  #{{ section_id }} .fnop-na__show-more:hover {
    background: rgb(var(--color-foreground-rgb));
    color: rgb(var(--color-background-rgb));
  }

  #{{ section_id }} .fnop-na__show-more[hidden] { display: none; }

  #{{ section_id }} .fnop-na__empty {
    text-align: center;
    font-size: var(--font-size--lg);
    color: rgb(var(--color-foreground-rgb) / 0.6);
    padding: 48px 0;
  }

  #{{ section_id }} .fnop-na__pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  #{{ section_id }} .fnop-na__page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    min-height: 40px;
    padding: 8px 12px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
    border-radius: var(--radius-sm, 8px);
    font-size: var(--font-size--sm);
    font-weight: 600;
    text-decoration: none;
    color: rgb(var(--color-foreground-rgb) / 0.81);
    background: transparent;
    transition: background-color 0.2s, color 0.2s;
  }

  #{{ section_id }} .fnop-na__page-link:hover {
    background: rgb(var(--color-foreground-rgb));
    color: rgb(var(--color-background-rgb));
  }

  #{{ section_id }} .fnop-na__page-link--current {
    background: rgb(var(--color-foreground-rgb));
    color: rgb(var(--color-background-rgb));
    pointer-events: none;
  }
{% endstyle %}

<script>
  if (!customElements.get('fnop-new-arrivals')) {
    class FnopNewArrivals extends HTMLElement {
      connectedCallback() {
        this.grid = this.querySelector('.fnop-na__grid');
        this.btn = this.querySelector('.fnop-na__show-more');
        this.select = this.querySelector('.fnop-na__filter-select');
        this.rows = parseInt(this.dataset.rows, 10) || 2;
        if (!this.grid) return;

        this.items = Array.from(this.querySelectorAll('.fnop-na__item'));

        if (this.select) {
          this.select.addEventListener('change', () => this.applyFilter());
        }

        if (this.btn) {
          this.btn.addEventListener('click', () => this.handleShowMore());
        }

        const sizeToggle = this.querySelector('.fnop-toggle--mobile');
        if (sizeToggle) {
          sizeToggle.addEventListener('click', (e) => {
            const btn = e.target.closest('.fnop-toggle-btn');
            if (!btn) return;
            if (this.grid) {
              this.grid.style.setProperty('--fnop-na-mobile-cols', btn.dataset.cols);
              this.grid.dataset.mcols = btn.dataset.cols;
            }
            sizeToggle.querySelectorAll('.fnop-toggle-btn').forEach(b => {
              b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
            });
            this.update();
          });
        }

        const desktopToggle = this.querySelector('.fnop-toggle--desktop');
        if (desktopToggle) {
          desktopToggle.addEventListener('click', (e) => {
            const btn = e.target.closest('.fnop-toggle-btn');
            if (!btn) return;
            if (this.grid) {
              this.grid.style.setProperty('--fnop-na-desktop-cols', btn.dataset.cols);
              this.grid.dataset.cols = btn.dataset.cols;
            }
            desktopToggle.querySelectorAll('.fnop-toggle-btn').forEach(b => {
              b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
            });
            this.update();
          });
        }

        this._resizeObserver = new ResizeObserver(() => this.update());
        this._resizeObserver.observe(this.grid);

        this.update();
      }

      disconnectedCallback() {
        if (this._resizeObserver) this._resizeObserver.disconnect();
      }

      getColumns() {
        const t = getComputedStyle(this.grid).gridTemplateColumns;
        return t && t !== 'none' ? t.split(' ').filter(Boolean).length : 2;
      }

      getEligible() {
        return this.items.filter(item =>
          !item.classList.contains('fnop-na__item--offfilter')
        );
      }

      applyFilter() {
        const val = this.select ? this.select.value : 'all';

        this.items.forEach(item => {
          item.classList.toggle(
            'fnop-na__item--offfilter',
            val !== 'all' && item.dataset.filter !== val
          );
        });

        if (val !== 'all') {
          this.grid.classList.remove('fnop-na--precut');
        } else {
          this.grid.classList.add('fnop-na--precut');
        }

        this.update();
      }

      update() {
        if (!this.btn) return;
        const eligible = this.getEligible();
        const total = eligible.length;
        const cols = this.getColumns();
        const precut = this.grid.classList.contains('fnop-na--precut');
        const visibleCount = precut ? this.rows * cols : total;


        if (total > visibleCount) {
          this.btn.hidden = false;
          this.btn.textContent = 'Show more \u00B7 ' + (total - visibleCount) + ' remaining';
        } else {
          this.btn.hidden = true;
        }
      }

      handleShowMore() {
        this.grid.classList.remove('fnop-na--precut');
        this.btn.hidden = true;
      }
    }
    customElements.define('fnop-new-arrivals', FnopNewArrivals);
  }
</script>

{% schema %}
{
  "name": "New Arrivals Grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "select",
      "id": "filter_by",
      "label": "Filter dropdown",
      "options": [
        { "value": "vendor", "label": "Manufacturer" },
        { "value": "type", "label": "Product type" },
        { "value": "none", "label": "None" }
      ],
      "default": "vendor"
    },
    {
      "type": "checkbox",
      "id": "show_oos_switch",
      "label": "Show Out of Stock switch",
      "default": true
    },
    {
      "type": "range",
      "id": "rows",
      "label": "Rows before Show More",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 2
    }
  ],
  "presets": [
    {
      "name": "New Arrivals Grid"
    }
  ]
}
{% endschema %}
