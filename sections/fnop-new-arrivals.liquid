{%- comment -%}
  New Arrivals — renders the curated Manual collection's products
  as machine cards, in collection order (Manual sort).
  Note: collection.products is capped at 50 items by Shopify.
  If this collection exceeds 50, the page silently truncates.
{%- endcomment -%}

{%- liquid
  assign section_id = 'fnop-new-arrivals-' | append: section.id
  assign na_card_sizes = '(min-width: 1520px) 435px, (min-width: 900px) calc((100vw - 216px) / 3), (min-width: 750px) calc(50vw - 74px), calc(50vw - 50px)'

  comment
    ── Resolve collection: use page collection on /collections/new-arrivals,
       fall back to handle lookup on the home page or any other surface ──
  endcomment
  if collection and collection.handle == 'new-arrivals'
    assign na_col = collection
  else
    assign na_col = collections['new-arrivals']
  endif

  comment
    ── Build unique vendor list from the collection's own products ──
  endcomment

  assign na_vendors = ''
  assign na_vendor_count = 0
  assign na_total = 0

  for p in na_col.products
    assign na_total = na_total | plus: 1
    assign pv = p.vendor
    assign already = false
    if na_vendors != ''
      assign _nv_arr = na_vendors | split: '|'
      for _nv in _nv_arr
        if _nv == pv
          assign already = true
          break
        endif
      endfor
    endif
    unless already
      if na_vendors == ''
        assign na_vendors = pv
      else
        assign na_vendors = na_vendors | append: '|' | append: pv
      endif
      assign na_vendor_count = na_vendor_count | plus: 1
    endunless
  endfor

  assign na_v_arr = na_vendors | split: '|'
-%}

<fnop-new-arrivals id="{{ section_id }}" class="fnop-na">
  <div class="brand-section__container">
    {%- if na_total == 0 -%}
      <p class="fnop-na__empty">No new arrivals at this time.</p>
    {%- else -%}

      <h2 class="brand-section__heading">Shop New Releases</h2>

      <div class="bmg__toolbar fnop-na__toolbar">
        {%- if na_vendor_count > 1 -%}
          <select class="bmg__select fnop-na__filter-select" aria-label="Filter New Arrivals by manufacturer">
            <option value="all">All manufacturers ({{ na_vendor_count }})</option>
            {%- for v in na_v_arr -%}
              <option value="{{ v | handleize }}">{{ v }}</option>
            {%- endfor -%}
          </select>
        {%- endif -%}
        {%- render 'grid-cols-toggle', mobile_cols: 2 -%}
      </div>

      <ul class="fnop-na__grid fnop-na--precut" role="list" data-cols="{{ settings.grid_columns_desktop | default: '3' }}">
        {%- for p in na_col.products -%}
          <li class="fnop-na__item" data-filter="{{ p.vendor | handleize }}">
            {%- render 'brand-machine-card', product: p, sizes: na_card_sizes -%}
          </li>
        {%- endfor -%}
      </ul>

      <div class="fnop-na__controls">
        <button class="fnop-na__show-more" type="button" hidden>Show more</button>
      </div>

    {%- endif -%}
  </div>
</fnop-new-arrivals>

{% style %}
  {%- render 'brand-toolbar-styles' -%}

  #{{ section_id }} {
    padding-top: clamp(32px, 6vw, 56px);
    padding-bottom: clamp(48px, 8vw, 120px);
  }

  #{{ section_id }} .fnop-na__grid {
    display: grid;
    grid-template-columns: repeat(var(--fnop-na-mobile-cols, 2), 1fr);
    column-gap: 20px;
    row-gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 900px) {
    #{{ section_id }} .fnop-na__grid {
      grid-template-columns: repeat(var(--fnop-na-desktop-cols, {{ settings.grid_columns_desktop | default: '3' }}), 1fr);
      column-gap: 32px;
      row-gap: 32px;
    }
  }

  #{{ section_id }} .fnop-na__item {
    min-width: 0;
  }

  {% comment %} Pre-cut: 2 rows. 2 cols = 4 items, 1 col = 2, 3 cols = 6, 4 cols = 8 {% endcomment %}
  #{{ section_id }} .fnop-na--precut .fnop-na__item:nth-child(n + 5) { display: none; }

  @media (max-width: 899px) {
    #{{ section_id }} .fnop-na__grid[data-mcols="1"].fnop-na--precut .fnop-na__item:nth-child(n + 3) { display: none; }
  }

  @media (min-width: 900px) {
    #{{ section_id }} .fnop-na--precut .fnop-na__item:nth-child(n + 5) { display: list-item; }
    #{{ section_id }} .fnop-na--precut .fnop-na__item:nth-child(n + 7) { display: none; }

    #{{ section_id }} .fnop-na__grid[data-cols="4"].fnop-na--precut .fnop-na__item:nth-child(n + 7) { display: list-item; }
    #{{ section_id }} .fnop-na__grid[data-cols="4"].fnop-na--precut .fnop-na__item:nth-child(n + 9) { display: none; }
  }

  #{{ section_id }} .fnop-na__item--offfilter { display: none; }


  #{{ section_id }} .fnop-na__controls {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  #{{ section_id }} .fnop-na__show-more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 12px 28px;
    border: 2px solid rgb(var(--color-foreground-rgb) / 0.81);
    border-radius: var(--radius-sm, 8px);
    font-size: var(--font-size--sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: rgb(var(--color-foreground-rgb) / 0.81);
    background-color: transparent;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  #{{ section_id }} .fnop-na__show-more:hover {
    background: rgb(var(--color-foreground-rgb));
    color: rgb(var(--color-background-rgb));
  }

  #{{ section_id }} .fnop-na__show-more[hidden] { display: none; }

  #{{ section_id }} .fnop-na__empty {
    text-align: center;
    font-size: var(--font-size--lg);
    color: rgb(var(--color-foreground-rgb) / 0.6);
    padding: 48px 0;
  }
{% endstyle %}

<script>
  if (!customElements.get('fnop-new-arrivals')) {
    class FnopNewArrivals extends HTMLElement {
      connectedCallback() {
        this.grid = this.querySelector('.fnop-na__grid');
        this.btn = this.querySelector('.fnop-na__show-more');
        this.select = this.querySelector('.fnop-na__filter-select');
        if (!this.grid) return;

        this.items = Array.from(this.querySelectorAll('.fnop-na__item'));

        if (this.select) {
          this.select.addEventListener('change', () => this.applyFilter());
        }

        if (this.btn) {
          this.btn.addEventListener('click', () => this.handleShowMore());
        }

        const sizeToggle = this.querySelector('.fnop-toggle--mobile');
        if (sizeToggle) {
          sizeToggle.addEventListener('click', (e) => {
            const btn = e.target.closest('.fnop-toggle-btn');
            if (!btn) return;
            if (this.grid) {
              this.grid.style.setProperty('--fnop-na-mobile-cols', btn.dataset.cols);
              this.grid.dataset.mcols = btn.dataset.cols;
            }
            sizeToggle.querySelectorAll('.fnop-toggle-btn').forEach(b => {
              b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
            });
            this.update();
          });
        }

        const desktopToggle = this.querySelector('.fnop-toggle--desktop');
        if (desktopToggle) {
          desktopToggle.addEventListener('click', (e) => {
            const btn = e.target.closest('.fnop-toggle-btn');
            if (!btn) return;
            if (this.grid) {
              this.grid.style.setProperty('--fnop-na-desktop-cols', btn.dataset.cols);
              this.grid.dataset.cols = btn.dataset.cols;
            }
            desktopToggle.querySelectorAll('.fnop-toggle-btn').forEach(b => {
              b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
            });
            this.update();
          });
        }

        this._resizeObserver = new ResizeObserver(() => this.update());
        this._resizeObserver.observe(this.grid);

        this.update();
      }

      disconnectedCallback() {
        if (this._resizeObserver) this._resizeObserver.disconnect();
      }

      getColumns() {
        const t = getComputedStyle(this.grid).gridTemplateColumns;
        return t && t !== 'none' ? t.split(' ').filter(Boolean).length : 2;
      }

      getEligible() {
        return this.items.filter(item =>
          !item.classList.contains('fnop-na__item--offfilter')
        );
      }

      applyFilter() {
        const val = this.select ? this.select.value : 'all';

        this.items.forEach(item => {
          item.classList.toggle(
            'fnop-na__item--offfilter',
            val !== 'all' && item.dataset.filter !== val
          );
        });

        if (val !== 'all') {
          this.grid.classList.remove('fnop-na--precut');
        } else {
          this.grid.classList.add('fnop-na--precut');
        }

        this.update();
      }

      update() {
        if (!this.btn) return;
        const eligible = this.getEligible();
        const total = eligible.length;
        const cols = this.getColumns();
        const precut = this.grid.classList.contains('fnop-na--precut');
        const visibleCount = precut ? 2 * cols : total;


        if (total > visibleCount) {
          this.btn.hidden = false;
          this.btn.textContent = 'Show more \u00B7 ' + (total - visibleCount) + ' remaining';
        } else {
          this.btn.hidden = true;
        }
      }

      handleShowMore() {
        this.grid.classList.remove('fnop-na--precut');
        this.btn.hidden = true;
      }
    }
    customElements.define('fnop-new-arrivals', FnopNewArrivals);
  }
</script>

{% schema %}
{
  "name": "New Arrivals Grid",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "New Arrivals Grid"
    }
  ]
}
{% endschema %}
