{%- liquid
  assign section_id = 'game-gallery-lore-' | append: section.id
  assign gallery = collection.metafields.custom.gallery.value
  assign has_gallery = false
  if gallery != blank and gallery.size > 0
    assign has_gallery = true
  endif
  assign has_lore = false
  if collection.description != blank
    assign has_lore = true
  endif

  capture game_name
    render 'fnop-game-name', fnop_game_col: collection
  endcapture
  assign game_name = game_name | strip
-%}

{%- if has_gallery or has_lore -%}
<div class="game-section-band game-section-band--cream">
  <section id="{{ section_id }}" class="game-gallery-lore">
    <div class="game-gallery-lore__grid">

      {% comment %} ── Heading: sits above the two-column grid so it does not affect vertical centring ── {% endcomment %}
      {%- if has_lore -%}
        <h2 class="game-gallery-lore__heading game-section-heading">About {{ game_name }} Pinball</h2>
      {%- endif -%}

      {% comment %} ── Left column: About the Game copy + credits ── {% endcomment %}
      {%- if has_lore -%}
        <div class="game-gallery-lore__lore">
          <div class="game-gallery-lore__body rte">
            {{ collection.description }}
          </div>

          {%- if collection.metafields.custom.credits != blank -%}
            <p class="game-gallery-lore__credits">Credits: {{ collection.metafields.custom.credits }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {% comment %} ── Right column: Gallery as UIkit Slider + Lightbox ── {% endcomment %}
      {%- if has_gallery -%}
        <div class="game-gallery-lore__gallery">
          <div uk-lightbox="animation: fade">
            <div uk-slider="finite: true">
              <div class="uk-position-relative">
                <div class="uk-slider-container">
                  <ul class="uk-slider-items uk-grid uk-grid-collapse">
                    {%- for image in gallery -%}
                      <li class="game-gallery-lore__slide">
                        <a
                          href="{{ image | image_url: width: 2400 }}"
                          data-caption="{{ game_name }} Gallery"
                          data-type="image"
                        >
                          {{ image | image_url: width: 1200 | image_tag:
                            loading: 'lazy',
                            class: 'game-gallery-lore__img',
                            sizes: '(min-width: 990px) 45vw, 95vw',
                            widths: '400,600,800,1000,1200'
                          }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>

                {% comment %} Slidenav arrows {% endcomment %}
                <a class="uk-position-center-left uk-position-small" href uk-slidenav-previous uk-slider-item="previous"></a>
                <a class="uk-position-center-right uk-position-small" href uk-slidenav-next uk-slider-item="next"></a>
              </div>

            </div>
          </div>
        </div>
      {%- endif -%}

    </div>
  </section>
</div>
{%- endif -%}

{% style %}
  #{{ section_id }} {
    padding: clamp(40px, 6vw, 80px) 0;
    width: min(var(--game-band-w), 100% - 2 * var(--game-band-gutter));
    margin-inline: auto;
  }

  #{{ section_id }} .game-gallery-lore__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(32px, 4vw, 48px);
  }

  {% comment %}
    On mobile the heading is a separate grid item so the grid gap provides
    spacing — zero the heading's own bottom margin to avoid doubling.
    On desktop (gap: 0) the heading's margin provides the spacing instead.
  {% endcomment %}
  #{{ section_id }} .game-gallery-lore__grid > .game-gallery-lore__heading {
    margin-bottom: 0;
  }

  @media (min-width: 990px) {
    #{{ section_id }} .game-gallery-lore__grid {
      --_gl-gap: clamp(32px, 4vw, 48px);
      grid-template-columns: 1fr 1fr;
      gap: 0;
      align-items: start;
    }

    {% comment %}
      The heading spans both columns so it sits above the two-column row.
      This way align-self: center on the gallery centres it against the
      copy block only, not the heading + copy.
      Restore the heading margin (zeroed globally to avoid doubling with
      the mobile grid gap) since desktop gap is 0.
    {% endcomment %}
    #{{ section_id }} .game-gallery-lore__grid > .game-gallery-lore__heading {
      grid-column: 1 / -1;
      margin-bottom: clamp(24px, 4vw, 48px);
    }

    #{{ section_id }} .game-gallery-lore__gallery {
      align-self: center;
    }

    {% comment %}
      The grid gap is zeroed; each column gets half-gap padding on the
      inner side so content does not touch across the centre line.
    {% endcomment %}
    #{{ section_id }} .game-gallery-lore__lore {
      padding-right: calc(var(--_gl-gap) / 2);
    }

    #{{ section_id }} .game-gallery-lore__gallery {
      padding-left: calc(var(--_gl-gap) / 2);
    }
  }

  {% comment %} ── Gallery slider: fixed-height viewport for consistent sizing ── {% endcomment %}
  #{{ section_id }} .game-gallery-lore__slide {
    width: 100%;
    flex: 0 0 100%;
  }

  #{{ section_id }} .game-gallery-lore__slide a {
    display: flex;
    align-items: center;
    justify-content: center;
    height: clamp(400px, 60vw, 700px);
    overflow: hidden;
    cursor: zoom-in;
  }

  #{{ section_id }} .game-gallery-lore__img {
    --_gallery-shadow: 0 6px 18px 0 rgba(0, 0, 0, 0.12);
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-sm, 8px);
    box-shadow: var(--_gallery-shadow);
  }

  {% comment %} ── Lore column: left-aligned at desktop, centres at mobile via shared snippet ── {% endcomment %}
  @media (min-width: 750px) {
    #{{ section_id }} .game-gallery-lore__heading {
      text-align: left;
    }

    #{{ section_id }} .game-gallery-lore__heading::after {
      margin: 12px 0 0;
    }
  }

  #{{ section_id }} .game-gallery-lore__body {
    font-size: var(--font-size--xl);
    line-height: 1.7;
  }

  #{{ section_id }} .game-gallery-lore__body > *:first-child {
    margin-top: 0;
  }

  #{{ section_id }} .game-gallery-lore__body > *:last-child {
    margin-bottom: 0;
  }

  #{{ section_id }} .game-gallery-lore__credits {
    font-size: var(--font-size--xl);
    color: var(--color-foreground-secondary, #888);
    margin-top: clamp(24px, 3vw, 40px);
    line-height: 1.5;
  }

  {% comment %} ── UIkit overrides scoped to this section ── {% endcomment %}
  #{{ section_id }} .uk-slidenav {
    color: #fff;
    background: rgba(0, 0, 0, 0.45);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ section_id }} .uk-slidenav:hover {
    background: rgba(0, 0, 0, 0.65);
  }


  {%- render 'fnop-section-heading-mobile' -%}
{% endstyle %}

{% schema %}
{
  "name": "Gallery + Lore",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
