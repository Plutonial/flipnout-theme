{%- comment -%}
  Edition pills — sibling editions from the game collection.
  Hidden when game is nil or game has only one edition.
  Sorted by product.edition_order ascending (same approach as editions grid).
{%- endcomment -%}

{%- liquid
  assign section_id = 'fnop-edition-pills-' | append: section.id

  comment — Resolve game collection
  endcomment
  capture _game_handle
    render 'fnop-product-game-resolve', fnop_product: product
  endcapture
  assign _game_handle = _game_handle | strip
  assign game = false
  if _game_handle != blank
    assign game = collections[_game_handle]
  endif

  assign show_pills = false
  if game != false and game != blank and game.products.size > 1
    assign show_pills = true
  endif
-%}

{%- if show_pills -%}
{%- liquid
  comment — Sort products by edition_order ascending (same as editions grid)
  endcomment
  assign sorted_handles = ''
  for pos in (1..10)
    assign pos_str = pos | append: ''
    for p in game.products
      assign eo = p.metafields.product.edition_order.value | append: ''
      if eo == pos_str
        if sorted_handles == ''
          assign sorted_handles = p.handle
        else
          assign sorted_handles = sorted_handles | append: ',' | append: p.handle
        endif
      endif
    endfor
  endfor
  for p in game.products
    assign eo = p.metafields.product.edition_order.value
    if eo == blank
      if sorted_handles == ''
        assign sorted_handles = p.handle
      else
        assign sorted_handles = sorted_handles | append: ',' | append: p.handle
      endif
    endif
  endfor
  assign sorted_handle_list = sorted_handles | split: ','

  capture game_name
    render 'fnop-game-name', fnop_game_col: game
  endcapture
  assign game_name = game_name | strip
-%}

<div id="{{ section_id }}" class="fnop-edition-pills">
  <div class="fnop-edition-pills__row">
    {%- for handle in sorted_handle_list -%}
      {%- assign sibling = game.products | where: 'handle', handle | first -%}
      {%- if sibling == blank -%}{%- continue -%}{%- endif -%}
      {%- liquid
        capture edition_label
          render 'fnop-edition-label', fnop_product: sibling, fnop_game_name: game_name
        endcapture
        assign edition_label = edition_label | strip
        if edition_label == blank
          assign edition_label = sibling.title
        endif
        assign is_current = false
        if sibling.handle == product.handle
          assign is_current = true
        endif
      -%}
      {%- if is_current -%}
        <span class="fnop-edition-pills__pill fnop-edition-pills__pill--active" aria-current="true">
          <span class="fnop-edition-pills__name">{{ edition_label }}</span>
        </span>
      {%- else -%}
        <a href="{{ sibling.url }}" class="fnop-edition-pills__pill">
          <span class="fnop-edition-pills__name">{{ edition_label }}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <a href="{{ game.url }}" class="fnop-edition-pills__compare">Compare all editions</a>
</div>
{%- endif -%}

{% style %}
  #{{ section_id }} {
    width: min(var(--page-content-width, 1440px), 100% - 2 * var(--page-margin, 40px));
    margin-inline: auto;
    padding-block: 8px 0;
  }

  #{{ section_id }} .fnop-edition-pills__row {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    align-items: flex-end;
  }

  #{{ section_id }} .fnop-edition-pills__pill {
    display: block;
    border: 0;
    border-bottom: 3px solid var(--color-logo-red, #FF0000);
    border-radius: 0;
    background: transparent;
    padding: 0 0 8px;
    text-decoration: none;
    color: var(--color-foreground);
    transition: color 0.15s ease;
  }

  #{{ section_id }} .fnop-edition-pills__pill:hover .fnop-edition-pills__name {
    color: var(--color-logo-red, #FF0000);
  }

  #{{ section_id }} .fnop-edition-pills__pill[aria-current] .fnop-edition-pills__name {
    color: var(--color-logo-red, #FF0000);
  }

  #{{ section_id }} .fnop-edition-pills__name {
    font-family: var(--font-heading-family);
    font-size: var(--font-size--xl);
    font-weight: 600;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.81);
    line-height: 1.1;
  }

  #{{ section_id }} .fnop-edition-pills__compare {
    display: inline-block;
    margin-top: 18px;
    font-size: var(--font-size--xs);
    color: var(--color-logo-red, #FF0000);
    text-decoration: none;
  }

  #{{ section_id }} .fnop-edition-pills__compare:hover {
    text-decoration: underline;
  }
{% endstyle %}

{% schema %}
{
  "name": "Edition pills",
  "settings": [],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
