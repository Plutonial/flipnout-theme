{%- comment -%}
  Latest Releases Carousel — homepage section.
  One tile per game (game collection image + name + link), sorted by release_date desc.
  Boxed to --page-content-width, arrows outside the box. Uses uk-slider.
{%- endcomment -%}

{%- liquid
  assign section_id = 'fnop-lr-' | append: section.id
  assign games_count = section.settings.games_count
  assign heading = section.settings.heading

  comment
    ── Collect game collections and their release dates ──
  endcomment

  assign game_cols = ''
  assign game_dates = ''
  assign game_total = 0

  for c in collections
    assign is_game = c.metafields.collection.is_game
    if is_game
      assign rd = c.metafields.custom.release_date.value | default: '1970-01-01'
      if game_cols == ''
        assign game_cols = c.handle
        assign game_dates = rd
      else
        assign game_cols = game_cols | append: '|' | append: c.handle
        assign game_dates = game_dates | append: '|' | append: rd
      endif
      assign game_total = game_total | plus: 1
    endif
  endfor

  assign gc_arr = game_cols | split: '|'
  assign gd_arr = game_dates | split: '|'

  comment — Bubble sort by release_date descending
  endcomment
  assign sorted_gc = gc_arr
  assign sorted_gd = gd_arr

  if game_total > 1
    assign n = game_total | minus: 1
    for i in (1..n)
      assign inner = n | minus: i
      for j in (0..inner)
        assign j1 = j | plus: 1
        assign date_a = sorted_gd[j]
        assign date_b = sorted_gd[j1]
        if date_a < date_b
          assign tmp_h = sorted_gc[j]
          assign tmp_d = sorted_gd[j]
          assign new_handles = ''
          assign new_dates = ''
          for k in (0..n)
            if k == j
              assign h_val = sorted_gc[j1]
              assign d_val = sorted_gd[j1]
            elsif k == j1
              assign h_val = tmp_h
              assign d_val = tmp_d
            else
              assign h_val = sorted_gc[k]
              assign d_val = sorted_gd[k]
            endif
            if new_handles == ''
              assign new_handles = h_val
              assign new_dates = d_val
            else
              assign new_handles = new_handles | append: '|' | append: h_val
              assign new_dates = new_dates | append: '|' | append: d_val
            endif
          endfor
          assign sorted_gc = new_handles | split: '|'
          assign sorted_gd = new_dates | split: '|'
        endif
      endfor
    endfor
  endif

  assign limit = games_count
  if game_total < limit
    assign limit = game_total
  endif
-%}

{%- if limit > 0 -%}
  <section id="{{ section_id }}" class="fnop-lr">
    {%- if heading != blank -%}
      <h2 class="fnop-lr__heading">{{ heading }}</h2>
    {%- endif -%}

    <div class="fnop-lr__outer">
      <div class="fnop-lr__slider" uk-slider="finite: true; autoplay: false; center: false">
        <div class="uk-position-relative fnop-lr__track">
          <div class="uk-slider-container fnop-lr__container">
            <ul class="uk-slider-items fnop-lr__list">
              {%- for idx in (0..limit) -%}
                {%- if idx >= limit -%}{%- break -%}{%- endif -%}
                {%- assign handle = sorted_gc[idx] -%}
                {%- assign game_col = collections[handle] -%}
                {%- if game_col == blank -%}{%- continue -%}{%- endif -%}

                <li class="fnop-lr__item">
                  {%- render 'fnop-game-card',
                    fnop_game_col: game_col,
                    fnop_card_class: 'fnop-lr__card',
                    fnop_img_class: 'fnop-lr__img',
                    fnop_label_class: 'fnop-lr__label',
                    fnop_hide_label: false
                  -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>

          <a class="fnop-lr__nav fnop-lr__nav--prev" href uk-slidenav-previous uk-slider-item="previous"></a>
          <a class="fnop-lr__nav fnop-lr__nav--next" href uk-slidenav-next uk-slider-item="next"></a>
        </div>
      </div>
    </div>
  </section>

  {% style %}
    #{{ section_id }} {
      --_lr-cols: 3;
      --_lr-gap: 24px;
      --_lr-container: min(var(--page-content-width, 1440px), calc(100vw - var(--page-margin, 16px) * 2));
      --_lr-card-w: calc((var(--_lr-container) - var(--_lr-gap) * (var(--_lr-cols) - 1)) / var(--_lr-cols));
      --_lr-slide-w: calc(var(--_lr-card-w) + var(--_lr-gap));
      --_lr-arrow-size: 48px;
      --_lr-arrow-gap: 16px;

      padding-block: clamp(48px, 8vw, 96px);
    }

    #{{ section_id }} .fnop-lr__heading {
      max-width: var(--_lr-container);
      margin-inline: auto;
      padding-inline: var(--page-margin, 16px);
      margin-bottom: 32px;
      text-align: center;
      font-size: var(--font-size--4xl);
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    #{{ section_id }} .fnop-lr__outer {
      max-width: calc(var(--_lr-container) + (var(--_lr-arrow-size) + var(--_lr-arrow-gap)) * 2);
      margin-inline: auto;
      padding-inline: calc(var(--_lr-arrow-size) + var(--_lr-arrow-gap));
    }

    #{{ section_id }} .fnop-lr__container {
      min-width: 0;
    }

    #{{ section_id }} .fnop-lr__list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    #{{ section_id }} .fnop-lr__item {
      width: var(--_lr-slide-w);
      padding-inline-end: var(--_lr-gap);
      box-sizing: border-box;
      flex-shrink: 0;
    }

    #{{ section_id }} .fnop-lr__item:last-child {
      width: var(--_lr-card-w);
      padding-inline-end: 0;
    }

    #{{ section_id }} .fnop-lr__card {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    #{{ section_id }} .fnop-lr__img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      border-radius: var(--radius-sm, 8px);
    }

    #{{ section_id }} .fnop-lr__label {
      display: block;
      margin-top: 12px;
      font-size: var(--font-size--lg);
      font-weight: 600;
      text-align: center;
    }

    /* Arrows — outside the box */
    #{{ section_id }} .fnop-lr__nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: center;
      width: var(--_lr-arrow-size);
      height: var(--_lr-arrow-size);
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.08);
      color: rgb(var(--color-foreground-rgb));
      padding: 0;
      text-decoration: none;
      transition: background 0.2s;
    }

    #{{ section_id }} .fnop-lr__nav:hover {
      background: rgba(0, 0, 0, 0.15);
    }

    #{{ section_id }} .fnop-lr__nav svg {
      width: 20px;
      height: 20px;
    }

    #{{ section_id }} .fnop-lr__nav--prev {
      left: calc(-1 * (var(--_lr-arrow-size) + var(--_lr-arrow-gap)));
    }

    #{{ section_id }} .fnop-lr__nav--next {
      right: calc(-1 * (var(--_lr-arrow-size) + var(--_lr-arrow-gap)));
    }

    /* Mobile: 1 column visible, smaller arrows inline */
    @media (max-width: 749px) {
      #{{ section_id }} {
        --_lr-cols: 1;
        --_lr-arrow-size: 36px;
        --_lr-arrow-gap: 8px;
      }
    }

    /* Tablet: 2 columns */
    @media (min-width: 750px) and (max-width: 1199px) {
      #{{ section_id }} {
        --_lr-cols: 2;
      }
    }
  {% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Latest Releases Carousel",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest Releases"
    },
    {
      "type": "range",
      "id": "games_count",
      "label": "Number of recent games",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Latest Releases Carousel"
    }
  ]
}
{% endschema %}
