{%- liquid
  assign section_id = 'collection-hero-gradient-' | append: section.id
  assign hero_heading = section.settings.heading_override | default: collection.title
  assign hero_subtitle = section.settings.subtitle_override | default: collection.metafields.custom.subtitle
-%}


<section id="{{ section_id }}" class="collection-hero collection-hero--gradient">
  <div class="collection-hero__content">
    <div class="collection-hero__stack">
      <h1 class="collection-hero__h1">{{ hero_heading }}</h1>

      {%- if hero_subtitle != blank -%}
        <p class="collection-hero__subtitle">{{ hero_subtitle }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  {% comment %} ── Shared hero band styles (height, content layout, typography) ── {% endcomment %}
  {%- render 'collection-hero-styles', hero_id: section_id, hero_bg_color: '#0C0C0E', hero_min_height: false -%}

  {% comment %} ── Category hero overrides (scoped — shared snippet stays untouched) ── {% endcomment %}
  #{{ section_id }} .collection-hero__h1 {
    font-family: var(--font-h2--family, var(--font-h1--family)), sans-serif;
    color: var(--color-surface-cream);
    text-shadow: none;
    display: flex;
    align-items: baseline;
    flex-wrap: nowrap;
    gap: 14px;
    width: 100%;
  }

  #{{ section_id }} .collection-hero__h1::before,
  #{{ section_id }} .collection-hero__h1::after {
    content: '';
    flex: 0 0 72px;
    /* Height follows the font so the ornament is never taller than the letters.
       Cap height for this face measures 0.831em, so 0.65em is always ~78% of it,
       at any font size and any viewport. Percentage gradient stops resolve against
       the box height, so the stripe count stays constant as the height scales —
       at 31px this is identical to the previous 4px stripe / 9px period. */
    height: 0.65em;
    /* Baseline-aligned like a glyph: this offset puts the bar's centre on the optical
       centre of the capitals. Caps for this face measure 0.820em ascent / 0.011em
       descent, so their centre is 0.4045em above the baseline; the bar is 0.65em tall,
       so its bottom sits 0.4045 - 0.325 = 0.0795em up. In em, so it never needs
       re-tuning per breakpoint. Measured error: -0.01px at 32, 40 and 48px.
       Do NOT replace this with align-self: center — that centres on the line box, not
       the capitals, and is 3-6px off, worse as the font grows. */
    margin-block-end: 0.08em;
    background: repeating-linear-gradient(
      currentcolor 0 12.9%,
      transparent 12.9% 29.03%
    );
  }

  @media (max-width: 749px) {
    /* justify-content centres the [bar · title · bar] group — the H1 is flex-start
       by default, so without this the group collapses to the left edge. */
    #{{ section_id }} .collection-hero__h1 {
      gap: 10px;
      justify-content: center;
    }

    #{{ section_id }} .collection-hero__h1::before {
      display: block;
    }

    #{{ section_id }} .collection-hero__h1::before,
    #{{ section_id }} .collection-hero__h1::after {
      /* flex-basis 0 means the bars add nothing to the line's base size, so there is
         never a deficit and the title is never asked to shrink — the bars simply take
         what is left, up to the desktop width. A larger flex-shrink does NOT work:
         flexbox still takes a sliver (measured 0.12px) off the title, which is enough
         to wrap it. */
      flex: 1 1 0;
      max-width: 72px;
      min-width: 0;
    }
  }

  #{{ section_id }} .collection-hero__stack {
    max-width: 100%;
    width: 100%;
  }

  #{{ section_id }} .collection-hero__subtitle {
    max-width: none;
    color: rgb(247 242 234 / 0.75);
    text-shadow: none;
  }

  @media (max-width: 749px) {
    #{{ section_id }} .collection-hero__subtitle {
      /* P30 centred the H1 between two ornament bars, so the subtitle follows.
         This deliberately reverses P27 TASK 2. */
      text-align: center;
    }
  }

  #{{ section_id }} .collection-hero__content {
    align-items: center;
  }

  {% comment %} ── Gradient modifier: charcoal gradient over a dark base ── {% endcomment %}
  #{{ section_id }}.collection-hero--gradient {
    background-color: #0C0C0E;
    background-image: linear-gradient(115deg, #2B2A2E 0%, #17171A 45%, #0A0A0C 100%);
  }

  {% comment %} Logo-red rule anchoring the band to the brand {% endcomment %}
  #{{ section_id }}.collection-hero--gradient::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background: rgb(255 0 0 / 0.9);
    pointer-events: none;
  }

  {% comment %} ── No scrim needed — gradient IS the background ── {% endcomment %}
  #{{ section_id }}.collection-hero--gradient::before {
    display: none;
  }

  {% comment %} ── Breathing room between hero and toolbar on category grids ── {% endcomment %}
  [data-template="collection.category"] .collection-wrapper {
    margin-top: 48px;
  }

  {% comment %} ── Category grid card overrides ── {% endcomment %}
  [data-template="collection.category"] .product-grid {
    gap: 20px;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 750px) {
    [data-template="collection.category"] .product-grid {
      gap: 32px;
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 900px) {
    [data-template="collection.category"] .product-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  {% comment %} ── Zoom-out: denser grid with title, price and badge still visible ── {% endcomment %}
  [data-template="collection.category"] .product-grid[product-grid-view='zoom-out'] {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (min-width: 750px) {
    [data-template="collection.category"] .product-grid[product-grid-view='zoom-out'] {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 900px) {
    [data-template="collection.category"] .product-grid[product-grid-view='zoom-out'] {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  @media (min-width: 1200px) {
    [data-template="collection.category"] .product-grid[product-grid-view='zoom-out'] {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  {% comment %} ── Keep title, price and badge visible in zoom-out (out-specify base.css) ── {% endcomment %}
  [data-template="collection.category"] ul[product-grid-view='zoom-out'] .product-grid__card > * {
    display: revert;
  }

  {% comment %} ── Hide Horizon's compact zoom-out block (duplicates the normal title) ── {% endcomment %}
  [data-template="collection.category"] ul[product-grid-view='zoom-out'] .product-grid-view-zoom-out--details {
    display: none;
  }

  [data-template="collection.category"] [product-grid-view='zoom-out'] .card-gallery > .product-badges {
    display: revert;
  }

  [data-template="collection.category"] {
    --cat-title-lines: 3;
  }

  [data-template="collection.category"] .product-card,
  [data-template="collection.category"] .product-card__content {
    height: 100%;
  }

  [data-template="collection.category"] .product-card__content {
    background: var(--color-surface-cream);
    border-radius: var(--radius-sm, 8px);
    padding: 12px;
  }

  [data-template="collection.category"] .card-gallery {
    border-radius: calc(var(--radius-sm, 8px) - 12px);
    overflow: hidden;
    background: transparent;
  }

  [data-template="collection.category"] .product-card__content > a.contents > .text-block p {
    display: -webkit-box;
    -webkit-line-clamp: var(--cat-title-lines);
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  [data-template="collection.category"] product-price {
    margin-top: auto;
  }

  [data-template="collection.category"] .product-card h3.h4 {
    font-family: var(--font-accent--family, var(--font-h1--family));
    font-size: var(--font-size--xl);
  }

  [data-template="collection.category"] .product-card .price {
    font-family: var(--font-body--family);
    font-size: var(--font-size--xl);
    font-weight: 500;
  }

  {% comment %} ── Sold-out badge: match .bmc__badge appearance ── {% endcomment %}
  [data-template="collection.category"] .product-badges__badge {
    font-size: var(--font-size--2xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1;
    padding: 4px 10px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Category hero (gradient)",
  "settings": [
    {
      "type": "text",
      "id": "heading_override",
      "label": "Heading override",
      "info": "Leave blank to use the collection title"
    },
    {
      "type": "textarea",
      "id": "subtitle_override",
      "label": "Subtitle override",
      "info": "Leave blank to use custom.subtitle"
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
