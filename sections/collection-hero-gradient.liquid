{%- liquid
  assign section_id = 'collection-hero-gradient-' | append: section.id
  assign subtitle = collection.metafields.custom.subtitle
-%}


<section id="{{ section_id }}" class="collection-hero collection-hero--gradient">
  <div class="collection-hero__content">
    <div class="collection-hero__stack">
      <h1 class="collection-hero__h1">{{ collection.title }}</h1>

      {%- if subtitle != blank -%}
        <p class="collection-hero__subtitle">{{ subtitle }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  {% comment %} ── Shared hero band styles (height, content layout, typography) ── {% endcomment %}
  {%- render 'collection-hero-styles', hero_id: section_id, hero_bg_color: '#14141F', hero_min_height: false -%}

  {% comment %} ── Gradient modifier: layered radials over a dark base ── {% endcomment %}
  #{{ section_id }}.collection-hero--gradient {
    background-color: #14141F;
    background-image:
      radial-gradient(120% 90% at 12% 110%, rgb(255 0 0 / 0.55) 0%, transparent 60%),
      radial-gradient(90% 70% at 88% -10%, rgb(255 0 0 / 0.22) 0%, transparent 55%),
      linear-gradient(160deg, #1A1A2E 0%, #0B0B12 100%);
  }

  {% comment %} ── No scrim needed — gradient IS the background ── {% endcomment %}
  #{{ section_id }}.collection-hero--gradient::before {
    display: none;
  }

  {% comment %} ── Category grid card overrides ── {% endcomment %}
  [data-template="collection.category"] .product-grid {
    gap: 20px;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 750px) {
    [data-template="collection.category"] .product-grid {
      gap: 32px;
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 900px) {
    [data-template="collection.category"] .product-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1200px) {
    [data-template="collection.category"] .product-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  [data-template="collection.category"] {
    --cat-title-lines: 3;
  }

  [data-template="collection.category"] .product-card,
  [data-template="collection.category"] .product-card__content {
    height: 100%;
  }

  [data-template="collection.category"] .product-card__content {
    background: rgb(var(--color-foreground-rgb) / 0.04);
    border-radius: var(--radius-sm, 8px);
    padding: 12px;
  }

  [data-template="collection.category"] .card-gallery {
    border-radius: calc(var(--radius-sm, 8px) - 12px);
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  [data-template="collection.category"] .product-card__content > a.contents > .text-block p {
    display: -webkit-box;
    -webkit-line-clamp: var(--cat-title-lines);
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  [data-template="collection.category"] product-price {
    margin-top: auto;
  }

  [data-template="collection.category"] .product-card h3.h4 {
    font-family: var(--font-accent--family, var(--font-h1--family));
    font-size: var(--font-size--xl);
  }

  [data-template="collection.category"] .product-card .price {
    font-family: var(--font-body--family);
    font-size: var(--font-size--xl);
    font-weight: 500;
  }
{% endstyle %}

{% schema %}
{
  "name": "Category hero (gradient)",
  "settings": [],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
