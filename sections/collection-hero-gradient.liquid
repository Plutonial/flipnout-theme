{%- liquid
  assign section_id = 'collection-hero-gradient-' | append: section.id
  assign hero_heading = section.settings.heading_override | default: collection.title
  assign hero_subtitle = section.settings.subtitle_override | default: collection.metafields.custom.subtitle
-%}


<section id="{{ section_id }}" class="collection-hero collection-hero--gradient">
  <div class="collection-hero__content">
    <div class="collection-hero__stack">
      <h1 class="collection-hero__h1">{{ hero_heading }}</h1>

      {%- if hero_subtitle != blank -%}
        <p class="collection-hero__subtitle">{{ hero_subtitle }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  {% comment %} ── Shared hero band styles (height, content layout, typography) ── {% endcomment %}
  {%- render 'collection-hero-styles', hero_id: section_id, hero_bg_color: '#0C0C0E', hero_min_height: false -%}

  {% comment %} ── Category hero overrides (scoped — shared snippet stays untouched) ── {% endcomment %}
  #{{ section_id }} .collection-hero__h1 {
    font-family: var(--font-h2--family, var(--font-h1--family)), sans-serif;
    color: var(--color-surface-cream, #F7F2EA);
    text-shadow: none;
    display: flex;
    align-items: baseline;
    flex-wrap: nowrap;
    gap: 14px;
    width: 100%;
  }


  @media (max-width: 749px) {
    /* justify-content centres the title on mobile — the H1 is flex-start by default,
       so without this it sits at the left edge. */
    #{{ section_id }} .collection-hero__h1 {
      gap: 10px;
      justify-content: center;
    }

  }

  #{{ section_id }} .collection-hero__stack {
    max-width: 100%;
    width: 100%;
  }

  #{{ section_id }} .collection-hero__subtitle {
    max-width: none;
    color: rgb(247 242 234 / 0.75);
    text-shadow: none;
  }

  @media (max-width: 749px) {
    #{{ section_id }} .collection-hero__subtitle {
      /* P30 centred the H1 between two ornament bars, so the subtitle follows.
         This deliberately reverses P27 TASK 2. */
      text-align: center;
    }
  }

  #{{ section_id }} .collection-hero__content {
    align-items: center;
  }

  {% comment %} ── Gradient modifier: charcoal gradient over a dark base ── {% endcomment %}
  #{{ section_id }}.collection-hero--gradient {
    background-color: #0C0C0E;
    background-image: linear-gradient(115deg, #2B2A2E 0%, #17171A 45%, #0A0A0C 100%);
  }

  {% comment %} Logo-red rule anchoring the band to the brand {% endcomment %}
  #{{ section_id }}.collection-hero--gradient::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background: rgb(255 0 0 / 0.9);
    pointer-events: none;
  }

  {% comment %} ── No scrim needed — gradient IS the background ── {% endcomment %}
  #{{ section_id }}.collection-hero--gradient::before {
    display: none;
  }

  {% comment %} ── Breathing room between hero and toolbar on category grids ── {% endcomment %}
  [data-template="collection.category"] .collection-wrapper {
    margin-top: 48px;
  }

{% endstyle %}

{% schema %}
{
  "name": "Category hero (gradient)",
  "settings": [
    {
      "type": "text",
      "id": "heading_override",
      "label": "Heading override",
      "info": "Leave blank to use the collection title"
    },
    {
      "type": "textarea",
      "id": "subtitle_override",
      "label": "Subtitle override",
      "info": "Leave blank to use custom.subtitle"
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
