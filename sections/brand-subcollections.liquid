{%- liquid
  comment
    Brand Accessories Grid.
    Uses paginate to access up to 50 products (Shopify's max page size).
    Only page 1 is rendered — Shopify Liquid cannot server-render beyond 50
    in a single section without pagination controls. The "View all" CTA
    links to the full filtered listing for brands that exceed 50 accessories.
  endcomment
-%}

{%- comment %} ── Count accessories and collect them via paginate ── {% endcomment %}
{% paginate collection.products by 50 %}
  {%- assign accessory_count = 0 -%}
  {%- for p in collection.products -%}
    {%- if p.type == 'Accessory' -%}
      {%- assign accessory_count = accessory_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if accessory_count > 0 -%}

<brand-accessories-grid class="bacc" data-initial="12" data-step="12">
  <section id="brand-accessories">
    <div class="brand-section__container">
      <h2 class="brand-section__heading">{{ collection.title }} {{ section.settings.heading_accessories | default: 'Accessories' }}</h2>

      <ul class="bacc__grid" role="list">
        {%- for p in collection.products -%}
          {%- if p.type == 'Accessory' -%}
            <li class="bacc__item" id="{{ section.id }}-acc-{{ p.id }}">
              <div class="bmc--square">
                {%- render 'brand-machine-card', product: p, game_name: '' -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <button class="bacc__more" type="button" hidden>Show more</button>

      <div class="brand-section__cta-wrap">
        <a class="brand-section__cta" href="/collections/{{ collection.handle }}?filter.product_type=Accessory">
          View all {{ collection.title }} accessories
        </a>
      </div>
    </div>
  </section>
</brand-accessories-grid>

{%- comment %} ── Web Component: brand-accessories-grid (reveal mechanic) ── {% endcomment %}
<script>
  if (!customElements.get('brand-accessories-grid')) {
    class BrandAccessoriesGrid extends HTMLElement {
      connectedCallback() {
        this.grid = this.querySelector('.bacc__grid');
        this.items = Array.from(this.querySelectorAll('.bacc__item'));
        this.btn = this.querySelector('.bacc__more');
        this.initial = parseInt(this.dataset.initial, 10) || 12;
        this.step = parseInt(this.dataset.step, 10) || 12;
        this.clicks = 0;

        this.update();

        if (this.btn) {
          this.btn.addEventListener('click', () => {
            var limit = this.revealLimit(this.items.length, this.clicks);
            if (limit >= this.items.length) {
              this.clicks = 0;
            } else {
              this.clicks++;
            }
            this.update();
          });
        }

        this._onResize = () => this.update();
        window.addEventListener('resize', this._onResize);
      }

      disconnectedCallback() {
        window.removeEventListener('resize', this._onResize);
      }

      get columns() {
        var t = getComputedStyle(this.grid).gridTemplateColumns;
        return t && t !== 'none' ? t.split(' ').filter(Boolean).length : 1;
      }

      revealLimit(total, clicks) {
        var target = this.initial + clicks * this.step;
        var cols = this.columns;
        return Math.min(total, Math.ceil(target / cols) * cols);
      }

      update() {
        var total = this.items.length;
        var limit = this.revealLimit(total, this.clicks);

        for (var i = 0; i < total; i++) {
          if (i >= limit) {
            this.items[i].classList.add('bacc__item--beyond');
          } else {
            this.items[i].classList.remove('bacc__item--beyond');
          }
        }

        if (this.btn) {
          if (total <= this.initial) {
            this.btn.hidden = true;
          } else if (limit >= total) {
            this.btn.hidden = false;
            this.btn.textContent = 'Show less';
          } else {
            this.btn.hidden = false;
            var nextLimit = this.revealLimit(total, this.clicks + 1);
            var more = nextLimit - limit;
            var remaining = total - limit;
            this.btn.textContent = 'Show ' + more + ' more \u00B7 ' + remaining + ' remaining';
          }
        }
      }
    }
    customElements.define('brand-accessories-grid', BrandAccessoriesGrid);
  }
</script>

  {%- endif -%}
{% endpaginate %}

{% style %}
  {% comment %} ── Shared section styles ── {% endcomment %}
  .brand-section__container {
    max-width: var(--page-width, 1520px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 16px);
  }

  .brand-section__heading {
    text-align: center;
    font-size: var(--font-size--4xl);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 clamp(32px, 4vw, 56px);
  }

  .brand-section__cta-wrap {
    text-align: center;
    margin-top: clamp(24px, 3vw, 40px);
  }

  .brand-section__cta {
    display: inline-block;
    padding: 12px 28px;
    border: 2px solid currentColor;
    border-radius: var(--radius-sm, 8px);
    font-size: var(--font-size--sm);
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .brand-section__cta:hover {
    background: rgb(var(--color-foreground-rgb));
    color: rgb(var(--color-background-rgb));
  }

  {% comment %} ── Accessories grid ── {% endcomment %}
  #brand-accessories {
    padding-block: clamp(48px, 8vw, 120px);
  }

  .bacc__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 750px) {
    .bacc__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 900px) {
    .bacc__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
    }
  }

  @media (min-width: 1200px) {
    .bacc__grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .bacc__item {
    min-width: 0;
  }

  .bacc__item--beyond {
    display: none;
  }

  {% comment %} Square aspect-ratio modifier for accessory cards {% endcomment %}
  .bmc--square .bmc__poster {
    aspect-ratio: 1 / 1;
  }

  .bacc__more[hidden] { display: none; }

  .bacc__more {
    display: block;
    margin: 32px auto 0;
    padding: 12px 28px;
    border: 2px solid rgba(0, 0, 0, 0.81);
    border-radius: var(--radius-sm, 8px);
    font-size: var(--font-size--sm);
    font-weight: 600;
    background-color: transparent;
    color: rgba(0, 0, 0, 0.81);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .bacc__more:hover {
    background: rgb(var(--color-foreground-rgb));
    color: rgb(var(--color-background-rgb));
  }
{% endstyle %}

{% schema %}
{
  "name": "Brand subcollections",
  "settings": [
    { "type": "text", "id": "heading_accessories", "label": "Accessories heading", "default": "Accessories" }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
