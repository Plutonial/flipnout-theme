{%- liquid
  comment
    Brand Accessories Grid.
    Server-renders up to 50 accessories (SEO floor / no-JS fallback).
    "See all" links to /collections/accessories filtered by vendor.
  endcomment
-%}

{%- comment %} ── Count accessories and collect them via paginate ── {% endcomment %}
{%- assign page_size = 50 -%}
{% paginate collection.products by page_size %}
  {%- assign accessory_count = 0 -%}
  {%- for p in collection.products -%}
    {%- if p.type == 'Accessory' -%}
      {%- assign accessory_count = accessory_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if accessory_count > 0 -%}

    {%- assign vendor = collection.products.first.vendor -%}

<div class="bacc">
  <section id="brand-accessories">
    <div class="brand-section__container">
      <h2 class="brand-section__heading">{{ collection.title }} {{ section.settings.heading_accessories | default: 'Accessories' }}</h2>

      <ul class="bacc__grid bacc--precut" role="list">
        {%- for p in collection.products -%}
          {%- if p.type == 'Accessory' -%}
            <li class="bacc__item" id="{{ section.id }}-acc-{{ p.id }}">
              <div class="bmc--square">
                {%- render 'brand-machine-card', product: p -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <div class="bacc__controls">
        <a class="bacc__see-all" href="/collections/accessories?filter.p.vendor={{ vendor | url_encode }}">All Accessories</a>
      </div>
    </div>
  </section>
</div>


  {%- endif -%}
{% endpaginate %}

{% style %}
  {% comment %} ── Shared section styles ── {% endcomment %}
  .brand-section__container {
    max-width: var(--page-width, 1520px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 16px);
  }

  .brand-section__heading {
    text-align: center;
    font-size: var(--font-size--4xl);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 clamp(32px, 4vw, 56px);
  }

  {% comment %} ── Accessories grid ── {% endcomment %}
  #brand-accessories {
    padding-block: clamp(48px, 8vw, 120px);
  }

  .bacc__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 750px) {
    .bacc__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 900px) {
    .bacc__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
    }
  }

  @media (min-width: 1200px) {
    .bacc__grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .bacc__item {
    min-width: 0;
  }


  {% comment %}
    CSS pre-cut: hide items beyond 3 rows before JS takes over.
    N = 3 × columns + 1, matching the grid-template-columns ladder.
  {% endcomment %}
  .bacc--precut .bacc__item:nth-child(n + 7) { display: none; }   /* 2 cols × 3 = 6 */
  @media (min-width: 750px)  { .bacc--precut .bacc__item:nth-child(n + 7)  { display: list-item; }
                               .bacc--precut .bacc__item:nth-child(n + 10) { display: none; } } /* 3 cols × 3 = 9 */
  @media (min-width: 900px)  { .bacc--precut .bacc__item:nth-child(n + 10) { display: list-item; }
                               .bacc--precut .bacc__item:nth-child(n + 13) { display: none; } } /* 4 cols × 3 = 12 */
  @media (min-width: 1200px) { .bacc--precut .bacc__item:nth-child(n + 13) { display: list-item; }
                               .bacc--precut .bacc__item:nth-child(n + 16) { display: none; } } /* 5 cols × 3 = 15 */

  {% comment %} Square aspect-ratio modifier for accessory cards {% endcomment %}
  .bmc--square .bmc__poster {
    aspect-ratio: 1 / 1;
  }

  {% comment %} ── Controls ── {% endcomment %}
  .bacc__controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 32px;
  }

  @media (max-width: 749px) {
    .bacc__controls {
      flex-direction: column;
      align-items: stretch;
    }
  }

  .bacc__see-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 12px 28px;
    border: 2px solid rgb(var(--color-foreground-rgb) / 0.81);
    border-radius: var(--radius-sm, 8px);
    font-size: var(--font-size--sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: rgb(var(--color-foreground-rgb) / 0.81);
    background-color: transparent;
    transition: background-color 0.2s, color 0.2s;
  }

  .bacc__see-all:hover {
    background: rgb(var(--color-foreground-rgb));
    color: rgb(var(--color-background-rgb));
  }
{% endstyle %}

{% schema %}
{
  "name": "Brand subcollections",
  "settings": [
    { "type": "text", "id": "heading_accessories", "label": "Accessories heading", "default": "Accessories" }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
