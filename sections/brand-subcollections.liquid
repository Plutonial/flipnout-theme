{%- liquid
  assign section_id = 'brand-subcollections-' | append: section.id
-%}

{% comment %} ── SECTION 2: MACHINES SLIDER ── {% endcomment %}
<section id="brand-machines" class="brand-machines">
  <div class="brand-section__container">
    <h2 class="brand-section__heading">{{ collection.title }} {{ section.settings.heading_machines | default: 'Machines' }}</h2>

    <brand-slider class="brand-slider brand-slider--machines" data-slides-desktop="3" data-slides-mobile="1.5">
      <div class="brand-slider__track" role="list">
        {%- assign shown = 0 -%}
        {%- for product in collection.products -%}
          {%- if shown >= 12 -%}{% break %}{%- endif -%}
          {%- if product.type contains 'Pinball Machine' or product.type contains 'Arcade Machine' -%}
            <div role="listitem" class="brand-slider__slide">
              {%- render 'fnop-product-card',
                product_card_product: product,
                product_card_title: product.title,
                product_card_link: true
              -%}
            </div>
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <button class="brand-slider__arrow brand-slider__arrow--prev" aria-label="Previous" disabled>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button class="brand-slider__arrow brand-slider__arrow--next" aria-label="Next">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>

      <div class="brand-slider__dots"></div>
    </brand-slider>

    <div class="brand-section__cta-wrap">
      <a class="brand-section__cta" href="/collections/{{ collection.handle }}?filter.product_type=Pinball+Machine">
        View all {{ collection.title }} machines
      </a>
    </div>
  </div>
</section>

{% comment %} ── SECTION 3: ACCESSORIES GRID ── {% endcomment %}
<section id="brand-accessories" class="brand-accessories">
  <div class="brand-section__container">
    <h2 class="brand-section__heading">{{ collection.title }} {{ section.settings.heading_accessories | default: 'Accessories' }}</h2>

    <div class="brand-accessories__grid" role="list">
      {%- assign shown = 0 -%}
      {%- for product in collection.products -%}
        {%- if shown >= 12 -%}{% break %}{%- endif -%}
        {%- if product.type contains 'Accessory' -%}
          <article role="listitem" class="brand-accessories__card">
            <a href="{{ product.url }}" class="brand-accessories__link">
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 400 | image_tag: class: 'brand-accessories__image', loading: 'lazy', sizes: '(min-width: 750px) 16vw, 45vw', widths: '200,300,400' }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'brand-accessories__image brand-accessories__image--placeholder' }}
              {%- endif -%}
              <div class="brand-accessories__meta">
                <h3 class="brand-accessories__title">{{ product.title }}</h3>
                {% render 'price', product_resource: product, show_unit_price: true %}
              </div>
            </a>
          </article>
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="brand-section__cta-wrap">
      <a class="brand-section__cta" href="/collections/{{ collection.handle }}?filter.product_type=Accessory">
        View all {{ collection.title }} accessories
      </a>
    </div>
  </div>
</section>

{% comment %} ── WEB COMPONENT: brand-slider ── {% endcomment %}
<script>
  if (!customElements.get('brand-slider')) {
    class BrandSlider extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.brand-slider__track');
        this.slides = this.querySelectorAll('.brand-slider__slide');
        this.prevBtn = this.querySelector('.brand-slider__arrow--prev');
        this.nextBtn = this.querySelector('.brand-slider__arrow--next');
        this.dotsWrap = this.querySelector('.brand-slider__dots');
        this.currentIndex = 0;

        if (this.slides.length < 2) {
          if (this.prevBtn) this.prevBtn.style.display = 'none';
          if (this.nextBtn) this.nextBtn.style.display = 'none';
          return;
        }

        this.buildDots();
        this.addListeners();
        this.updateState();
      }

      get slidesPerView() {
        var desktop = parseFloat(this.dataset.slidesDesktop) || 3;
        var mobile = parseFloat(this.dataset.slidesMobile) || 1;
        return window.innerWidth >= 750 ? desktop : mobile;
      }

      get maxIndex() {
        return Math.max(0, this.slides.length - Math.floor(this.slidesPerView));
      }

      buildDots() {
        if (!this.dotsWrap) return;
        this.dotsWrap.innerHTML = '';
        var total = this.maxIndex + 1;
        for (var i = 0; i < total; i++) {
          var dot = document.createElement('button');
          dot.className = 'brand-slider__dot';
          dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          dot.dataset.index = i;
          this.dotsWrap.appendChild(dot);
        }
      }

      addListeners() {
        var self = this;
        this.prevBtn.addEventListener('click', function () { self.goTo(self.currentIndex - 1); });
        this.nextBtn.addEventListener('click', function () { self.goTo(self.currentIndex + 1); });
        this.dotsWrap.addEventListener('click', function (e) {
          var dot = e.target.closest('.brand-slider__dot');
          if (dot) self.goTo(parseInt(dot.dataset.index, 10));
        });

        var resizeTimer;
        window.addEventListener('resize', function () {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(function () {
            self.buildDots();
            self.goTo(Math.min(self.currentIndex, self.maxIndex));
          }, 150);
        });
      }

      goTo(index) {
        this.currentIndex = Math.max(0, Math.min(index, this.maxIndex));
        var slide = this.slides[this.currentIndex];
        if (slide) {
          this.track.scrollTo({ left: slide.offsetLeft - this.track.offsetLeft, behavior: 'smooth' });
        }
        this.updateState();
      }

      updateState() {
        this.prevBtn.disabled = this.currentIndex <= 0;
        this.nextBtn.disabled = this.currentIndex >= this.maxIndex;
        var dots = this.dotsWrap.querySelectorAll('.brand-slider__dot');
        dots.forEach(function (d, i) { d.classList.toggle('is-active', i === this.currentIndex); }.bind(this));
      }
    }
    customElements.define('brand-slider', BrandSlider);
  }
</script>

{% style %}
  {% comment %} ── Shared section styles ── {% endcomment %}
  .brand-section__container {
    max-width: var(--page-width, 1520px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 16px);
  }

  .brand-section__heading {
    text-align: center;
    font-size: var(--font-size--4xl);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 clamp(32px, 4vw, 56px);
  }

  .brand-section__cta-wrap {
    text-align: center;
    margin-top: clamp(24px, 3vw, 40px);
  }

  .brand-section__cta {
    display: inline-block;
    padding: 12px 28px;
    border: 2px solid currentColor;
    border-radius: var(--radius-sm, 8px);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .brand-section__cta:hover {
    background: rgb(var(--color-foreground-rgb));
    color: rgb(var(--color-background-rgb));
  }

  {% comment %} ── Machines section ── {% endcomment %}
  #brand-machines {
    padding-block: clamp(48px, 8vw, 120px);
  }

  .brand-slider {
    position: relative;
    display: block;
  }

  .brand-slider__track {
    display: flex;
    gap: clamp(16px, 2vw, 24px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
  }

  .brand-slider__track::-webkit-scrollbar {
    display: none;
  }

  .brand-slider--machines .brand-slider__slide {
    flex: 0 0 calc((100% - clamp(16px, 2vw, 24px) * 0.5) / 1.5);
    scroll-snap-align: start;
  }

  @media (min-width: 750px) {
    .brand-slider--machines .brand-slider__slide {
      flex: 0 0 calc((100% - clamp(16px, 2vw, 24px) * 2) / 3);
    }
  }


  {% comment %} ── Slider arrows ── {% endcomment %}
  .brand-slider__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-100%);
    z-index: 2;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgb(var(--color-border-rgb) / 20%);
    background: rgb(var(--color-background-rgb));
    color: rgb(var(--color-foreground-rgb));
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s, box-shadow 0.2s;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.08);
  }

  .brand-slider__arrow:hover {
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.12);
  }

  .brand-slider__arrow[disabled] {
    opacity: 0.3;
    cursor: default;
  }

  .brand-slider__arrow--prev {
    left: -56px;
  }

  .brand-slider__arrow--next {
    right: -56px;
  }

  @media (max-width: 1350px) {
    .brand-slider__arrow--prev { left: -8px; }
    .brand-slider__arrow--next { right: -8px; }
    .brand-slider__arrow { background: rgb(var(--color-background-rgb) / 0.9); }
  }

  {% comment %} ── Slider dots ── {% endcomment %}
  .brand-slider__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }

  .brand-slider__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: none;
    background: rgb(var(--color-foreground-rgb) / 0.2);
    cursor: pointer;
    padding: 0;
    transition: background 0.2s;
  }

  .brand-slider__dot.is-active {
    background: rgb(var(--color-foreground-rgb) / 0.7);
  }

  {% comment %} ── Accessories section ── {% endcomment %}
  #brand-accessories {
    padding-block: clamp(48px, 8vw, 120px);
  }

  .brand-accessories__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  @media (min-width: 750px) {
    .brand-accessories__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 28px;
    }
  }

  @media (min-width: 1100px) {
    .brand-accessories__grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 32px;
    }
  }

  .brand-accessories__card {
    border-radius: var(--radius-sm, 8px);
    overflow: hidden;
    background: rgb(var(--color-background-rgb));
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.08);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .brand-accessories__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
  }

  .brand-accessories__link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .brand-accessories__image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }

  .brand-accessories__meta {
    padding: 12px;
    display: grid;
    gap: 4px;
  }

  .brand-accessories__title {
    font: inherit;
    font-weight: 600;
    font-size: 13px;
    margin: 0;
  }
{% endstyle %}

{% schema %}
{
  "name": "Brand subcollections",
  "settings": [
    { "type": "text", "id": "heading_machines", "label": "Machines heading", "default": "Machines" },
    { "type": "text", "id": "heading_accessories", "label": "Accessories heading", "default": "Accessories" }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
