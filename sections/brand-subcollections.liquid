{%- liquid
  comment
    Brand Accessories Grid.
    Server-renders up to 50 accessories (SEO floor / no-JS fallback).
    "See all" links to /collections/accessories filtered by vendor.
  endcomment
-%}

{%- comment %} ── Count accessories and collect them via paginate ── {% endcomment %}
{%- assign page_size = 50 -%}
{% paginate collection.products by page_size %}
  {%- assign accessory_count = 0 -%}
  {%- for p in collection.products -%}
    {%- if p.type == 'Accessory' -%}
      {%- assign accessory_count = accessory_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if accessory_count > 0 -%}

    {%- assign vendor = collection.products.first.vendor -%}

<brand-accessories-grid class="bacc" data-initial-rows="3" data-step-rows="3">
  <section id="brand-accessories">
    <div class="brand-section__container">
      <h2 class="brand-section__heading">{{ collection.title }} {{ section.settings.heading_accessories | default: 'Accessories' }}</h2>

      <ul class="bacc__grid" role="list">
        {%- for p in collection.products -%}
          {%- if p.type == 'Accessory' -%}
            <li class="bacc__item" id="{{ section.id }}-acc-{{ p.id }}">
              <div class="bmc--square">
                {%- render 'brand-machine-card', product: p -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <div class="bacc__controls">
        <button class="bacc__more" type="button" hidden>Show more</button>
        <a class="bacc__see-all" href="/collections/accessories?filter.p.vendor={{ vendor | url_encode }}">See all</a>
      </div>
    </div>
  </section>
</brand-accessories-grid>

{%- comment %} ── Web Component: brand-accessories-grid (reveal mechanic, no network) ── {% endcomment %}
<script>
  if (!customElements.get('brand-accessories-grid')) {
    class BrandAccessoriesGrid extends HTMLElement {
      connectedCallback() {
        this.grid = this.querySelector('.bacc__grid');
        this.items = Array.from(this.querySelectorAll('.bacc__item'));
        this.btn = this.querySelector('.bacc__more');
        this.initialRows = parseInt(this.dataset.initialRows, 10) || 3;
        this.stepRows = parseInt(this.dataset.stepRows, 10) || 3;
        this.clicks = 0;

        this.update();

        if (this.btn) {
          this.btn.addEventListener('click', () => {
            var limit = this.revealLimit(this.items.length, this.clicks);
            if (limit >= this.items.length) {
              this.clicks = 0;
            } else {
              this.clicks++;
            }
            this.update();
          });
        }

        this._onResize = () => this.update();
        window.addEventListener('resize', this._onResize);
      }

      disconnectedCallback() {
        window.removeEventListener('resize', this._onResize);
      }

      get columns() {
        var t = getComputedStyle(this.grid).gridTemplateColumns;
        return t && t !== 'none' ? t.split(' ').filter(Boolean).length : 1;
      }

      revealLimit(total, clicks) {
        var cols = this.columns;
        var rows = this.initialRows + clicks * this.stepRows;
        return Math.min(total, rows * cols);
      }

      update() {
        var total = this.items.length;
        var limit = this.revealLimit(total, this.clicks);

        for (var i = 0; i < total; i++) {
          if (i >= limit) {
            this.items[i].classList.add('bacc__item--beyond');
          } else {
            this.items[i].classList.remove('bacc__item--beyond');
          }
        }

        if (this.btn) {
          var initialLimit = this.revealLimit(total, 0);
          if (total <= initialLimit) {
            this.btn.hidden = true;
          } else if (limit >= total) {
            this.btn.hidden = false;
            this.btn.textContent = 'Show less';
          } else {
            this.btn.hidden = false;
            var remaining = total - limit;
            this.btn.textContent = 'Show more \u00B7 ' + remaining + ' remaining';
          }
        }
      }
    }
    customElements.define('brand-accessories-grid', BrandAccessoriesGrid);
  }
</script>

  {%- endif -%}
{% endpaginate %}

{% style %}
  {% comment %} ── Shared section styles ── {% endcomment %}
  .brand-section__container {
    max-width: var(--page-width, 1520px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 16px);
  }

  .brand-section__heading {
    text-align: center;
    font-size: var(--font-size--4xl);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 clamp(32px, 4vw, 56px);
  }

  {% comment %} ── Accessories grid ── {% endcomment %}
  #brand-accessories {
    padding-block: clamp(48px, 8vw, 120px);
  }

  .bacc__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 750px) {
    .bacc__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 900px) {
    .bacc__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
    }
  }

  @media (min-width: 1200px) {
    .bacc__grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .bacc__item {
    min-width: 0;
  }

  .bacc__item--beyond {
    display: none;
  }

  {% comment %} Square aspect-ratio modifier for accessory cards {% endcomment %}
  .bmc--square .bmc__poster {
    aspect-ratio: 1 / 1;
  }

  {% comment %} ── Controls ── {% endcomment %}
  .bacc__controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 32px;
  }

  @media (max-width: 749px) {
    .bacc__controls {
      flex-direction: column;
      align-items: stretch;
    }
  }

  .bacc__more[hidden] { display: none; }

  .bacc__more {
    display: block;
    padding: 12px 28px;
    border: 2px solid rgba(0, 0, 0, 0.81);
    border-radius: var(--radius-sm, 8px);
    font-size: var(--font-size--sm);
    font-weight: 600;
    background-color: transparent;
    color: rgba(0, 0, 0, 0.81);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .bacc__more:hover {
    background: rgb(var(--color-foreground-rgb));
    color: rgb(var(--color-background-rgb));
  }

  .bacc__see-all {
    font-size: var(--font-size--sm);
    color: rgb(var(--color-foreground-rgb) / 0.6);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .bacc__see-all:hover {
    color: rgb(var(--color-foreground-rgb));
  }
{% endstyle %}

{% schema %}
{
  "name": "Brand subcollections",
  "settings": [
    { "type": "text", "id": "heading_accessories", "label": "Accessories heading", "default": "Accessories" }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
