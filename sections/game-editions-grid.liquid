{%- liquid
  assign section_id = 'editions-grid-' | append: section.id
  assign heading = section.settings.heading | default: 'Editions'

  comment
    Sort products by product.edition_order metafield (ascending).
    Liquid sort/sort_natural cannot traverse nested metafield paths,
    so we build the sorted array manually: first collect products that
    have edition_order (positions 1–10), then append any without it.
  endcomment

  assign sorted_handles = ''
  for pos in (1..10)
    assign pos_str = pos | append: ''
    for p in collection.products
      assign eo = p.metafields.product.edition_order.value | append: ''
      if eo == pos_str
        if sorted_handles == ''
          assign sorted_handles = p.handle
        else
          assign sorted_handles = sorted_handles | append: ',' | append: p.handle
        endif
      endif
    endfor
  endfor
  for p in collection.products
    assign eo = p.metafields.product.edition_order.value
    if eo == blank
      if sorted_handles == ''
        assign sorted_handles = p.handle
      else
        assign sorted_handles = sorted_handles | append: ',' | append: p.handle
      endif
    endif
  endfor
  assign sorted_handle_list = sorted_handles | split: ','

  assign products_count = collection.products.size

  assign game_name = collection.title
  assign mfr = collection.metafields.custom.manufacturer.value
  if mfr and mfr.title != blank
    assign prefix = mfr.title | append: ' - '
    if game_name contains prefix and game_name != prefix
      assign game_name = game_name | remove_first: prefix
    endif
  endif
-%}

<div class="{{ section_id }}__band game-section-band game-section-band--white">
<section id="editions" class="{{ section_id }}">
  <h2 class="editions-grid__heading game-section-heading">Shop {{ game_name }} Pinball Editions</h2>

  <div class="editions-grid{% if products_count > 3 %} editions-grid--wrap2{% endif %}">
    {%- for handle in sorted_handle_list -%}
      {%- assign product = collection.products | where: 'handle', handle | first -%}
      {%- if product == blank -%}{%- continue -%}{%- endif -%}
      {%- liquid
        assign card_image = product.metafields.custom.backglass
        unless card_image
          assign card_image = product.featured_image
        endunless

        assign edition_badge = product.metafields.shopify.pinball_machine_edition.value
      -%}

      <div class="editions-grid__card">
        {%- if card_image -%}
          <div class="editions-grid__art">
            {{ card_image | image_url: width: 800 | image_tag:
              loading: 'lazy',
              class: 'editions-grid__img',
              sizes: '(min-width: 750px) 25vw, 100vw',
              widths: '400,600,800'
            }}
          </div>
        {%- endif -%}

        <div class="editions-grid__info">
          {%- if edition_badge != blank -%}
            <span class="editions-grid__badge">{{ edition_badge }}</span>
          {%- endif -%}
          <h3 class="editions-grid__title">{{ product.title }}</h3>
          <span class="editions-grid__price">{{ product.price | money }}</span>
          <a href="{{ product.url }}" class="editions-grid__btn">Shop Now</a>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>
</div>

{% style %}
  {% comment %} ── Shared game-section band tokens (defined once, used by all game sections) ── {% endcomment %}
  .game-section-band {
    --section-bg-cream: #F7F2EA;
    --section-bg-dark: #111;
    width: 100%;
  }

  .game-section-band--white { background: #fff; }
  .game-section-band--cream { background: var(--section-bg-cream); }
  .game-section-band--dark  { background: var(--section-bg-dark); color: #fff; }

  {% comment %} ── Shared heading accent (red rule) ── {% endcomment %}
  .game-section-heading {
    font-family: var(--font-h1--family), sans-serif;
    font-size: var(--font-size--4xl);
    font-weight: 700;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 clamp(24px, 4vw, 48px);
  }

  .game-section-heading::after {
    content: '';
    display: block;
    width: 48px;
    height: 3px;
    background: var(--color-logo-red, #FF0000);
    margin: 12px auto 0;
  }

  .game-section-band--dark .game-section-heading {
    color: #fff;
  }

  #editions {
    padding: clamp(40px, 6vw, 80px) var(--page-margin, 16px);
    max-width: var(--page-content-width, 1200px);
    margin-inline: auto;
  }


  .editions-grid {
    --_grid-gap: var(--gap-2xl, 32px);
    --_container-inner: calc(var(--page-content-width, 1440px) - 2 * var(--page-margin, 40px));
    --_card-w: calc((var(--_container-inner) - 2 * var(--_grid-gap)) / 3);
    display: grid;
    grid-template-columns: repeat(auto-fit, var(--_card-w));
    justify-content: center;
    gap: var(--_grid-gap);
  }

  .editions-grid__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-sm, 8px);
    overflow: hidden;
    background: var(--color-surface, #f5f5f5);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .editions-grid__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
  }

  .editions-grid__art {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .editions-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .editions-grid__info {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .editions-grid__badge {
    display: inline-block;
    font-size: var(--font-size--2xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent, #666);
  }

  .editions-grid__title {
    font-size: var(--font-size--xl);
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .editions-grid__price {
    font-size: var(--font-size--xl);
    font-weight: 500;
    color: var(--color-foreground, #333);
  }

  .editions-grid__btn {
    display: inline-block;
    margin-top: auto;
    padding: 12px 24px;
    background: var(--color-logo-red, #FF0000);
    color: #fff;
    font-size: var(--font-size--xl);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-align: center;
    border-radius: var(--radius-sm, 8px);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .editions-grid__btn:hover {
    transform: scale(1.03);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.15);
  }

  .editions-grid--wrap2 {
    grid-template-columns: repeat(2, var(--_card-w));
  }

  @media (max-width: 749px) {
    .editions-grid,
    .editions-grid--wrap2 {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Game editions grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Editions"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
