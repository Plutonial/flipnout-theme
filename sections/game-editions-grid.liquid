{%- liquid
  assign section_id = 'editions-grid-' | append: section.id
  assign heading = section.settings.heading | default: 'Editions'

  comment
    Sort products by custom.edition_order metafield (ascending).
    Iterate expected positions 1–10, match products by metafield value.
    Products missing the metafield are appended last.
  endcomment

  assign editions = collection.products | sort: 'metafields.custom.edition_order.value'

  assign products_count = collection.products.size
-%}

<div class="{{ section_id }}__band game-section-band game-section-band--white">
<section id="editions" class="{{ section_id }}">
  {%- if heading != blank -%}
    <h2 class="editions-grid__heading game-section-heading">{{ heading }}</h2>
  {%- endif -%}

  <div class="editions-grid">
    {%- for product in editions -%}
      {%- liquid
        assign card_image = product.metafields.custom.backglass
        unless card_image
          assign card_image = product.featured_image
        endunless

        assign edition_badge = product.metafields.shopify.pinball_machine_edition.value
      -%}

      <a href="{{ product.url }}" class="editions-grid__card">
        {%- if card_image -%}
          <div class="editions-grid__art">
            {{ card_image | image_url: width: 800 | image_tag:
              loading: 'lazy',
              class: 'editions-grid__img',
              sizes: '(min-width: 750px) 25vw, 100vw',
              widths: '400,600,800'
            }}
          </div>
        {%- endif -%}

        <div class="editions-grid__info">
          {%- if edition_badge != blank -%}
            <span class="editions-grid__badge">{{ edition_badge }}</span>
          {%- endif -%}
          <h3 class="editions-grid__title">{{ product.title }}</h3>
          <span class="editions-grid__price">{{ product.price | money }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>
</div>

{% style %}
  {% comment %} ── Shared game-section band tokens (defined once, used by all game sections) ── {% endcomment %}
  .game-section-band {
    --section-bg-cream: #F7F2EA;
    --section-bg-dark: #111;
    width: 100%;
  }

  .game-section-band--white { background: #fff; }
  .game-section-band--cream { background: var(--section-bg-cream); }
  .game-section-band--dark  { background: var(--section-bg-dark); color: #fff; }

  {% comment %} ── Shared heading accent (red rule) ── {% endcomment %}
  .game-section-heading {
    font-family: var(--font-h1--family), sans-serif;
    font-size: clamp(24px, 4vw, 40px);
    font-weight: 700;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 clamp(24px, 4vw, 48px);
  }

  .game-section-heading::after {
    content: '';
    display: block;
    width: 48px;
    height: 3px;
    background: var(--color-logo-red, #FF0000);
    margin: 12px auto 0;
  }

  .game-section-band--dark .game-section-heading {
    color: #fff;
  }

  #editions {
    padding: clamp(40px, 6vw, 80px) var(--page-margin, 16px);
    max-width: var(--page-content-width, 1200px);
    margin-inline: auto;
  }


  .editions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(16px, 3vw, 32px);
  }

  .editions-grid__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-sm, 8px);
    overflow: hidden;
    background: var(--color-surface, #f5f5f5);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .editions-grid__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
  }

  .editions-grid__art {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .editions-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .editions-grid__info {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .editions-grid__badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent, #666);
  }

  .editions-grid__title {
    font-size: clamp(16px, 2vw, 20px);
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .editions-grid__price {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-foreground, #333);
  }

  @media (max-width: 749px) {
    .editions-grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Game editions grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Editions"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
