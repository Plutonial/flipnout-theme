{%- liquid
  comment
    "You May Also Like" — other games by the same manufacturer.
    Renders nothing when there are zero other games (e.g. Turner / Yukon Yeti).
    Uses the shared fnop-games-carousel snippet for the full-bleed carousel.
  endcomment

  assign section_id = 'game-ymal-' | append: section.id
  assign brand_id = collection.metafields.custom.manufacturer.value.id
  assign current_id = collection.id

  comment — Pass 1: collect matching game collections (excluding current)
  endcomment
  assign game_handles = ''
  assign game_dates = ''

  for c in collections
    assign is_game = c.metafields.collection.is_game
    if is_game
      assign mfr_ref = c.metafields.custom.manufacturer.value
      if mfr_ref and mfr_ref.id == brand_id and c.id != current_id
        assign rd = c.metafields.custom.release_date.value | default: '1970-01-01'
        if game_handles == ''
          assign game_handles = c.handle
          assign game_dates = rd
        else
          assign game_handles = game_handles | append: '|' | append: c.handle
          assign game_dates = game_dates | append: '|' | append: rd
        endif
      endif
    endif
  endfor

  assign games_count = 0
  if game_handles != ''
    assign game_handle_arr = game_handles | split: '|'
    assign game_date_arr = game_dates | split: '|'
    assign games_count = game_handle_arr.size
  endif
-%}

{%- if games_count > 0 -%}
  {%- liquid
    comment — Pass 2: bubble sort by release_date descending
    endcomment
    assign sorted_handles = game_handle_arr
    assign sorted_dates = game_date_arr

    assign n = games_count | minus: 1
    for i in (1..n)
      assign inner = n | minus: i
      for j in (0..inner)
        assign j1 = j | plus: 1
        assign date_a = sorted_dates[j]
        assign date_b = sorted_dates[j1]
        if date_a < date_b
          assign tmp_h = sorted_handles[j]
          assign tmp_d = sorted_dates[j]

          assign new_handles = ''
          assign new_dates = ''
          for k in (0..n)
            if k == j
              assign h_val = sorted_handles[j1]
              assign d_val = sorted_dates[j1]
            elsif k == j1
              assign h_val = tmp_h
              assign d_val = tmp_d
            else
              assign h_val = sorted_handles[k]
              assign d_val = sorted_dates[k]
            endif
            if new_handles == ''
              assign new_handles = h_val
              assign new_dates = d_val
            else
              assign new_handles = new_handles | append: '|' | append: h_val
              assign new_dates = new_dates | append: '|' | append: d_val
            endif
          endfor
          assign sorted_handles = new_handles | split: '|'
          assign sorted_dates = new_dates | split: '|'
        endif
      endfor
    endfor

    assign sorted_handles_str = sorted_handles | join: '|'
  -%}

  <div class="game-section-band game-section-band--white">
    {%- render 'fnop-games-carousel',
      fnop_carousel_id: section_id,
      fnop_carousel_heading: 'You May Also Like',
      fnop_carousel_handles: sorted_handles_str
    -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "You May Also Like",
  "settings": [],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
