{%- comment -%}
  Accessories row — reads complementary_products metafield directly.
  The Shopify recommendations API returns empty for complementary products,
  so we read the metafield via bracket notation (namespace contains dashes).
  Hidden entirely when no accessories exist — no heading, no wrapper, no spacing.

  Reuses the brand-machine-card snippet and bacc/bmc grid classes from
  brand-machines-grid / brand-subcollections so both pages render identical cards.
{%- endcomment -%}

{%- liquid
  assign accessories = product.metafields["shopify--discovery--product_recommendation"]["complementary_products"].value
  assign has_accessories = false
  if accessories != blank and accessories.size > 0
    assign has_accessories = true
  endif
-%}

{%- if has_accessories -%}
<section id="fnop-accessories-{{ section.id }}" class="fnop-pacc">
  <div class="brand-section__container">
    <h2 class="brand-section__heading game-section-heading">Accessories for this machine</h2>

    <ul class="bacc__grid fnop-pacc__grid" role="list">
      {%- for accessory in accessories -%}
        {%- if accessory == blank -%}{%- continue -%}{%- endif -%}
        <li class="bacc__item">
            {%- render 'brand-machine-card', product: accessory, sizes: '(min-width: 1532px) 238px, (min-width: 1200px) calc(20vw - 68px), (min-width: 900px) calc(25vw - 48px), (min-width: 750px) calc(33.33vw - 56px), calc(50vw - 56px)' -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% style %}
  #fnop-accessories-{{ section.id }} {
    padding-block: clamp(48px, 8vw, 120px);
    --bmc-title-lines: 2;
  }

  {% comment %} ── Container (mirrors brand-section__container) ── {% endcomment %}
  #fnop-accessories-{{ section.id }} .brand-section__container {
    max-width: var(--page-width, 1520px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 16px);
  }

  #fnop-accessories-{{ section.id }} .brand-section__heading {
    text-align: center;
    font-size: var(--font-size--4xl);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 clamp(32px, 4vw, 56px);
  }

  #fnop-accessories-{{ section.id }} .game-section-heading::after {
    content: '';
    display: block;
    width: 48px;
    height: 3px;
    background: var(--color-logo-red, #FF0000);
    margin: 12px auto 0;
  }

  {% comment %} ── Grid (mirrors bacc__grid from brand-subcollections) ── {% endcomment %}
  #fnop-accessories-{{ section.id }} .bacc__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: stretch;
  }

  @media (min-width: 750px) {
    #fnop-accessories-{{ section.id }} .bacc__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 900px) {
    #fnop-accessories-{{ section.id }} .bacc__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
    }
  }

  @media (min-width: 1200px) {
    #fnop-accessories-{{ section.id }} .bacc__grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  #fnop-accessories-{{ section.id }} .bacc__item {
    min-width: 0;
  }

  {% comment %} ── Card (mirrors bmc from brand-machines-grid) ── {% endcomment %}
  #fnop-accessories-{{ section.id }} .bmc {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: rgb(var(--color-foreground-rgb) / 0.04);
    border-radius: var(--radius-sm, 8px);
    padding: 12px;
    height: 100%;
  }

  #fnop-accessories-{{ section.id }} .bmc__poster {
    position: relative;
    border-radius: calc(var(--radius-sm, 8px) - 12px);
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  #fnop-accessories-{{ section.id }} .bmc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #fnop-accessories-{{ section.id }} .bmc__badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 4px 10px;
    border-radius: 4px;
    background: rgb(255 0 0 / 0.7);
    color: rgb(var(--color-background-rgb));
    font-size: var(--font-size--2xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1;
  }

  #fnop-accessories-{{ section.id }} .bmc__title {
    margin: 10px 0 0;
    font-size: var(--font-size--xl);
    font-weight: 600;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: var(--bmc-title-lines);
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(var(--bmc-title-lines) * 1.3em);
  }

  #fnop-accessories-{{ section.id }} .bmc__price {
    margin-top: 4px;
    font-size: var(--font-size--xl);
    font-weight: 500;
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  @media (max-width: 749px) {
    #fnop-accessories-{{ section.id }} {
      --bmc-title-lines: 3;
    }

    #fnop-accessories-{{ section.id }} .bmc__title {
      font-size: var(--font-size--md);
    }

    #fnop-accessories-{{ section.id }} .bmc__price {
      font-size: var(--font-size--md);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Product accessories",
  "settings": [],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
