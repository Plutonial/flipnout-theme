{%- liquid
  comment
    Brand Machines Grid — replaces the old machines carousel.
    Game collection logic (pass 1 + 2) duplicated from brand-games-strip.liquid
    (source of truth). Extract to shared snippet is a separate task.
  endcomment

  assign brand_id = collection.id
  assign heading = section.settings.heading | default: 'Machines'
  assign bmg_card_sizes = '(min-width: 1520px) 435px, (min-width: 900px) calc((100vw - 216px) / 3), (min-width: 750px) calc(50vw - 74px), calc(50vw - 50px)'

  assign oos_mode = section.settings.oos_control | default: 'inherit'
  if oos_mode == 'inherit'
    assign oos_mode = settings.grid_oos_control | default: 'switch-show'
  endif
  assign rows_initial = section.settings.rows_initial | default: 4
  assign rows_step = section.settings.rows_step | default: 4

  comment
    ── Pass 1: collect game collections for this brand ──
    See brand-games-strip.liquid lines ~20-48 for the canonical version.
  endcomment
  assign game_handles = ''
  assign game_dates = ''

  for c in collections
    assign is_game = c.metafields.collection.is_game
    if is_game
      assign mfr_ref = c.metafields.custom.manufacturer.value
      if mfr_ref and mfr_ref.id == brand_id
        assign rd = c.metafields.custom.release_date.value | default: '1970-01-01'
        if game_handles == ''
          assign game_handles = c.handle
          assign game_dates = rd
        else
          assign game_handles = game_handles | append: '|' | append: c.handle
          assign game_dates = game_dates | append: '|' | append: rd
        endif
      endif
    endif
  endfor

  assign games_count = 0
  if game_handles != ''
    assign game_handle_arr = game_handles | split: '|'
    assign game_date_arr = game_dates | split: '|'
    assign games_count = game_handle_arr.size
  endif
-%}

{%- liquid
  comment
    ── Mode 1: brand has game collections ──
  endcomment
  if games_count > 0
    comment
      Pass 2: sort by release_date descending (bubble sort).
      Copied from brand-games-strip.liquid lines ~52-98.
    endcomment
    assign sorted_handles = game_handle_arr
    assign sorted_dates = game_date_arr

    assign n = games_count | minus: 1
    for i in (1..n)
      assign inner = n | minus: i
      for j in (0..inner)
        assign j1 = j | plus: 1
        assign date_a = sorted_dates[j]
        assign date_b = sorted_dates[j1]
        if date_a < date_b
          assign tmp_h = sorted_handles[j]
          assign tmp_d = sorted_dates[j]

          assign new_handles = ''
          assign new_dates = ''
          for k in (0..n)
            if k == j
              assign h_val = sorted_handles[j1]
              assign d_val = sorted_dates[j1]
            elsif k == j1
              assign h_val = tmp_h
              assign d_val = tmp_d
            else
              assign h_val = sorted_handles[k]
              assign d_val = sorted_dates[k]
            endif
            if new_handles == ''
              assign new_handles = h_val
              assign new_dates = d_val
            else
              assign new_handles = new_handles | append: '|' | append: h_val
              assign new_dates = new_dates | append: '|' | append: d_val
            endif
          endfor
          assign sorted_handles = new_handles | split: '|'
          assign sorted_dates = new_dates | split: '|'
        endif
      endfor
    endfor

    comment
      Pass 3+4: for each game (sorted), collect products sorted by edition_order,
      excluding accessories. Pattern from game-editions-grid.liquid lines 14-36.
    endcomment
    assign all_product_handles = ''
    assign all_product_games = ''
    assign total_machines = 0

    for gh in sorted_handles
      assign game_col = collections[gh]
      for pos in (1..10)
        assign pos_str = pos | append: ''
        for p in game_col.products
          if p.type == 'Accessory'
            continue
          endif
          assign eo = p.metafields.product.edition_order.value | append: ''
          if eo == pos_str
            if all_product_handles == ''
              assign all_product_handles = p.handle
              assign all_product_games = gh
            else
              assign all_product_handles = all_product_handles | append: '|' | append: p.handle
              assign all_product_games = all_product_games | append: '|' | append: gh
            endif
            assign total_machines = total_machines | plus: 1
          endif
        endfor
      endfor
      for p in game_col.products
        if p.type == 'Accessory'
          continue
        endif
        assign eo = p.metafields.product.edition_order.value
        if eo == blank
          if all_product_handles == ''
            assign all_product_handles = p.handle
            assign all_product_games = gh
          else
            assign all_product_handles = all_product_handles | append: '|' | append: p.handle
            assign all_product_games = all_product_games | append: '|' | append: gh
          endif
          assign total_machines = total_machines | plus: 1
        endif
      endfor
    endfor

    assign product_handle_arr = all_product_handles | split: '|'
    assign product_game_arr = all_product_games | split: '|'

  else
    comment
      ── Mode 2: no game collections — flat grid from collection.products ──
      If a brand ever exceeds 50 products this grid will truncate silently
      (Shopify caps collection.products at 50 without paginate).
    endcomment
    assign all_product_handles = ''
    assign total_machines = 0

    for p in collection.products
      if p.type == 'Accessory'
        continue
      endif
      if all_product_handles == ''
        assign all_product_handles = p.handle
      else
        assign all_product_handles = all_product_handles | append: '|' | append: p.handle
      endif
      assign total_machines = total_machines | plus: 1
    endfor

    assign product_handle_arr = all_product_handles | split: '|'
  endif
-%}

{%- comment %} Don't render anything if zero machines {% endcomment -%}
{%- if total_machines > 0 -%}

{%- comment %} Count sold-out machines by tag {% endcomment -%}
{%- liquid
  assign sold_out_count = 0
  if games_count > 0
    for i in (0..999)
      if i >= total_machines
        break
      endif
      assign ph = product_handle_arr[i]
      assign pg = product_game_arr[i]
      assign game_col = collections[pg]
      for p in game_col.products
        if p.handle == ph
          if p.tags contains 'sold-out'
            assign sold_out_count = sold_out_count | plus: 1
          endif
          break
        endif
      endfor
    endfor
  else
    for p in collection.products
      if p.type == 'Accessory'
        continue
      endif
      if p.tags contains 'sold-out'
        assign sold_out_count = sold_out_count | plus: 1
      endif
    endfor
  endif
  assign show_oos_switch = false
  if oos_mode != 'always' and sold_out_count > 0 and sold_out_count < total_machines
    assign show_oos_switch = true
  endif
-%}

{%- comment %} Build game name lookup for dropdown labels {% endcomment -%}
{%- if games_count > 0 -%}
  {%- assign game_name_handles = '' -%}
  {%- assign game_name_labels = '' -%}
  {%- for gh in sorted_handles -%}
    {%- assign game_col = collections[gh] -%}
    {%- capture gn -%}{%- render 'fnop-game-name', fnop_game_col: game_col -%}{%- endcapture -%}
    {%- assign gn = gn | strip -%}
    {%- if game_name_handles == '' -%}
      {%- assign game_name_handles = gh -%}
      {%- assign game_name_labels = gn -%}
    {%- else -%}
      {%- assign game_name_handles = game_name_handles | append: '|' | append: gh -%}
      {%- assign game_name_labels = game_name_labels | append: '|' | append: gn -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign gn_handle_arr = game_name_handles | split: '|' -%}
  {%- assign gn_label_arr = game_name_labels | split: '|' -%}
{%- endif -%}

<brand-machines-grid class="bmg" data-rows-initial="{{ rows_initial }}" data-rows-step="{{ rows_step }}">
  <div class="brand-section__container">
    <h2 class="brand-section__heading">{{ collection.title }} {{ heading }}</h2>

    {%- if games_count > 0 -%}
      <div class="bmg__toolbar">
        <select class="bmg__select" aria-label="Filter by game">
          <option value="all">All games ({{ games_count }})</option>
          {%- for i in (0..999) -%}
            {%- if i >= games_count -%}{%- break -%}{%- endif -%}
            <option value="{{ gn_handle_arr[i] }}">{{ gn_label_arr[i] }}</option>
          {%- endfor -%}
        </select>
        {%- if show_oos_switch -%}
          <label class="bmg__switch{% if oos_mode == 'switch-show' %} bmg__switch--on{% endif %}">
            <input type="checkbox" role="switch"{% if oos_mode == 'switch-show' %} checked{% endif %} class="bmg__switch-input">
            <span class="bmg__switch-track" aria-hidden="true"><span class="bmg__switch-thumb"></span></span>
            <span class="bmg__switch-label">Show Out of Stock</span>
          </label>
        {%- endif -%}
        {%- render 'grid-cols-toggle' -%}
      </div>
    {%- endif -%}

    <ul class="bmg__grid" data-cols="{{ settings.grid_columns_desktop | default: '3' }}">
      {%- if games_count > 0 -%}
        {%- comment %} Mode 1: iterate each sorted game, then its edition-ordered products {% endcomment -%}
        {%- for i in (0..999) -%}
          {%- if i >= total_machines -%}{%- break -%}{%- endif -%}
          {%- assign ph = product_handle_arr[i] -%}
          {%- assign pg = product_game_arr[i] -%}
          {%- assign game_col = collections[pg] -%}
          {%- assign card_product = blank -%}
          {%- for p in game_col.products -%}
            {%- if p.handle == ph -%}
              {%- assign card_product = p -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if card_product == blank -%}{%- continue -%}{%- endif -%}
          {%- assign card_game_name = '' -%}
          {%- for gh in gn_handle_arr -%}
            {%- if gh == pg -%}
              {%- assign card_game_name = gn_label_arr[forloop.index0] -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          <li class="bmg__item{% if card_product.tags contains 'sold-out' %} bmg__item--sold-out{% if oos_mode == 'switch-hide' %} bmg__item--oos-hidden{% endif %}{% endif %}" data-game="{{ pg }}" id="{{ section.id }}-{{ card_product.id }}">
            {%- render 'brand-machine-card', product: card_product, sizes: bmg_card_sizes -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- comment %} Mode 2: flat grid from collection.products {% endcomment -%}
        {%- for p in collection.products -%}
          {%- if p.type == 'Accessory' -%}{%- continue -%}{%- endif -%}
          <li class="bmg__item{% if p.tags contains 'sold-out' %} bmg__item--sold-out{% if oos_mode == 'switch-hide' %} bmg__item--oos-hidden{% endif %}{% endif %}" data-game="" id="{{ section.id }}-{{ p.id }}">
            {%- render 'brand-machine-card', product: p, sizes: bmg_card_sizes -%}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    <div class="bmg__empty" hidden>No machines match. Try showing out of stock.</div>
    {%- if games_count > 0 -%}
      <button class="bmg__more" type="button" hidden>Show more</button>
    {%- endif -%}
  </div>
</brand-machines-grid>

{% comment %} ── Web Component: brand-machines-grid ── {% endcomment %}
<script>
  if (!customElements.get('brand-machines-grid')) {
    class BrandMachinesGrid extends HTMLElement {
      connectedCallback() {
        this.grid = this.querySelector('.bmg__grid');
        this.items = Array.from(this.querySelectorAll('.bmg__item'));
        this.select = this.querySelector('.bmg__select');
        this.btn = this.querySelector('.bmg__more');
        this.emptyEl = this.querySelector('.bmg__empty');
        this.switchInput = this.querySelector('.bmg__switch-input');
        this.resultLine = null;
        this.rowsInitial = parseInt(this.dataset.rowsInitial, 10) || 4;
        this.rowsStep = parseInt(this.dataset.rowsStep, 10) || 4;
        this.clicks = 0;
        this.totalMachines = this.items.length;

        this.switchEl = this.querySelector('.bmg__switch');
        if (this.switchEl) {
          this.switchEl.classList.toggle('bmg__switch--on', this.showOOS);
        }

        this.update();

        if (this.select) {
          this.select.addEventListener('change', () => {
            this.clicks = 0;
            this.update();
          });
        }
        if (this.switchInput) {
          this.switchInput.addEventListener('change', () => {
            this.clicks = 0;
            if (this.switchEl) {
              this.switchEl.classList.toggle('bmg__switch--on', this.showOOS);
            }
            this.update();
          });
        }
        if (this.btn) {
          this.btn.addEventListener('click', () => {
            var vis = this.visibleItems;
            var limit = this.revealLimit(vis.length, this.clicks);
            if (limit >= vis.length) {
              this.clicks = 0;
            } else {
              this.clicks++;
            }
            this.update();
          });
        }

        const colsToggle = this.querySelector('.fnop-toggle--desktop');
        if (colsToggle) {
          colsToggle.addEventListener('click', (e) => {
            const btn = e.target.closest('.fnop-toggle-btn');
            if (!btn) return;
            this.grid.style.setProperty('--bmg-desktop-cols', btn.dataset.cols);
            this.grid.dataset.cols = btn.dataset.cols;
            colsToggle.querySelectorAll('.fnop-toggle-btn').forEach(b => {
              b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
            });
            this.update();
          });
        }

        const mobileSizeToggle = this.querySelector('.fnop-toggle--mobile');
        if (mobileSizeToggle) {
          mobileSizeToggle.addEventListener('click', (e) => {
            const btn = e.target.closest('.fnop-toggle-btn');
            if (!btn) return;
            this.grid.style.setProperty('--bmg-cols', btn.dataset.cols);
            this.grid.dataset.mcols = btn.dataset.cols;
            mobileSizeToggle.querySelectorAll('.fnop-toggle-btn').forEach(b => {
              b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
            });
            this.update();
          });
        }

        this._onResize = () => this.update();
        window.addEventListener('resize', this._onResize);
      }

      disconnectedCallback() {
        window.removeEventListener('resize', this._onResize);
      }

      getColumns() {
        const t = getComputedStyle(this.grid).gridTemplateColumns;
        return t && t !== 'none' ? t.split(' ').filter(Boolean).length : 2;
      }

      get showOOS() {
        return this.switchInput ? this.switchInput.checked : true;
      }

      get visibleItems() {
        var filter = this.select ? this.select.value : 'all';
        var showOOS = this.showOOS;
        return this.items.filter(function(item) {
          var matchesGame = filter === 'all' || item.dataset.game === filter;
          var matchesOOS = showOOS || !item.classList.contains('bmg__item--sold-out');
          return matchesGame && matchesOOS;
        });
      }

      revealLimit(total, clicks) {
        var cols = this.getColumns();
        var target = (this.rowsInitial + clicks * this.rowsStep) * cols;
        return Math.min(total, target);
      }

      get isFilterActive() {
        var gameFilter = this.select ? this.select.value !== 'all' : false;
        var oosFilter = this.switchInput ? !this.switchInput.checked : false;
        return gameFilter || oosFilter;
      }

      updateResultLine(vis) {
        var toolbar = this.querySelector('.bmg__toolbar');
        if (!toolbar) return;

        if (this.isFilterActive) {
          if (!this.resultLine) {
            this.resultLine = document.createElement('div');
            this.resultLine.className = 'bmg__result-line';
            this.resultLine.setAttribute('aria-live', 'polite');
          }
          var limit = this.revealLimit(vis.length, this.clicks);
          var shown = Math.min(limit, vis.length);
          this.resultLine.textContent = 'Showing ' + shown + ' of ' + vis.length;
          if (!this.resultLine.parentNode) {
            toolbar.insertAdjacentElement('afterend', this.resultLine);
          }
        } else {
          if (this.resultLine && this.resultLine.parentNode) {
            this.resultLine.parentNode.removeChild(this.resultLine);
          }
        }
      }

      update() {
        var filter = this.select ? this.select.value : 'all';
        var showOOS = this.showOOS;
        var vis = this.visibleItems;
        var limit = this.revealLimit(vis.length, this.clicks);
        var visIndex = 0;

        for (var i = 0; i < this.items.length; i++) {
          var item = this.items[i];
          var matchesGame = filter === 'all' || item.dataset.game === filter;
          var matchesOOS = showOOS || !item.classList.contains('bmg__item--sold-out');

          if (!matchesGame) {
            item.classList.add('bmg__item--filtered');
          } else {
            item.classList.remove('bmg__item--filtered');
          }

          if (!matchesOOS) {
            item.classList.add('bmg__item--oos-hidden');
          } else {
            item.classList.remove('bmg__item--oos-hidden');
          }

          if (matchesGame && matchesOOS) {
            if (visIndex >= limit) {
              item.classList.add('bmg__item--beyond');
            } else {
              item.classList.remove('bmg__item--beyond');
            }
            visIndex++;
          } else {
            item.classList.remove('bmg__item--beyond');
          }
        }

        this.updateResultLine(vis);

        if (this.emptyEl) {
          this.emptyEl.hidden = vis.length > 0;
        }

        if (this.btn) {
          if (vis.length === 0 || vis.length <= this.rowsInitial * this.getColumns()) {
            this.btn.hidden = true;
          } else if (limit >= vis.length) {
            this.btn.hidden = false;
            this.btn.textContent = 'Show less';
          } else {
            this.btn.hidden = false;
            var nextLimit = this.revealLimit(vis.length, this.clicks + 1);
            var more = nextLimit - limit;
            var remaining = vis.length - limit;
            this.btn.textContent = 'Show ' + more + ' more \u00B7 ' + remaining + ' remaining';
          }
        }
      }
    }
    customElements.define('brand-machines-grid', BrandMachinesGrid);
  }
</script>

{% style %}
  .bmg {
    display: block;
    padding-block: clamp(48px, 8vw, 120px);
  }

  .bmg .brand-section__heading {
    text-align: center;
    margin-bottom: 80px;
  }

  {%- render 'brand-toolbar-styles' -%}

  .bmg__result-line {
    text-align: left;
    font-size: var(--font-size--xs);
    color: rgba(0, 0, 0, 0.6);
    margin-top: -12px;
    margin-bottom: 28px;
  }


  .bmg__empty {
    text-align: center;
    font-size: var(--font-size--xs);
    color: rgba(0, 0, 0, 0.6);
    padding: 48px 0;
  }

  .bmg__grid {
    display: grid;
    grid-template-columns: repeat(var(--bmg-cols, var(--bmc-cols-mobile)), 1fr);
    column-gap: var(--bmc-gap-desktop);
    row-gap: var(--bmc-gap-desktop);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 899px) {
    .bmg__grid {
      column-gap: var(--bmc-gap-mobile);
      row-gap: var(--bmc-gap-mobile);
    }
  }

  @media (min-width: 900px) {
    .bmg__grid {
      grid-template-columns: repeat(var(--bmg-desktop-cols, {{ settings.grid_columns_desktop | default: '3' }}), 1fr);
    }
  }

  .bmg__item {
    min-width: 0;
  }

  .bmg__item--filtered,
  .bmg__item--beyond,
  .bmg__item--oos-hidden {
    display: none;
  }

  .bmg__more[hidden] { display: none; }
  .bmg__empty[hidden] { display: none; }

  .bmg__more {
    display: block;
    margin: 32px auto 0;
  }

  @media (max-width: 749px) {
    .bmg .brand-section__heading {
      margin-bottom: 40px;
    }
  }
{% endstyle %}

{%- endif -%}

{% schema %}
{
  "name": "Brand machines grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Machines" },
    {
      "type": "select",
      "id": "oos_control",
      "label": "Out of stock control",
      "options": [
        { "value": "inherit",     "label": "Inherit from theme settings" },
        { "value": "always",      "label": "Always show out of stock" },
        { "value": "switch-show", "label": "Switch, starts showing" },
        { "value": "switch-hide", "label": "Switch, starts hiding" }
      ],
      "default": "inherit"
    },
    { "type": "range", "id": "rows_initial", "label": "Rows before Show More", "min": 1, "max": 10, "step": 1, "default": 4 },
    { "type": "range", "id": "rows_step", "label": "Rows per click", "min": 1, "max": 10, "step": 1, "default": 4 }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
