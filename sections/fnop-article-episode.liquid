{%- comment -%}
  Episode article page — click-to-play player, two-column layout with related rail.
  Template: article.vlog.json
  Styles: snippets/fnop-article-episode-styles.liquid (rendered from theme.liquid)
  Namespace: fnop-ap__*
{%- endcomment -%}

{%- liquid
  comment
    ── Video URL → embed ID ──
    Handles: youtube.com/watch?v=ID, youtu.be/ID, youtube.com/embed/ID, vimeo.com/ID
  endcomment

  assign video_url_raw = article.metafields.episode.video_url.value.url
  assign video_id = ''
  assign video_provider = ''

  if video_url_raw != blank
    if video_url_raw contains 'youtu.be/'
      assign video_provider = 'youtube'
      assign video_id = video_url_raw | split: 'youtu.be/' | last | split: '?' | first | split: '/' | last
    elsif video_url_raw contains 'youtube.com/embed/'
      assign video_provider = 'youtube'
      assign video_id = video_url_raw | split: '/embed/' | last | split: '?' | first | split: '/' | first
    elsif video_url_raw contains 'youtube.com/watch'
      assign video_provider = 'youtube'
      assign video_id = video_url_raw | split: 'v=' | last | split: '&' | first
    elsif video_url_raw contains 'vimeo.com/'
      assign video_provider = 'vimeo'
      assign video_id = video_url_raw | split: 'vimeo.com/' | last | split: '?' | first | split: '/' | last
    endif
  endif

  comment
    ── Related metafields ──
  endcomment

  assign related_collections = article.metafields.episode.related_collections.value
  assign featured_products = article.metafields.episode.featured_products.value

  assign has_related = false
  if related_collections != blank and related_collections.size > 0
    assign has_related = true
  endif

  assign has_featured = false
  if featured_products != blank and featured_products.size > 0
    assign has_featured = true
  endif

  assign has_rail = false
  if has_related or has_featured
    assign has_rail = true
  endif

  assign rail_card_sizes = '(min-width: 900px) 320px, calc(100vw - 32px)'
-%}

<div class="section">
  <div class="spacing-style layout-panel section-content-wrapper fnop-ap__wrapper">

    {%- comment -%} ── Player — full site width, above the grid ── {%- endcomment -%}
    <div class="fnop-ap__player"
        {%- if video_id != blank %} data-video-id="{{ video_id }}" data-video-provider="{{ video_provider }}"{% endif -%}
      >
        {%- if article.image -%}
          {{ article.image | image_url: width: 1920 | image_tag:
            class: 'fnop-ap__poster',
            loading: 'eager',
            sizes: '100vw',
            widths: '400,600,800,1080,1440,1920',
            alt: article.title
          }}
        {%- endif -%}
        {%- if video_id != blank -%}
          <button class="fnop-ap__play" aria-label="Play {{ article.title }}" type="button">
            <svg class="fnop-ap__play-icon" viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
              <path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.63-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="red"/>
              <path d="M45 24 27 14v20" fill="#fff"/>
            </svg>
          </button>
        {%- endif -%}
    </div>

    <div class="fnop-ap__layout{% unless has_rail %} fnop-ap__layout--single{% endunless %}">

      {%- comment -%} ── Left column ── {%- endcomment -%}
      <div class="fnop-ap__main">
        <h1 class="fnop-ap__title">{{ article.title }}</h1>
        <div class="fnop-ap__meta">
          <time class="fnop-ap__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
            {{ article.published_at | date: '%b %-d, %Y' }}
          </time>
        </div>

        {%- comment -%} ── Article body ── {%- endcomment -%}
        <div class="blog-post-content rte">
          {{ article.content }}
        </div>
      </div>

      {%- comment -%} ── Right column (rail) ── {%- endcomment -%}
      {%- if has_rail -%}
        <aside class="fnop-ap__rail">

          {%- if has_related -%}
            <div class="fnop-ap__rail-group fnop-ap__rail-group--games">
              <h3 class="fnop-ap__rail-heading">Featured Games</h3>

              <div class="fnop-ap__rail-slider" uk-slider="finite: true; autoplay: false" data-gc-count="{{ related_collections.size }}">
                <div class="uk-slider-container">
                  <ul class="uk-slider-items fnop-ap__rail-slider-list">
                    {%- for col in related_collections -%}
                      <li class="fnop-ap__rail-slide">
                        <div class="fnop-ap__game-card">
                          {%- if col.image -%}
                            {{ col.image | image_url: width: 720 | image_tag:
                              loading: 'lazy',
                              class: 'fnop-ap__game-card-img',
                              sizes: rail_card_sizes,
                              widths: '360,480,720',
                              alt: col.title
                            }}
                          {%- endif -%}

                          {%- liquid
                            assign _gc_title = col.title
                            assign _gc_mfr = ''
                            if _gc_title contains ' - '
                              assign _gc_parts = _gc_title | split: ' - '
                              assign _gc_mfr = _gc_parts | first
                              assign _gc_title = _gc_parts | last
                            endif
                          -%}

                          <div class="fnop-ap__game-card-body">
                            <p class="fnop-ap__game-card-name">{{ _gc_title }}</p>
                            {%- if _gc_mfr != blank -%}
                              <p class="fnop-ap__game-card-mfr">By: {{ _gc_mfr }}</p>
                            {%- endif -%}
                            {%- if col.metafields.custom.release_date.value != blank -%}
                              <p class="fnop-ap__game-card-date">Release Date: {{ col.metafields.custom.release_date.value | date: '%B %-d, %Y' }}</p>
                            {%- endif -%}
                            <a href="{{ col.url }}" class="fnop-ap__rail-btn fnop-ap__rail-btn--explore">Explore!</a>
                          </div>
                        </div>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
                <ul class="uk-slider-nav uk-dotnav fnop-ap__rail-dotnav"></ul>
              </div>
            </div>
          {%- endif -%}

          {%- if has_related and has_featured -%}
            <hr class="fnop-ap__rail-hr">
          {%- endif -%}

          {%- if has_featured -%}
            <div class="fnop-ap__rail-group fnop-ap__rail-group--machines">
              <h3 class="fnop-ap__rail-heading">Featured Machines</h3>

              <div class="fnop-ap__rail-slider" uk-slider="finite: true; autoplay: false" data-gc-count="{{ featured_products.size }}">
                <div class="uk-slider-container">
                  <ul class="uk-slider-items fnop-ap__rail-slider-list">
                    {%- for p in featured_products -%}
                      <li class="fnop-ap__rail-slide">
                        <div class="fnop-ap__machine-card">
                          {%- if p.featured_image -%}
                            {{ p.featured_image | image_url: width: 720 | image_tag:
                              loading: 'lazy',
                              class: 'fnop-ap__machine-card-img',
                              sizes: rail_card_sizes,
                              widths: '360,480,720',
                              alt: p.title
                            }}
                          {%- endif -%}
                          <div class="fnop-ap__machine-card-body">
                            <p class="fnop-ap__machine-card-title">{{ p.title }}</p>
                            {%- comment -%} Price — replicated from .bmc__price, not coupled {%- endcomment -%}
                            <p class="fnop-ap__machine-card-price">{{ p.price | money }}</p>
                            {%- comment -%} Geometry from .editions-grid__btn — replicated, not coupled {%- endcomment -%}
                            {%- if p.tags contains 'sold-out' -%}
                              <span class="fnop-ap__rail-btn fnop-ap__rail-btn--sold-out" aria-disabled="true">Sold Out</span>
                            {%- else -%}
                              <a href="{{ p.url }}" class="fnop-ap__rail-btn fnop-ap__rail-btn--shop">Shop Now</a>
                            {%- endif -%}
                          </div>
                        </div>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
                <ul class="uk-slider-nav uk-dotnav fnop-ap__rail-dotnav"></ul>
              </div>
            </div>
          {%- endif -%}

        </aside>
      {%- endif -%}

    </div>

  </div>
</div>

<script>
  (function() {
    var players = document.querySelectorAll('.fnop-ap__player[data-video-id]');
    players.forEach(function(player) {
      var btn = player.querySelector('.fnop-ap__play');
      if (!btn) return;
      btn.addEventListener('click', function() {
        var id = player.getAttribute('data-video-id');
        var provider = player.getAttribute('data-video-provider');
        var iframe = document.createElement('iframe');
        iframe.setAttribute('allowfullscreen', '');
        iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture; fullscreen');
        iframe.setAttribute('title', '{{ article.title | escape }}');
        if (provider === 'vimeo') {
          iframe.src = 'https://player.vimeo.com/video/' + id + '?autoplay=1';
        } else {
          iframe.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
        }
        player.textContent = '';
        player.appendChild(iframe);
      });
    });
  })();
</script>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "Episode Article",
  "class": "section-wrapper",
  "settings": [],
  "presets": []
}
{% endschema %}
