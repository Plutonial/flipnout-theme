{%- liquid
  comment
    Brand About + Releases table.
    Renders only when collection.description is present.
    Two-column layout when games exist; full-width About when no games.
  endcomment

  assign has_description = false
  if collection.description != blank
    assign has_description = true
  endif
-%}

{%- if has_description -%}
  {%- liquid
    assign section_id = 'brand-about-' | append: section.id

    comment
      Games derivation — same logic as brand-games-strip.
      Collect game collections belonging to this manufacturer,
      sorted by release_date descending (newest first).
    endcomment
    assign brand_id = collection.id
    assign game_handles = ''
    assign game_dates = ''

    for c in collections
      assign is_game = c.metafields.collection.is_game
      if is_game
        assign mfr_ref = c.metafields.custom.manufacturer.value
        if mfr_ref and mfr_ref.id == brand_id
          assign rd = c.metafields.custom.release_date.value | default: '1970-01-01'
          if game_handles == ''
            assign game_handles = c.handle
            assign game_dates = rd
          else
            assign game_handles = game_handles | append: '|' | append: c.handle
            assign game_dates = game_dates | append: '|' | append: rd
          endif
        endif
      endif
    endfor

    assign games_count = 0
    if game_handles != ''
      assign game_handle_arr = game_handles | split: '|'
      assign game_date_arr = game_dates | split: '|'
      assign games_count = game_handle_arr.size
    endif
  -%}

  {%- if games_count > 0 -%}
    {%- liquid
      comment
        Pass 2: bubble sort by release_date descending.
        Games with missing dates got '1970-01-01' so they sort last.
      endcomment
      assign sorted_handles = game_handle_arr
      assign sorted_dates = game_date_arr

      assign n = games_count | minus: 1
      for i in (1..n)
        assign inner = n | minus: i
        for j in (0..inner)
          assign j1 = j | plus: 1
          assign date_a = sorted_dates[j]
          assign date_b = sorted_dates[j1]
          if date_a < date_b
            assign tmp_h = sorted_handles[j]
            assign tmp_d = sorted_dates[j]

            assign new_handles = ''
            assign new_dates = ''
            for k in (0..n)
              if k == j
                assign h_val = sorted_handles[j1]
                assign d_val = sorted_dates[j1]
              elsif k == j1
                assign h_val = tmp_h
                assign d_val = tmp_d
              else
                assign h_val = sorted_handles[k]
                assign d_val = sorted_dates[k]
              endif
              if new_handles == ''
                assign new_handles = h_val
                assign new_dates = d_val
              else
                assign new_handles = new_handles | append: '|' | append: h_val
                assign new_dates = new_dates | append: '|' | append: d_val
              endif
            endfor
            assign sorted_handles = new_handles | split: '|'
            assign sorted_dates = new_dates | split: '|'
          endif
        endfor
      endfor
    -%}
  {%- endif -%}

  <div class="brand-about__band{% if games_count == 0 %} brand-about__band--full{% endif %}">
  <section id="{{ section_id }}" class="brand-about{% if games_count == 0 %} brand-about--full{% endif %}">
    <div class="brand-about__grid">
      <div class="brand-about__copy">
        <h2 class="brand-about__heading game-section-heading">About {{ collection.title }}</h2>
        {{ collection.description }}
      </div>

      {%- if games_count > 0 -%}
        <div class="brand-about__releases">
          <h2 class="brand-about__heading game-section-heading">Latest Releases</h2>
          <table class="brand-about__table" id="{{ section_id }}-table">
            <thead>
              <tr>
                <th>Game</th>
                <th>Released</th>
                <th>Editions</th>
                <th>From</th>
              </tr>
            </thead>
            <tbody>
              {%- for handle in sorted_handles -%}
                {%- assign game_col = collections[handle] -%}
                {%- if game_col == blank -%}{%- continue -%}{%- endif -%}

                {%- capture game_name -%}{%- render 'fnop-game-name', fnop_game_col: game_col -%}{%- endcapture -%}
                {%- liquid

                  assign rd_raw = game_col.metafields.custom.release_date.value
                  assign rd_display = ''
                  if rd_raw and rd_raw != blank
                    assign rd_display = rd_raw | date: '%B %Y'
                  endif

                  assign edition_count = game_col.products.size
                  assign lowest_price = ''
                  if edition_count > 0
                    for p in game_col.products
                      if lowest_price == '' or p.price < lowest_price
                        assign lowest_price = p.price
                      endif
                    endfor
                  endif
                -%}

                <tr>
                  <td><a href="{{ game_col.url }}">{{ game_name }}</a></td>
                  <td>{{ rd_display | default: '—' }}</td>
                  <td>
                    {%- if edition_count > 0 -%}
                      {{ edition_count }}
                    {%- else -%}
                      —
                    {%- endif -%}
                  </td>
                  <td>
                    {%- if lowest_price != '' and edition_count > 0 -%}
                      {{ lowest_price | money }}
                    {%- else -%}
                      —
                    {%- endif -%}
                  </td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      {%- endif -%}
    </div>
  </section>
  </div>

  {% style %}
    #{{ section_id }} {
      --_about-gap: 48px;
      --_table-col-gap: 24px;

      max-width: var(--page-width, 1520px);
      padding: clamp(40px, 6vw, 80px) var(--page-margin, 16px);
      margin-inline: auto;
    }

    .brand-about__band {
      background: var(--color-surface-cream, #F7F2EA);
    }

    #{{ section_id }} .brand-about__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      row-gap: var(--_about-gap);
      column-gap: 0;
    }

    #{{ section_id }} .brand-about__releases {
      border-left: 1px solid rgba(0, 0, 0, 0.12);
      padding-left: var(--_about-gap);
    }

    #{{ section_id }}.brand-about--full .brand-about__grid {
      grid-template-columns: 1fr;
    }

    #{{ section_id }} .brand-about__heading {
      margin-bottom: 24px;
    }

    #{{ section_id }} .brand-about__copy {
      font-size: var(--font-size--xl);
      line-height: 1.7;
      padding-right: var(--_about-gap);
    }

    #{{ section_id }} .brand-about__table {
      width: 100%;
      border-collapse: collapse;
      font-size: var(--font-size--sm);
    }

    #{{ section_id }} .brand-about__table th,
    #{{ section_id }} .brand-about__table td {
      text-align: left;
      padding: 8px var(--_table-col-gap) 8px 0;
      border-bottom: 1px solid var(--color-border, #e5e5e5);
    }

    #{{ section_id }} .brand-about__table th:last-child,
    #{{ section_id }} .brand-about__table td:last-child {
      padding-right: 0;
    }

    #{{ section_id }} .brand-about__table th {
      font-size: var(--font-size--xs);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      opacity: 0.7;
    }

    #{{ section_id }} .brand-about__table a {
      color: inherit;
      text-decoration: none;
    }

    #{{ section_id }} .brand-about__table a:hover {
      text-decoration: underline;
    }

    @media (max-width: 849px) {
      #{{ section_id }} .brand-about__grid {
        grid-template-columns: 1fr;
      }

      #{{ section_id }} .brand-about__releases {
        border-left: none;
        padding-left: 0;
      }

      #{{ section_id }} .brand-about__copy {
        padding-right: 0;
      }

      #{{ section_id }} .brand-about__table {
        font-size: var(--font-size--xs);
      }
    }

    {% comment %} ── Table toggle button (matches .cbg__more pattern) ── {% endcomment %}
    #{{ section_id }} .brand-about__controls {
      display: flex;
      justify-content: flex-start;
      gap: 20px;
      margin-top: 24px;
    }

    .brand-about__toggle {
      display: block;
    }

    /* Copy-side clamp: fade mask at the bottom when clamped */
    #{{ section_id }} .brand-about__copy-inner[data-clamped] {
      overflow: hidden;
      position: relative;
    }

    #{{ section_id }} .brand-about__copy-inner[data-clamped]::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 3em;
      background: linear-gradient(to bottom, transparent, var(--color-surface-cream, #F7F2EA));
      pointer-events: none;
    }

    {%- render 'fnop-section-heading-mobile' -%}
  {% endstyle %}

  <script>
    (function() {
      var SECTION_ID = '{{ section_id }}';
      var STACKED_BP = 849;
      var MIN_PARAS = 1;
      var debounceTimer;

      function getSection() { return document.getElementById(SECTION_ID); }

      function isStacked() { return window.innerWidth <= STACKED_BP; }

      /* Measure content height below the heading for a column element.
         heading.offsetHeight + its computed marginBottom gives the heading's
         total footprint inside the column.
         IMPORTANT: the column must have align-self: start (or equivalent)
         when measured, otherwise grid stretch makes scrollHeight equal on
         both columns and the comparison is useless. */
      function contentHeightBelowHeading(colEl) {
        var heading = colEl.querySelector('.brand-about__heading');
        if (!heading) return colEl.scrollHeight;
        var mb = parseFloat(getComputedStyle(heading).marginBottom) || 0;
        var hfp = heading.offsetHeight + mb;
        return colEl.scrollHeight - hfp;
      }

      /* Get the heading footprint (height + margin) for a column */
      function headingFootprint(colEl) {
        var heading = colEl.querySelector('.brand-about__heading');
        if (!heading) return 0;
        var mb = parseFloat(getComputedStyle(heading).marginBottom) || 0;
        return heading.offsetHeight + mb;
      }

      /* Compute the clamp height that shows the largest number of
         complete paragraphs fitting within targetH, but always at
         least MIN_PARAS paragraph(s) in full. */
      function paragraphClampHeight(innerEl, targetH) {
        var paras = innerEl.querySelectorAll('p');
        if (!paras.length) return targetH;
        var cumulative = 0;
        var bestH = 0;
        var count = 0;
        for (var i = 0; i < paras.length; i++) {
          var style = getComputedStyle(paras[i]);
          var mt = parseFloat(style.marginTop) || 0;
          var mb = parseFloat(style.marginBottom) || 0;
          var ph = paras[i].offsetHeight + mt + mb;
          cumulative += ph;
          if (cumulative <= targetH) {
            bestH = cumulative;
            count = i + 1;
          } else {
            break;
          }
        }
        /* Always show at least MIN_PARAS */
        if (count < MIN_PARAS) {
          cumulative = 0;
          for (var j = 0; j < Math.min(MIN_PARAS, paras.length); j++) {
            var s = getComputedStyle(paras[j]);
            cumulative += paras[j].offsetHeight + (parseFloat(s.marginTop) || 0) + (parseFloat(s.marginBottom) || 0);
          }
          bestH = cumulative;
        }
        return bestH;
      }

      /* Remove all clamping state */
      function unclamped(section) {
        var copyEl = section.querySelector('.brand-about__copy');
        var relEl = section.querySelector('.brand-about__releases');
        if (copyEl) {
          var innerEl = copyEl.querySelector('.brand-about__copy-inner');
          if (innerEl) {
            innerEl.style.removeProperty('max-height');
            innerEl.removeAttribute('data-clamped');
          }
        }
        if (relEl) {
          /* Show all table rows */
          var rows = relEl.querySelectorAll('.brand-about__table tbody tr');
          rows.forEach(function(tr) { tr.hidden = false; });
        }
        /* Remove any injected toggles */
        section.querySelectorAll('.brand-about__controls--balance').forEach(function(el) { el.remove(); });
      }

      function balance() {
        var section = getSection();
        if (!section) return;

        /* Always reset first so we measure natural heights */
        unclamped(section);

        if (isStacked()) return;

        var copyEl = section.querySelector('.brand-about__copy');
        var relEl = section.querySelector('.brand-about__releases');
        if (!copyEl || !relEl) return;

        /* Temporarily remove grid stretch so scrollHeight reflects
           natural content height, not the stretched grid-row height. */
        copyEl.style.alignSelf = 'start';
        relEl.style.alignSelf = 'start';
        /* Force layout reflow before measuring */
        void copyEl.offsetHeight;

        var copyH = contentHeightBelowHeading(copyEl);
        var relH = contentHeightBelowHeading(relEl);

        /* Restore grid stretch */
        copyEl.style.removeProperty('align-self');
        relEl.style.removeProperty('align-self');

        if (copyH === relH) return;

        var shorter = Math.min(copyH, relH);
        var target = shorter;

        if (copyH > relH) {
          /* Clamp the copy column — wrap content below heading in an
             inner div so max-height + overflow:hidden clips the text
             while the toggle stays visible inside the column. */
          var innerEl = copyEl.querySelector('.brand-about__copy-inner');
          if (!innerEl) {
            innerEl = document.createElement('div');
            innerEl.className = 'brand-about__copy-inner';
            var heading = copyEl.querySelector('.brand-about__heading');
            /* Move all siblings after the heading into the wrapper */
            var node = heading ? heading.nextSibling : copyEl.firstChild;
            while (node) {
              var next = node.nextSibling;
              innerEl.appendChild(node);
              node = next;
            }
            copyEl.appendChild(innerEl);
          }

          /* Measure inner's natural scrollHeight */
          innerEl.style.removeProperty('max-height');
          innerEl.removeAttribute('data-clamped');
          void innerEl.offsetHeight;

          var innerMaxH = paragraphClampHeight(innerEl, target);
          if (innerMaxH >= innerEl.scrollHeight) return; /* nothing to clamp */

          innerEl.style.maxHeight = innerMaxH + 'px';
          innerEl.setAttribute('data-clamped', '');

          /* Inject toggle inside copyEl, after the inner wrapper */
          var wrap = document.createElement('div');
          wrap.className = 'brand-about__controls brand-about__controls--balance';
          var btn = document.createElement('button');
          btn.className = 'brand-about__toggle';
          btn.type = 'button';
          btn.setAttribute('aria-expanded', 'false');
          btn.textContent = 'Read more';
          wrap.appendChild(btn);
          copyEl.appendChild(wrap);

          btn.addEventListener('click', function() {
            var expanded = btn.getAttribute('aria-expanded') === 'true';
            if (expanded) {
              innerEl.style.maxHeight = innerMaxH + 'px';
              innerEl.setAttribute('data-clamped', '');
              btn.setAttribute('aria-expanded', 'false');
              btn.textContent = 'Read more';
            } else {
              innerEl.style.removeProperty('max-height');
              innerEl.removeAttribute('data-clamped');
              btn.setAttribute('aria-expanded', 'true');
              btn.textContent = 'Read less';
            }
          });
        } else {
          /* Clamp the table — hide whole rows only */
          var table = relEl.querySelector('.brand-about__table');
          if (!table) return;
          var tbody = table.querySelector('tbody');
          if (!tbody) return;
          var rows = Array.from(tbody.querySelectorAll('tr'));
          if (rows.length <= 1) return;

          /* thead height */
          var thead = table.querySelector('thead');
          var theadH = thead ? thead.offsetHeight : 0;
          var available = target - theadH;
          if (available <= 0) return;

          /* Measure cumulative row heights to find the last row that fits */
          var cumulative = 0;
          var visibleCount = 0;
          for (var i = 0; i < rows.length; i++) {
            cumulative += rows[i].offsetHeight;
            if (cumulative <= available) {
              visibleCount = i + 1;
            } else {
              break;
            }
          }

          if (visibleCount >= rows.length) return; /* all fit */
          if (visibleCount < 1) visibleCount = 1;

          rows.forEach(function(tr, idx) { if (idx >= visibleCount) tr.hidden = true; });

          /* Inject toggle */
          var wrap = document.createElement('div');
          wrap.className = 'brand-about__controls brand-about__controls--balance';
          var btn = document.createElement('button');
          btn.className = 'brand-about__toggle';
          btn.type = 'button';
          btn.setAttribute('aria-expanded', 'false');
          btn.setAttribute('aria-controls', table.id);
          btn.textContent = 'Show All';
          wrap.appendChild(btn);
          table.parentNode.insertBefore(wrap, table.nextSibling);

          btn.addEventListener('click', function() {
            var expanded = btn.getAttribute('aria-expanded') === 'true';
            if (expanded) {
              rows.forEach(function(tr, idx) { if (idx >= visibleCount) tr.hidden = true; });
              btn.setAttribute('aria-expanded', 'false');
              btn.textContent = 'Show All';
            } else {
              rows.forEach(function(tr) { tr.hidden = false; });
              btn.setAttribute('aria-expanded', 'true');
              btn.textContent = 'Show Less';
            }
          });
        }
      }

      /* Boot */
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() { setTimeout(balance, 50); });
      } else {
        setTimeout(balance, 50);
      }

      /* Resize — debounced */
      window.addEventListener('resize', function() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(balance, 200);
      });

      /* Theme editor */
      document.addEventListener('shopify:section:load', function() { setTimeout(balance, 100); });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Brand about + releases",
  "settings": [],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
