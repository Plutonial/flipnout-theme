{%- liquid
  assign section_id = 'game-highlights-' | append: section.id
  assign highlights = collection.metafields.custom.highlights.value
-%}

{%- if highlights != blank and highlights.size > 0 -%}
{%- comment -%}
  L — Pre-rotate the render order so floor(n/2) is at DOM position 0.
  UIkit center:true centres index 0 on init — no show() needed, so the
  first paint is already the final position. Zero post-paint movement.
  Rotation: render [startIndex..end] then [0..startIndex-1], twice
  (primary + duplicate set for looping).
{%- endcomment -%}
{%- liquid
  assign hl_count = highlights.size
  assign hl_start = hl_count | divided_by: 2
  assign hl_tail = hl_count | minus: hl_start
-%}
<div class="game-section-band game-section-band--cream">
  <section id="{{ section_id }}" class="game-highlights" data-gh-count="{{ hl_count }}">
    <h2 class="game-highlights__heading game-section-heading">Highlights</h2>

    <div uk-lightbox="animation: fade">
      <div class="game-highlights__slider" uk-slider="finite: false; autoplay: false; center: true" data-gh-slider-opts="finite: false; autoplay: false; center: true">
        <div class="uk-position-relative game-highlights__track-wrap">
          <div class="uk-slider-container game-highlights__container">
            <ul class="uk-slider-items game-highlights__list">
              {% comment %} Primary set — rotated so centre card is at index 0 {% endcomment %}
              {%- for feature in highlights offset: hl_start -%}
                {%- render 'fnop-highlight-card', fnop_hl_feature: feature, fnop_hl_is_dup: false -%}
              {%- endfor -%}
              {%- if hl_start > 0 -%}
                {%- for feature in highlights limit: hl_start -%}
                  {%- render 'fnop-highlight-card', fnop_hl_feature: feature, fnop_hl_is_dup: false -%}
                {%- endfor -%}
              {%- endif -%}

              {% comment %}
                K-fix-4 — Duplicate set (same rotation) for UIkit loop track.
                aria-hidden on card element, tabindex=-1 on links, no dup ids.
              {% endcomment %}
              {%- for feature in highlights offset: hl_start -%}
                {%- render 'fnop-highlight-card', fnop_hl_feature: feature, fnop_hl_is_dup: true -%}
              {%- endfor -%}
              {%- if hl_start > 0 -%}
                {%- for feature in highlights limit: hl_start -%}
                  {%- render 'fnop-highlight-card', fnop_hl_feature: feature, fnop_hl_is_dup: true -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </div>

          {% comment %} Overlay arrows — positioned on the image axis, outside track at wide viewports {% endcomment %}
          <a class="game-highlights__nav game-highlights__nav--prev" href uk-slidenav-previous uk-slider-item="previous"></a>
          <a class="game-highlights__nav game-highlights__nav--next" href uk-slidenav-next uk-slider-item="next"></a>
        </div>
      </div>
    </div>
  </section>
</div>

{% comment %}
  Mode logic — identical to fnop-gc (games carousel).
  Fit → centred static group, no slider, no arrows.
  Overflow → uk-slider with center + loop, index 0 is already the centre card
  (items pre-rotated in Liquid — brief L, approach a).
  No show() call — zero post-paint movement.
  K-fix-4: Liquid-duplicated set provides enough track for UIkit to loop.
  In centred/fit mode the duplicates are hidden via display:none.
{% endcomment %}
<script>
  (function() {
    var sectionId = '{{ section_id }}';

    function updateMode() {
      try {
        var section = document.getElementById(sectionId);
        if (!section) return;

        var sliderEl = section.querySelector('.game-highlights__slider');
        if (!sliderEl) return;

        var list = section.querySelector('.game-highlights__list');
        if (!list) return;

        /* Use only the primary (non-duplicate) items for the fit test */
        var primaryItems = list.querySelectorAll('.game-highlights__item:not(.game-highlights__item--dup)');
        if (!primaryItems.length) return;

        var item = primaryItems[0];
        var listStyle = getComputedStyle(list);
        var gapVal = parseFloat(listStyle.columnGap) || parseFloat(listStyle.gap) || 0;
        var itemW = item.offsetWidth + gapVal;
        if (!isFinite(itemW) || itemW <= 0) return;

        /* Fit test uses only the real items, not the duplicates */
        var setW = itemW * primaryItems.length;
        var containerW = section.querySelector('.game-highlights__container').offsetWidth;
        var overflows = setW > containerW;

        /* Toggle mode class — JS only toggles state, never rebuilds markup */
        section.classList.toggle('game-highlights--centred', !overflows);
        section.classList.toggle('game-highlights--carousel', overflows);

        /* Hide/show arrows */
        section.querySelectorAll('.game-highlights__nav').forEach(function(nav) {
          if (overflows) { nav.removeAttribute('hidden'); } else { nav.setAttribute('hidden', ''); }
        });

        /* In fits mode: remove uk-slider so no transform is applied.
           In overflow mode: restore it so the carousel works with center + loop.
           Items are pre-rotated in Liquid so index 0 is the centre card —
           no show() needed, UIkit centres index 0 on init. */
        var initSlider = function () {
          if (!window.UIkit) return false;

          if (overflows) {
            if (!sliderEl.hasAttribute('uk-slider')) {
              sliderEl.setAttribute('uk-slider', sliderEl.getAttribute('data-gh-slider-opts'));
              UIkit.slider(sliderEl, { finite: false, autoplay: false, center: true });
            }
            /* L: no show() — index 0 is already the centre card (pre-rotated in Liquid) */
          } else {
            var slider = UIkit.slider(sliderEl);
            if (slider) {
              slider.$destroy();
            }
            sliderEl.removeAttribute('uk-slider');
            list.style.transform = 'none';
          }
          return true;
        };

        if (!initSlider()) {
          var uikitRetries = 0;
          var waitForUIkit = setInterval(function () {
            uikitRetries++;
            if (initSlider() || uikitRetries >= 20) clearInterval(waitForUIkit);
          }, 150);
        }
      } catch (e) {
        /* Fail toward visible: leave server markup untouched */
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() { setTimeout(updateMode, 100); });
    } else {
      setTimeout(updateMode, 100);
    }

    var resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(updateMode, 200);
    });

    document.addEventListener('shopify:section:load', function() { setTimeout(updateMode, 200); });
  })();
</script>
{%- endif -%}

{% style %}
  #{{ section_id }} {
    --_gh-card-w: 440px;
    --_gh-card-gap: 24px;
    --_gh-arrow-size: calc(var(--font-size--4xl) * 1.6);
    --_gh-arrow-inset: clamp(8px, 2vw, 24px);
    --_gh-section-max-w: 1440px;
    --_gh-section-pad: 40px;

    padding: clamp(40px, 6vw, 80px) var(--_gh-section-pad);
    max-width: var(--_gh-section-max-w);
    margin-inline: auto;
  }

  #{{ section_id }} .game-highlights__container {
    min-width: 0;
  }

  #{{ section_id }} .game-highlights__list {
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--_gh-card-gap);
    align-items: stretch;
  }

  #{{ section_id }} .game-highlights__item {
    width: var(--_gh-card-w);
    flex-shrink: 0;
    display: flex;
  }

  #{{ section_id }} .game-highlights__card {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md, 16px);
    width: 100%;
  }

  #{{ section_id }} .game-highlights__image-wrap {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-sm, 8px);
    cursor: zoom-in;
  }

  #{{ section_id }} .game-highlights__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #{{ section_id }} .game-highlights__text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  {% comment %} K-fix-1: heading 32px (--font-size--3xl), desc 20px (--font-size--xl) with 34px lh {% endcomment %}
  #{{ section_id }} .game-highlights__name {
    font-size: var(--font-size--3xl);
    font-weight: 600;
    margin: 0;
  }

  #{{ section_id }} .game-highlights__desc {
    font-size: var(--font-size--xl);
    line-height: 1.7;
    margin: 0;
    color: rgba(0, 0, 0, 0.81);
    flex: 1;
  }

  {% comment %} ── Centred mode — static row, no slider, no arrows; hide duplicates ── {% endcomment %}
  #{{ section_id }}.game-highlights--centred .game-highlights__list {
    justify-content: center;
  }

  #{{ section_id }}.game-highlights--centred .game-highlights__item--dup {
    display: none;
  }

  #{{ section_id }}.game-highlights--centred .game-highlights__nav {
    display: none;
  }

  {% comment %}
    K-fix-2: Arrows on the image's vertical axis.
    The track-wrap is position:relative. Arrows use top = half the image height.
    Image height = card-width × 3/4 (from aspect-ratio 4/3).
  {% endcomment %}
  #{{ section_id }} .game-highlights__track-wrap {
    position: relative;
  }

  #{{ section_id }} .game-highlights__nav {
    position: absolute;
    top: calc(var(--_gh-card-w) * 3 / 4 / 2);
    transform: translateY(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--_gh-arrow-size);
    height: var(--_gh-arrow-size);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    padding: 0;
    text-decoration: none;
  }

  #{{ section_id }} .game-highlights__nav:hover {
    background: rgba(0, 0, 0, 0.65);
  }

  #{{ section_id }} .game-highlights__nav svg {
    width: calc(var(--_gh-arrow-size) * 0.45);
    height: calc(var(--_gh-arrow-size) * 0.45);
    color: inherit;
  }

  {% comment %}
    K-fix-3: Three-band arrow positioning.
    Default (750–1599px): overlaid at track edges.
  {% endcomment %}
  #{{ section_id }} .game-highlights__nav--prev {
    left: var(--_gh-arrow-inset);
  }

  #{{ section_id }} .game-highlights__nav--next {
    right: var(--_gh-arrow-inset);
  }

  {% comment %}
    K-fix-3: Outside arrows when viewport is wide enough.
    Breakpoint derived: section-max-w + 2 × (arrow-size + 16px breathing).
    At 4xl=40px, arrow-size = 64px → 1440 + 2×80 = 1600px.
    Use the derived calc in a custom property; the media query uses the
    computed 1600px since CSS cannot use calc() in @media (yet).
    If --_gh-section-max-w or --_gh-arrow-size change, update the MQ.
  {% endcomment %}
  @media (min-width: 1600px) {
    #{{ section_id }} .game-highlights__nav--prev {
      left: calc(-1 * (var(--_gh-arrow-size) + 16px));
    }

    #{{ section_id }} .game-highlights__nav--next {
      right: calc(-1 * (var(--_gh-arrow-size) + 16px));
    }
  }

  {% comment %} ── Mobile: wider cards, no arrows (K-fix-3: < 750px) ── {% endcomment %}
  @media (max-width: 749px) {
    #{{ section_id }} {
      --_gh-card-w: 75vw;
    }

    #{{ section_id }} .game-highlights__nav {
      display: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Game highlights",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
