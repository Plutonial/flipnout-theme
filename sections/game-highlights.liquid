{%- liquid
  assign section_id = 'game-highlights-' | append: section.id
  assign highlights = collection.metafields.custom.highlights.value
-%}

{%- if highlights != blank and highlights.size > 0 -%}
{%- liquid
  assign hl_count = highlights.size
  assign hl_start = hl_count | divided_by: 2
  assign hl_tail = hl_count | minus: hl_start
-%}
<div class="game-section-band game-section-band--cream">
  <section id="{{ section_id }}" class="game-highlights" data-gh-count="{{ hl_count }}">
    <h2 class="game-highlights__heading game-section-heading">Highlights</h2>

    {% comment %}
      Desktop path: plain list, paged by JS. No UIkit, no duplicates.
      Mobile path: UIkit slider with rotation + duplicates for infinite loop.
      The two are toggled via a class on the section: --desktop / --mobile.
    {% endcomment %}

    {% comment %} ── Desktop: natural order, no duplicates ── {% endcomment %}
    <div class="game-highlights__desktop-wrap">
      <div class="game-highlights__track-wrap">
        <div class="game-highlights__container">
          <ul class="game-highlights__list game-highlights__list--desktop">
            {%- for feature in highlights -%}
              {%- render 'fnop-highlight-card', fnop_hl_feature: feature, fnop_hl_is_dup: false -%}
            {%- endfor -%}
          </ul>
        </div>

        <button type="button" class="game-highlights__nav game-highlights__nav--prev" aria-label="Previous highlights">
          <svg width="20" height="20" viewBox="0 0 20 20"><polyline fill="none" stroke="currentColor" stroke-width="1.4" points="13 16 7 10 13 4"></polyline></svg>
        </button>
        <button type="button" class="game-highlights__nav game-highlights__nav--next" aria-label="Next highlights">
          <svg width="20" height="20" viewBox="0 0 20 20"><polyline fill="none" stroke="currentColor" stroke-width="1.4" points="7 4 13 10 7 16"></polyline></svg>
        </button>
      </div>
    </div>

    {% comment %} ── Mobile: UIkit slider with rotation + duplicates ── {% endcomment %}
    <div class="game-highlights__mobile-wrap" uk-lightbox="animation: fade">
      <div class="game-highlights__slider" uk-slider="finite: false; autoplay: false; center: true" data-gh-slider-opts="finite: false; autoplay: false; center: true">
        <div class="uk-position-relative game-highlights__track-wrap">
          <div class="uk-slider-container game-highlights__container">
            <ul class="uk-slider-items game-highlights__list game-highlights__list--mobile">
              {% comment %} Primary set — rotated so centre card is at index 0 {% endcomment %}
              {%- for feature in highlights offset: hl_start -%}
                {%- render 'fnop-highlight-card', fnop_hl_feature: feature, fnop_hl_is_dup: false -%}
              {%- endfor -%}
              {%- if hl_start > 0 -%}
                {%- for feature in highlights limit: hl_start -%}
                  {%- render 'fnop-highlight-card', fnop_hl_feature: feature, fnop_hl_is_dup: false -%}
                {%- endfor -%}
              {%- endif -%}

              {% comment %} Duplicate set for UIkit loop track {% endcomment %}
              {%- for feature in highlights offset: hl_start -%}
                {%- render 'fnop-highlight-card', fnop_hl_feature: feature, fnop_hl_is_dup: true -%}
              {%- endfor -%}
              {%- if hl_start > 0 -%}
                {%- for feature in highlights limit: hl_start -%}
                  {%- render 'fnop-highlight-card', fnop_hl_feature: feature, fnop_hl_is_dup: true -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </div>
        </div>
      </div>
    </div>

    {% comment %} Desktop lightbox: rendered separately since desktop cards are outside uk-lightbox {% endcomment %}
    <div class="game-highlights__lightbox-desktop" uk-lightbox="animation: fade" hidden>
      {%- for feature in highlights -%}
        {%- if feature.image != blank -%}
          <a href="{{ feature.image | image_url: width: 2400 }}" data-caption="{{ feature.name }}" data-type="image"></a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
</div>

<script>
  (function() {
    var sectionId = '{{ section_id }}';
    var MOBILE_BP = 749;

    function isMobile() {
      return window.innerWidth <= MOBILE_BP;
    }

    function initSection() {
      var section = document.getElementById(sectionId);
      if (!section) return;

      var desktopWrap = section.querySelector('.game-highlights__desktop-wrap');
      var mobileWrap = section.querySelector('.game-highlights__mobile-wrap');
      if (!desktopWrap || !mobileWrap) return;

      var mobile = isMobile();

      /* Show/hide the correct path */
      desktopWrap.hidden = mobile;
      mobileWrap.hidden = !mobile;

      if (!mobile) {
        initDesktopPaging(section);
      } else {
        initMobileSlider(section);
      }
    }

    /* ── Desktop: sliding navigation ── */
    function initDesktopPaging(section) {
      var list = section.querySelector('.game-highlights__list--desktop');
      if (!list) return;

      var items = list.querySelectorAll('.game-highlights__item');
      var count = items.length;
      if (count === 0) return;

      var visible = 3;
      var maxPos = Math.max(0, count - visible);

      /* Build position stops: 0, 3, 6, … each clamped to maxPos */
      var positions = [];
      for (var p = 0; p <= maxPos; p += visible) {
        positions.push(Math.min(p, maxPos));
      }
      /* Deduplicate in case the last step lands on maxPos twice */
      if (positions.length > 1 && positions[positions.length - 1] === positions[positions.length - 2]) {
        positions.pop();
      }

      var currentIdx = 0;

      var prevBtn = section.querySelector('.game-highlights__desktop-wrap .game-highlights__nav--prev');
      var nextBtn = section.querySelector('.game-highlights__desktop-wrap .game-highlights__nav--next');

      function slideTo(idx) {
        currentIdx = ((idx % positions.length) + positions.length) % positions.length;
        var pos = positions[currentIdx];
        if (pos === 0) {
          list.style.transform = 'none';
        } else {
          /* offset = -pos * (card + gap), derived from CSS custom properties */
          list.style.transform = 'translateX(calc(-' + pos + ' * (var(--_gh-card-w) + var(--_gh-card-gap))))';
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
          e.preventDefault();
          slideTo(currentIdx - 1);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
          e.preventDefault();
          slideTo(currentIdx + 1);
        });
      }

      /* Set up lightbox click handlers for desktop cards */
      var lightboxContainer = section.querySelector('.game-highlights__lightbox-desktop');
      if (lightboxContainer) {
        var imageLinks = section.querySelectorAll('.game-highlights__list--desktop .game-highlights__image-wrap');
        imageLinks.forEach(function(link, idx) {
          link.addEventListener('click', function(e) {
            e.preventDefault();
            if (window.UIkit && lightboxContainer) {
              lightboxContainer.hidden = false;
              var lb = UIkit.lightbox(lightboxContainer);
              lb.show(idx);
              lightboxContainer.hidden = true;
            }
          });
        });
      }

      /* Position 0 — transform: none (already the default) */
      slideTo(0);

      /* Hide arrows if all fit without sliding */
      if (positions.length <= 1) {
        if (prevBtn) prevBtn.setAttribute('hidden', '');
        if (nextBtn) nextBtn.setAttribute('hidden', '');
      } else {
        if (prevBtn) prevBtn.removeAttribute('hidden');
        if (nextBtn) nextBtn.removeAttribute('hidden');
      }
    }

    /* ── Mobile: UIkit slider ── */
    function initMobileSlider(section) {
      var sliderEl = section.querySelector('.game-highlights__slider');
      if (!sliderEl || !window.UIkit) return;

      if (!sliderEl.hasAttribute('uk-slider')) {
        sliderEl.setAttribute('uk-slider', sliderEl.getAttribute('data-gh-slider-opts'));
      }
      UIkit.slider(sliderEl, { finite: false, autoplay: false, center: true });
    }

    var lastMobile = null;

    function update() {
      var mobile = isMobile();
      if (mobile !== lastMobile) {
        lastMobile = mobile;
        initSection();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() { setTimeout(update, 100); });
    } else {
      setTimeout(update, 100);
    }

    var resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(update, 200);
    });

    document.addEventListener('shopify:section:load', function() {
      lastMobile = null;
      setTimeout(update, 200);
    });
  })();
</script>
{%- endif -%}

{% style %}
  #{{ section_id }} {
    --_gh-card-gap: 24px;
    --_gh-track-w: min(var(--game-band-w), 100vw - 2 * var(--game-band-gutter));
    --_gh-card-w: calc((var(--_gh-track-w) - 2 * var(--_gh-card-gap)) / 3);
    --_gh-arrow-size: calc(var(--font-size--4xl) * 1.6);
    --_gh-arrow-inset: clamp(8px, 2vw, 24px);

    padding: clamp(40px, 6vw, 80px) 0;
    width: min(var(--game-band-w), 100% - 2 * var(--game-band-gutter));
    margin-inline: auto;
  }

  #{{ section_id }} .game-highlights__container {
    min-width: 0;
    overflow: hidden;
  }

  {% comment %} ── Desktop path ── {% endcomment %}
  #{{ section_id }} .game-highlights__list--desktop {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--_gh-card-gap);
    align-items: stretch;
  }

  #{{ section_id }} .game-highlights__item {
    width: var(--_gh-card-w);
    flex-shrink: 0;
    display: flex;
  }


  #{{ section_id }} .game-highlights__card {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md, 16px);
    width: 100%;
  }

  #{{ section_id }} .game-highlights__image-wrap {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-sm, 8px);
    cursor: zoom-in;
  }

  #{{ section_id }} .game-highlights__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #{{ section_id }} .game-highlights__text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  {% comment %} K-fix-1: heading 32px (--font-size--3xl), desc 20px (--font-size--xl) with 34px lh {% endcomment %}
  #{{ section_id }} .game-highlights__name {
    font-size: var(--font-size--3xl);
    font-weight: 600;
    margin: 0;
  }

  #{{ section_id }} .game-highlights__desc {
    font-size: var(--font-size--xl);
    line-height: 1.7;
    margin: 0;
    color: rgba(0, 0, 0, 0.81);
    flex: 1;
  }

  {% comment %}
    K-fix-2: Arrows on the image's vertical axis.
    The track-wrap is position:relative. Arrows use top = half the image height.
    Image height = card-width × 3/4 (from aspect-ratio 4/3).
  {% endcomment %}
  #{{ section_id }} .game-highlights__track-wrap {
    position: relative;
  }

  #{{ section_id }} .game-highlights__nav {
    position: absolute;
    top: calc(var(--_gh-card-w) * 3 / 4 / 2);
    transform: translateY(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--_gh-arrow-size);
    height: var(--_gh-arrow-size);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    padding: 0;
    border: none;
    cursor: pointer;
    text-decoration: none;
  }

  #{{ section_id }} .game-highlights__nav:hover {
    background: rgba(0, 0, 0, 0.65);
  }

  #{{ section_id }} .game-highlights__nav svg {
    width: calc(var(--_gh-arrow-size) * 0.45);
    height: calc(var(--_gh-arrow-size) * 0.45);
    color: inherit;
  }

  {% comment %}
    K-fix-3: Three-band arrow positioning.
    Default (750–1599px): overlaid at track edges.
  {% endcomment %}
  #{{ section_id }} .game-highlights__nav--prev {
    left: var(--_gh-arrow-inset);
  }

  #{{ section_id }} .game-highlights__nav--next {
    right: var(--_gh-arrow-inset);
  }

  {% comment %}
    K-fix-3: Outside arrows when viewport is wide enough.
    Breakpoint derived: game-band-w + 2 × (arrow-size + 16px breathing).
    At 4xl=40px, arrow-size = 64px → 1440 + 2×80 = 1600px.
    If --game-band-w or --_gh-arrow-size change, update the MQ.
  {% endcomment %}
  @media (min-width: 1600px) {
    #{{ section_id }} .game-highlights__nav--prev {
      left: calc(-1 * (var(--_gh-arrow-size) + 16px));
    }

    #{{ section_id }} .game-highlights__nav--next {
      right: calc(-1 * (var(--_gh-arrow-size) + 16px));
    }
  }

  {% comment %} ── Mobile path ── {% endcomment %}

  {% comment %} Hide mobile wrap by default (desktop-first); JS toggles hidden attr {% endcomment %}
  #{{ section_id }} .game-highlights__mobile-wrap {
    display: none;
  }

  @media (max-width: 749px) {
    #{{ section_id }} {
      --_gh-card-gap: 12px;
      --_gh-track-w: 100vw;
      --_gh-card-w: 75vw;
      width: 100%;
      padding-inline: 0;
    }

    {% comment %} On mobile, show mobile wrap and hide desktop wrap {% endcomment %}
    #{{ section_id }} .game-highlights__desktop-wrap {
      display: none;
    }

    #{{ section_id }} .game-highlights__mobile-wrap {
      display: block;
    }

    #{{ section_id }} .game-highlights__list--mobile {
      transform: translateX(calc((var(--_gh-track-w) - var(--_gh-card-w)) / 2));
      list-style: none;
      margin: 0;
      padding: 0;
      gap: var(--_gh-card-gap);
      align-items: stretch;
    }

    #{{ section_id }} .game-highlights__nav {
      display: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Game highlights",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
