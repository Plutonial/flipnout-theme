{%- liquid
  assign section_id = 'collection-hero-' | append: section.id

  assign hero_image = collection.metafields.custom.hero_image
  unless hero_image
    assign hero_image = collection.image
  endunless

  assign hero_position = collection.metafields.custom.hero_position | default: 'center'
  assign game_logo = collection.metafields.custom.logo
  assign manufacturer_ref = collection.metafields.custom.manufacturer.value
  assign bg_color = section.settings.background_color | default: '#1a1a2e'
  assign subtitle = collection.metafields.custom.subtitle

  assign game_name = collection.title
  assign mfr = collection.metafields.custom.manufacturer.value
  if mfr and mfr.title != blank
    assign prefix = mfr.title | append: ' - '
    if game_name contains prefix and game_name != prefix
      assign game_name = game_name | remove_first: prefix
    endif
  endif
-%}

<section id="{{ section_id }}" class="collection-hero">
  {% comment %} Left-aligned overlay hero: image fills, content left-anchored with lateral gradient {% endcomment %}

  <div class="collection-hero__media">
    {%- if hero_image -%}
      {{ hero_image | image_url: width: 2400 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        class: 'collection-hero__img',
        sizes: '100vw',
        widths: '800,1200,1600,2000,2400'
      }}
    {%- endif -%}
  </div>

  <div class="collection-hero__scrim" aria-hidden="true"></div>

  <div class="collection-hero__content">
    <div class="collection-hero__stack">
      {%- if game_logo != blank -%}
        <img
          class="collection-hero__logo"
          src="{{ game_logo | image_url: width: 800 }}"
          alt="{{ game_name }}"
          loading="eager"
          fetchpriority="high"
          width="800"
          height="400"
        />
      {%- endif -%}

      <h1 class="collection-hero__h1">
        {{- game_name }} Pinball Machine
        {%- if manufacturer_ref %}<span class="collection-hero__mfr"> by <a href="{{ manufacturer_ref.url }}" class="collection-hero__mfr-link">{{ manufacturer_ref.title }}</a></span>{%- endif -%}
      </h1>

      {%- if subtitle != blank -%}
        <p class="collection-hero__subtitle">{{ subtitle }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  {% comment %} Phosphate: Apple system font, verify web licensing before production launch {% endcomment %}
  @font-face {
    font-family: "Phosphate";
    src: url("{{ 'PhosphateSolid.ttf' | asset_url }}") format("truetype");
    font-display: swap;
  }

  {% comment %} ── Hero band: aspect-ratio driven, not fixed height ── {% endcomment %}
  {% comment %} NOTE: hero_image is currently hero-bg-placeholder.jpg — replace with real art
     via custom.hero_image in the Shopify admin (data task, not theme code). {% endcomment %}
  #{{ section_id }} {
    --_bg-color: {{ bg_color }};
    --_hero-position: {{ hero_position }};
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    min-height: 420px;
    max-height: min(560px, 62svh);
    background: var(--_bg-color);
    overflow: hidden;
  }

  {% comment %} ── Background image ── {% endcomment %}
  #{{ section_id }} .collection-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #{{ section_id }} .collection-hero__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--_hero-position) center;
  }

  {% comment %} ── Scrim now lives on the content container, not the full-bleed image ── {% endcomment %}
  #{{ section_id }} .collection-hero__scrim {
    display: none;
  }

  {% comment %} ── Content overlay: left-aligned, with scrim pseudo-element ── {% endcomment %}
  #{{ section_id }} .collection-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    height: 100%;
    padding: clamp(32px, 6vw, 56px) var(--page-margin, 16px);
    width: 100%;
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
  }

  {% comment %} ── Scrim: anchored to the full-bleed hero so it fades past the viewport edge ── {% endcomment %}
  #{{ section_id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(ellipse at 25% 50%,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.3) 30%,
      rgba(0, 0, 0, 0) 65%
    );
    pointer-events: none;
  }

  #{{ section_id }} .collection-hero__stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    text-align: left;
    max-width: 700px;
  }

  {% comment %} ── Game logo: medium, height-constrained ── {% endcomment %}
  #{{ section_id }} .collection-hero__logo {
    height: auto;
    width: auto;
    max-height: clamp(80px, 14vw, 140px);
    max-width: min(85vw, 300px);
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgb(0 0 0 / 40%));
    margin-bottom: 12px;
  }

  {% comment %} ── H1: real text for SEO ── {% endcomment %}
  #{{ section_id }} .collection-hero__h1 {
    color: white;
    font-family: "Phosphate", var(--font-h1--family), sans-serif;
    font-size: var(--font-size--4xl);
    line-height: 1.1;
    font-weight: 600;
    margin: 0;
    text-shadow: 0 2px 8px rgb(0 0 0 / 50%);
  }

  #{{ section_id }} .collection-hero__mfr {
    font-size: inherit;
  }

  @media (max-width: 989px) {
    #{{ section_id }} .collection-hero__mfr {
      display: block;
      font-size: var(--font-size--2xl);
    }
  }

  #{{ section_id }} .collection-hero__mfr-link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  #{{ section_id }} .collection-hero__mfr-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  {% comment %} ── Optional subtitle ── {% endcomment %}
  #{{ section_id }} .collection-hero__subtitle {
    color: rgba(255, 255, 255, 0.92);
    font-family: var(--font-paragraph--family), sans-serif;
    font-size: var(--font-size--2xl);
    line-height: 1.5;
    font-weight: 400;
    margin: 0;
    text-shadow: 0 1px 4px rgb(0 0 0 / 40%);
  }

  {% comment %} ── Tablet: 16:9 band ── {% endcomment %}
  @media (min-width: 701px) {
    #{{ section_id }} {
      aspect-ratio: 16 / 9;
      min-height: 340px;
    }


    #{{ section_id }} .collection-hero__logo {
      max-height: clamp(100px, 10vw, 150px);
      max-width: 320px;
    }
  }

  {% comment %} ── Desktop: 4.2:1 cinematic band ── {% endcomment %}
  @media (min-width: 1025px) {
    #{{ section_id }} {
      aspect-ratio: 4.2 / 1;
    }

    #{{ section_id }} .collection-hero__logo {
      max-height: clamp(120px, 12vw, 180px);
      max-width: 320px;
    }
  }

  {% comment %} ── Visually hidden utility ── {% endcomment %}
  .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }
{% endstyle %}

{% schema %}
{
  "name": "Collection hero",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Fallback background color",
      "default": "#1a1a2e"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
