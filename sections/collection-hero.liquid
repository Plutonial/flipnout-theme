{%- liquid
  assign section_id = 'collection-hero-' | append: section.id

  assign hero_image = collection.metafields.custom.hero_image
  unless hero_image
    assign hero_image = collection.image
  endunless

  assign hero_position = collection.metafields.custom.hero_position | default: 'center'
  assign game_logo = collection.metafields.custom.logo
  assign manufacturer_ref = collection.metafields.custom.manufacturer.value
  assign bg_color = section.settings.background_color | default: '#1a1a2e'
  assign cta_text = section.settings.cta_text | default: 'Shop Editions'
  assign cta_target = section.settings.cta_target | default: '#editions'
  assign subtitle = collection.metafields.custom.subtitle
-%}

<section id="{{ section_id }}" class="collection-hero">
  {% comment %} Left-aligned overlay hero: image fills, content left-anchored with lateral gradient {% endcomment %}

  <div class="collection-hero__media">
    {%- if hero_image -%}
      {{ hero_image | image_url: width: 2400 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        class: 'collection-hero__img',
        sizes: '100vw',
        widths: '800,1200,1600,2000,2400'
      }}
    {%- endif -%}
  </div>

  <div class="collection-hero__scrim" aria-hidden="true"></div>

  <div class="collection-hero__content">
    <div class="collection-hero__stack">
      {%- if game_logo != blank -%}
        <img
          class="collection-hero__logo"
          src="{{ game_logo | image_url: width: 800 }}"
          alt="{{ collection.title }}"
          loading="eager"
          fetchpriority="high"
          width="800"
          height="400"
        />
      {%- endif -%}

      <h1 class="collection-hero__h1">
        {{- collection.title }} Pinball Machine
        {%- if manufacturer_ref %} by <a href="{{ manufacturer_ref.url }}" class="collection-hero__mfr-link">{{ manufacturer_ref.title }}</a>{%- endif -%}
      </h1>

      {%- if subtitle != blank -%}
        <p class="collection-hero__subtitle">{{ subtitle }}</p>
      {%- endif -%}

      {%- if cta_text != blank -%}
        <a href="{{ cta_target }}" class="collection-hero__cta">{{ cta_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var cta = document.querySelector('#{{ section_id }} .collection-hero__cta');
    if (cta) {
      cta.addEventListener('click', function (e) {
        var href = cta.getAttribute('href');
        if (href && href.charAt(0) === '#') {
          e.preventDefault();
          var target = document.getElementById(href.substring(1));
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    }
  });
</script>

{% style %}
  {% comment %} Phosphate: Apple system font, verify web licensing before production launch {% endcomment %}
  @font-face {
    font-family: "Phosphate";
    src: url("{{ 'PhosphateSolid.ttf' | asset_url }}") format("truetype");
    font-display: swap;
  }

  {% comment %} ── Hero band: aspect-ratio driven, not fixed height ── {% endcomment %}
  {% comment %} NOTE: hero_image is currently hero-bg-placeholder.jpg — replace with real art
     via custom.hero_image in the Shopify admin (data task, not theme code). {% endcomment %}
  #{{ section_id }} {
    --_bg-color: {{ bg_color }};
    --_hero-position: {{ hero_position }};
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    min-height: 420px;
    max-height: min(560px, 62svh);
    background: var(--_bg-color);
    overflow: hidden;
  }

  {% comment %} ── Background image ── {% endcomment %}
  #{{ section_id }} .collection-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #{{ section_id }} .collection-hero__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--_hero-position) center;
  }

  {% comment %} ── Scrim now lives on the content container, not the full-bleed image ── {% endcomment %}
  #{{ section_id }} .collection-hero__scrim {
    display: none;
  }

  {% comment %} ── Content overlay: left-aligned, with scrim pseudo-element ── {% endcomment %}
  #{{ section_id }} .collection-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: calc(var(--header-height, 60px) + 8px) var(--page-margin, 16px) clamp(32px, 6vw, 56px);
    width: 100%;
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
  }

  {% comment %} ── Scrim: radial halo centered on content, tightened for shorter band ── {% endcomment %}
  #{{ section_id }} .collection-hero__content::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 140%;
    height: 160%;
    z-index: -1;
    background: radial-gradient(ellipse at center,
      rgba(0, 0, 0, 0.6) 0%,
      rgba(0, 0, 0, 0.4) 40%,
      rgba(0, 0, 0, 0) 75%
    );
    pointer-events: none;
  }

  #{{ section_id }} .collection-hero__stack {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    text-align: left;
    max-width: 700px;
  }

  {% comment %} ── Game logo: medium, height-constrained ── {% endcomment %}
  #{{ section_id }} .collection-hero__logo {
    height: clamp(80px, 14vw, 140px);
    width: auto;
    max-width: min(85vw, 500px);
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgb(0 0 0 / 40%));
    text-shadow: 0 2px 6px rgb(0 0 0 / 50%);
  }

  {% comment %} ── H1: real text for SEO ── {% endcomment %}
  #{{ section_id }} .collection-hero__h1 {
    color: white;
    font-family: "Phosphate", var(--font-h1--family), sans-serif;
    font-size: var(--font-size--4xl);
    line-height: 1.1;
    font-weight: 600;
    margin: 0;
    text-shadow: 0 2px 8px rgb(0 0 0 / 50%);
    flex-basis: 100%;
  }

  #{{ section_id }} .collection-hero__mfr-link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  #{{ section_id }} .collection-hero__mfr-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  {% comment %} ── Optional subtitle ── {% endcomment %}
  #{{ section_id }} .collection-hero__subtitle {
    color: rgba(255, 255, 255, 0.92);
    font-family: var(--font-paragraph--family), sans-serif;
    font-size: var(--font-size--2xl);
    line-height: 1.5;
    font-weight: 400;
    margin: 0;
    text-shadow: 0 1px 4px rgb(0 0 0 / 40%);
    flex-basis: 100%;
  }

  #{{ section_id }} .collection-hero__cta {
    display: inline-block;
    margin-top: 8px;
    padding: 14px 32px;
    background: white;
    color: #111;
    font-size: var(--font-size--md);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: var(--radius-sm, 8px);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  #{{ section_id }} .collection-hero__cta:hover {
    transform: scale(1.03);
    box-shadow: 0 4px 20px rgb(255 255 255 / 0.25);
  }

  {% comment %} ── Tablet: 16:9 band ── {% endcomment %}
  @media (min-width: 701px) {
    #{{ section_id }} {
      aspect-ratio: 16 / 9;
      min-height: 340px;
    }

    #{{ section_id }} .collection-hero__content {
      padding-top: calc(var(--header-height, 80px) + 12px);
    }

    #{{ section_id }} .collection-hero__logo {
      height: clamp(100px, 10vw, 150px);
      max-width: 560px;
    }
  }

  {% comment %} ── Desktop: 4.2:1 cinematic band ── {% endcomment %}
  @media (min-width: 1025px) {
    #{{ section_id }} {
      aspect-ratio: 4.2 / 1;
    }

    #{{ section_id }} .collection-hero__logo {
      height: clamp(120px, 12vw, 180px);
    }
  }

  {% comment %} ── Visually hidden utility ── {% endcomment %}
  .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }
{% endstyle %}

{% schema %}
{
  "name": "Collection hero",
  "settings": [
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "Shop Editions"
    },
    {
      "type": "text",
      "id": "cta_target",
      "label": "CTA scroll target (anchor)",
      "default": "#editions"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fallback background color",
      "default": "#1a1a2e"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
