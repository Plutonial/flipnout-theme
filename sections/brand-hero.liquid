{%- liquid
  assign section_id = 'brand-hero-' | append: section.id

  assign hero_image = collection.metafields.custom.hero_image
  unless hero_image
    assign hero_image = collection.image
  endunless

  assign brand_logo = collection.metafields.custom.logo
  assign subtitle = collection.metafields.custom.subtitle
  assign bg_color = section.settings.background_color | default: '#1a1a2e'
-%}

<section id="{{ section_id }}" class="collection-hero">
  <div class="collection-hero__media">
    {%- if hero_image -%}
      {{ hero_image | image_url: width: 2400 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        class: 'collection-hero__img',
        sizes: '100vw',
        widths: '800,1200,1600,2000,2400'
      }}
    {%- endif -%}
  </div>

  <div class="collection-hero__content">
    <div class="collection-hero__stack">
      {%- if brand_logo != blank -%}
        <img
          class="collection-hero__logo"
          src="{{ brand_logo | image_url: width: 800 }}"
          alt="{{ collection.title }}"
          loading="eager"
          fetchpriority="high"
          width="800"
          height="400"
        />
      {%- endif -%}

      <h1 class="collection-hero__h1">{{ collection.title }}</h1>

      {%- if subtitle != blank -%}
        <p class="collection-hero__subtitle">{{ subtitle }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  {% comment %} ── Shared hero band styles ── {% endcomment %}
  {%- render 'collection-hero-styles', hero_id: section_id, hero_bg_color: bg_color, hero_bg_position: 'center' -%}
{% endstyle %}

{% schema %}
{
  "name": "Brand hero",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Fallback background color",
      "default": "#1a1a2e"
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
