{%- liquid
  assign section_id = 'brand-hero-' | append: section.id
  assign bg_image = collection.image
  assign brand_logo = collection.metafields.collection.brand_logo
  assign text_align = section.settings.text_align | default: 'left'
  assign logo_position = section.settings.logo_position | default: 'top-left'
  assign overlay_darkness = section.settings.overlay_darkness | default: 50
  assign btn_label = 'Shop ' | append: collection.title
-%}

<div id="{{ section_id }}" class="brand-hero" style="position: relative;">
  {%- render 'hero-content',
    hero_id: section_id,
    hero_title: collection.title,
    hero_content: collection.description,
    hero_btn_text: btn_label,
    hero_btn_link: '#brand-machines',
    hero_text_align: text_align,
    hero_overlay_darkness: overlay_darkness,
    hero_bg_image: bg_image,
    hero_bg_loading: 'eager',
    hero_logo: brand_logo,
    hero_logo_position: logo_position
  -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var cta = document.querySelector('#{{ section_id }} .hero-slide__cta');
    if (cta && cta.getAttribute('href') === '#brand-machines') {
      cta.addEventListener('click', function (e) {
        e.preventDefault();
        var target = document.getElementById('brand-machines');
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    }
  });
</script>

{% style %}
  #{{ section_id }} .hero-slide__bg {
    min-height: 100svh;
  }

  @media (min-width: 750px) {
    #{{ section_id }} .hero-slide__bg {
      min-height: 100svh;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Brand hero",
  "settings": [
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "centered", "label": "Centered" }
      ],
      "default": "top-left"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "overlay_darkness",
      "label": "Overlay darkness",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
