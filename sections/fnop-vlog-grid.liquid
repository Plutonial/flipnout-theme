{%- comment -%}
  Vlog grid — uniform 2→3 column branded card grid for show blogs.
  Assigned via the blog.vlog template (admin: Blog posts → Manage blogs → Theme template).
  No conditional on blog.handle — the template assignment is admin data.
  P81: optional featured hero for the newest post above the grid.
{%- endcomment -%}

{%- liquid
  assign show_hero = section.settings.featured_hero
  assign hero_article = blog.articles.first
-%}

{% paginate blog.articles by 24 %}

<div class="brand-section__container">
  <h1 class="fnop-vg__page-title">{{ blog.title }}</h1>

  {%- comment -%} ── P81 Featured Hero ── {%- endcomment -%}
  {%- if show_hero and hero_article -%}
    {%- liquid
      assign hero_related = hero_article.metafields.episode.related_collections.value
      assign hero_featured = hero_article.metafields.episode.featured_products.value
      assign hero_has_rail = false
      if hero_related != blank and hero_related.size > 0
        assign hero_has_rail = true
      endif
    -%}

    <div class="fnop-vg__hero{% unless hero_has_rail %} fnop-vg__hero--no-rail{% endunless %}">
      {%- comment -%} ── P83: 3-track band aligned to the grid below ── {%- endcomment -%}
      <div class="fnop-vg__hero-band{% unless hero_has_rail %} fnop-vg__hero-band--no-rail{% endunless %}">
        {%- comment -%} ── Column 1-2: poster + meta stacked ── {%- endcomment -%}
        <div class="fnop-vg__hero-col1">
          {%- if hero_article.image -%}
            <a class="fnop-vg__hero-poster" href="{{ hero_article.url }}" aria-label="{{ hero_article.title }}">
              {{ hero_article.image | image_url: width: 1920 | image_tag:
                loading: 'eager',
                class: 'fnop-vg__hero-poster-img',
                sizes: '(min-width: 1400px) 928px, (min-width: 750px) calc(100vw - 80px), 100vw',
                widths: '400,600,800,1080,1440,1920',
                alt: hero_article.title
              }}
              <svg class="fnop-vg__hero-play" viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
                <path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.63-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="red"/>
                <path d="M45 24 27 14v20" fill="#fff"/>
              </svg>
            </a>
          {%- endif -%}

          <div class="fnop-vg__hero-meta">
            <h2 class="fnop-vg__hero-title">{{ hero_article.title }}</h2>
            <time class="fnop-vg__hero-date" datetime="{{ hero_article.published_at | date: '%Y-%m-%d' }}">
              {{ hero_article.published_at | date: '%b %-d, %Y' }}
            </time>
            {%- if hero_article.excerpt != blank -%}
              <p class="fnop-vg__hero-excerpt">{{ hero_article.excerpt | strip_html | truncate: 300 }}</p>
            {%- endif -%}
            <a class="fnop-vg__hero-more" href="{{ hero_article.url }}">More</a>
          </div>
        </div>

        {%- comment -%} ── Column 3: rail ── {%- endcomment -%}
        {%- if hero_has_rail -%}
          <aside class="fnop-ap__rail">
            {%- render 'fnop-ap-rail',
              related_collections: hero_related,
              featured_products: hero_featured,
              rail_heading: section.settings.rail_heading,
              rail_card_sizes: '(min-width: 1400px) 416px, (min-width: 750px) 320px, calc(100vw - 32px)',
              hero_variant: true,
              games_heading: section.settings.games_heading
            -%}
          </aside>
        {%- endif -%}
      </div>

      {%- comment -%} ── P83 TASK 3: rule between hero and grid ── {%- endcomment -%}
      <hr class="fnop-vg__hero-hr">
    </div>
  {%- endif -%}

  {%- if blog.articles.size > 0 -%}
    <ul class="fnop-vg__grid" role="list">
      {%- for article in blog.articles -%}
        {%- if show_hero and forloop.first -%}
          {%- continue -%}
        {%- endif -%}
        <li>
          <a class="fnop-vg__card" href="{{ article.url }}">
            {%- if article.image -%}
              {{ article.image | image_url: width: 1600 | image_tag:
                loading: 'lazy',
                class: 'fnop-vg__media',
                sizes: '(min-width: 1520px) 435px, (min-width: 1400px) calc((100vw - 216px) / 3), (min-width: 750px) calc(50vw - 74px), calc(100vw - 50px)',
                widths: '220,300,440,600,880,1280',
                alt: article.image.alt | default: article.title
              }}
            {%- endif -%}

            {%- assign ep_num = article.metafields.episode.episode_number.value -%}
            <span class="fnop-vg__eyebrow">{%- if ep_num != blank -%}Ep {{ ep_num }} - {%- endif -%}{{ article.published_at | date: '%b %-d, %Y' }}</span>

            <h2 class="fnop-vg__title">{{ article.title }}</h2>
            <p class="fnop-vg__excerpt">{%- if article.excerpt != blank -%}{{ article.excerpt | strip_html | truncate: 200 }}{%- endif -%}</p>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if paginate.pages > 1 -%}
    <div class="fnop-vg__pagination">
      {{ paginate | default_pagination }}
    </div>
  {%- endif -%}
</div>

{% endpaginate %}

{% schema %}
{
  "name": "Vlog Grid",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "featured_hero",
      "label": "Show the newest post as a featured hero",
      "default": true
    },
    {
      "type": "text",
      "id": "rail_heading",
      "label": "Rail heading",
      "default": "The Lineup",
      "info": "Heading above the rail in the featured hero."
    },
    {
      "type": "text",
      "id": "games_heading",
      "label": "Hero games heading",
      "default": "In This Episode",
      "info": "Heading above the games in the hero rail. Blank hides it."
    }
  ],
  "presets": [
    {
      "name": "Vlog Grid"
    }
  ]
}
{% endschema %}
