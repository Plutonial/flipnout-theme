{%- liquid
  assign section_id = 'game-features-' | append: section.id
  assign base_features = collection.metafields.custom.base_features.value
-%}

{%- if base_features != blank and base_features.size > 0 -%}
<div class="game-section-band game-section-band--white">
  <section id="{{ section_id }}" class="game-features">
    <h2 class="game-features__heading game-section-heading">{{ collection.title }} Pinball Game Features</h2>

    <ul class="game-features__list">
      {%- for feature in base_features -%}
        {%- if feature != blank -%}
          <li class="game-features__item">{{ feature }}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </section>
</div>
{%- endif -%}

{% style %}
  #{{ section_id }} {
    padding: clamp(40px, 6vw, 80px) var(--page-margin, 16px);
    max-width: var(--page-content-width, 1200px);
    margin-inline: auto;
  }


  #{{ section_id }} .game-features__list {
    columns: 3;
    column-gap: var(--gap-2xl, 32px);
    list-style: none;
    padding-left: 0;
    margin: 0;
  }

  #{{ section_id }} .game-features__item {
    --bullet-size: 0.65em;
    --item-padding-top: 6px;
    font-family: var(--font-h1--family), sans-serif;
    font-size: var(--font-size--xl);
    line-height: 1.7;
    break-inside: avoid;
    padding-block: var(--item-padding-top);
    padding-left: 35px;
    position: relative;
    list-style: none;
  }

  #{{ section_id }} .game-features__item::before {
    content: "";
    display: inline-block;
    width: var(--bullet-size);
    height: var(--bullet-size);
    background-image: url('{{ 'fnop-bullet.png' | asset_url }}');
    background-size: contain;
    background-repeat: no-repeat;
    position: absolute;
    left: 0;
    top: calc(var(--item-padding-top) + (1.7em - var(--bullet-size)) / 2 + 0.11em); /* +0.11em optical correction: align to x-height centre, not line-box centre */
  }

  @media (max-width: 989px) {
    #{{ section_id }} .game-features__list {
      columns: 2;
    }
  }

  @media (max-width: 749px) {
    #{{ section_id }} .game-features__list {
      columns: 1;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Game features",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
